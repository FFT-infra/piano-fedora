diff --git a/tools/build_piano_full_kernel.py b/tools/build_piano_full_kernel.py
index 1e7486c..f7782b3 100644
--- a/tools/build_piano_full_kernel.py
+++ b/tools/build_piano_full_kernel.py
@@ -85,6 +85,24 @@ F2FS_OVERRIDES={'CONFIG_F2FS_FS':'y','CONFIG_F2FS_FS_XATTR':'y',
                 'CONFIG_F2FS_FS_POSIX_ACL':'y','CONFIG_F2FS_FS_SECURITY':'y'}
 FEDORA_OVERRIDES={'CONFIG_SECURITY_NETWORK':'y','CONFIG_SECURITY_SELINUX':'y',
                   'CONFIG_LSM':'"selinux"'}
+# Fedora firewalld and libvirt need connection tracking and NAT switched on. The
+# shared platform fragment already owns the nftables options themselves, so only
+# the switches it leaves at their defaults are named here: redefining one of its
+# options would make the two fragments disagree and the override gate rejects it.
+FEDORA_OVERRIDES.update({
+ 'CONFIG_NETFILTER':'y','CONFIG_NETFILTER_ADVANCED':'y',
+ 'CONFIG_NF_CONNTRACK':'y','CONFIG_NF_NAT':'y',
+})
+# firewalld registers one nft ct helper per protocol it ships and the nftables
+# backend commits them in one atomic batch: a helper the kernel cannot load
+# fails the whole batch and firewalld falls back to its stock configuration.
+# Fedora ships every one of them as a module, so keep them loadable on demand.
+# The matching nf_nat_* helpers follow from these through their Kconfig defaults.
+FEDORA_OVERRIDES.update({key:'m' for key in (
+    'CONFIG_NF_CONNTRACK_AMANDA','CONFIG_NF_CONNTRACK_FTP','CONFIG_NF_CONNTRACK_H323',
+    'CONFIG_NF_CONNTRACK_IRC','CONFIG_NF_CONNTRACK_NETBIOS_NS','CONFIG_NF_CONNTRACK_PPTP',
+    'CONFIG_NF_CONNTRACK_SANE','CONFIG_NF_CONNTRACK_SIP','CONFIG_NF_CONNTRACK_SNMP',
+    'CONFIG_NF_CONNTRACK_TFTP')})
 ALLOWED_OVERRIDES={**BLUETOOTH_OVERRIDES,**PEN_DOCK_OVERRIDES,**FLASH_OVERRIDES,**EARLY_CPUCP_OVERRIDES,
                    **USERSPACE_SECURITY_OVERRIDES,**SLEEP_OVERRIDES,**PM_DEBUG_OVERRIDES,**PLATFORM_OVERRIDES,**F2FS_OVERRIDES,**FEDORA_OVERRIDES}
 
