From b9a8a333148bcf264fa18005de4e18ae334b4346 Mon Sep 17 00:00:00 2001
From: piano-fedora <dev@piano.invalid>
Date: Sat, 10 Oct 2026 19:39:43 +0800
Subject: [PATCH] ufs: force device power resume and retry SCSI
 inquiry/capacities

When booting from Android HyperOS, the UFS device link exits Hibern8
into active UniPro, but the device power mode remains in Sleep (0x22)
or DeepSleep (0x33).

Previously, SunUEFI only attempted PianoUfsBuildResumeActive if reading
the device descriptor failed with EFI_DEVICE_ERROR. On 1TB UFS devices
running newer HyperOS releases, descriptor reads succeed even in sleep
mode, bypassing resume entirely. Subsequent SCSI REPORT_LUNS queries then
fail with CHECK CONDITION: NOT READY (key=02 asc=04 ascq=00).

Upstream's EnsureDeviceActive() now resumes the device from Sleep or
DeepSleep before any descriptor access, so the unconditional probe is no
longer this patch's job. A resume is still needed after the first
REPORT_LUNS attempt fails, so keep it on the retry path.

1. On a failed REPORT_LUNS, resume the device power to Active (0x11),
   then retry: five attempts, 50ms stall between them.
2. Add bounded retries with 20ms stall to READ_CAPACITY_16.
3. Keep the mStartupStage markers so a stuck stage shows in the log.

---
diff --git a/uefi/core/storage/PianoUfsReadOnlyDma.c b/uefi/core/storage/PianoUfsReadOnlyDma.c
index 7b293f5..52a4d39 100644
--- a/uefi/core/storage/PianoUfsReadOnlyDma.c
+++ b/uefi/core/storage/PianoUfsReadOnlyDma.c
@@ -505,17 +505,28 @@ STATIC EFI_STATUS ReadLunCapacity(VOID) {
     &mData);if(EFI_ERROR(Status))return Status;
   Status=PianoDmaMap(&mData);if(EFI_ERROR(Status))return Status;
   mStartupStage="UFS LUNS";
-  Status=ReadScsi("REPORT_LUNS",10,0,PianoUfsReportLuns,0,4096);
+  for(UINT8 Attempt=0;Attempt<5;++Attempt) {
+    Status=ReadScsi("REPORT_LUNS",10+Attempt,0,PianoUfsReportLuns,0,4096);
+    DEBUG((DEBUG_WARN,"SUNUEFI_UFS_REPORT_LUNS_ATTEMPT attempt=%u status=%r transferred=%u\n",Attempt+1,Status,mTransferred));
+    if(!EFI_ERROR(Status))break;
+    EFI_STATUS Resume=PianoUfsBuildResumeActive(mTrl.Cpu,mTrl.Bytes,mUcd.Cpu,mUcd.Bytes,mUcd.DeviceAddress,16+Attempt);
+    if(!EFI_ERROR(Resume))Submit("RESUME_LUN_ACTIVE",16+Attempt,FALSE);
+    gBS->Stall(50000);
+  }
   DEBUG((DEBUG_WARN,"SUNUEFI_UFS_REPORT_LUNS_RESULT %r transferred=%u\n",Status,mTransferred));if(EFI_ERROR(Status))return Status;
   UINT8 Luns[8];UINTN Count;
   Status=PianoUfsParseLuns(mData.Cpu,mTransferred,Luns,&Count);if(EFI_ERROR(Status))return Status;
   mLunCount=Count;
   DEBUG((DEBUG_WARN,"SUNUEFI_UFS_LUN_COUNT count=%u\n",(UINT32)Count));
   for(UINTN I=0;I<Count;++I) {
-    UINT64 Last;UINT32 Block;
     mStartupStage=mCapacityStages[Luns[I]];
-    Status=ReadScsi("READ_CAPACITY_16",20+I,Luns[I],PianoUfsReadCapacity16,0,32);
-    if(!EFI_ERROR(Status))Status=PianoUfsParseCapacity(mData.Cpu,mTransferred,&Last,&Block);
+    UINT64 Last=0;UINT32 Block=0;
+    for(UINT8 Attempt=0;Attempt<5;++Attempt) {
+      Status=ReadScsi("READ_CAPACITY_16",20+(UINT8)I*5+Attempt,Luns[I],PianoUfsReadCapacity16,0,32);
+      if(!EFI_ERROR(Status))Status=PianoUfsParseCapacity(mData.Cpu,mTransferred,&Last,&Block);
+      if(!EFI_ERROR(Status))break;
+      gBS->Stall(20000);
+    }
     DEBUG((DEBUG_WARN,"SUNUEFI_UFS_CAPACITY lun=%u status=%r last_lba=%lx block_bytes=%u\n",Luns[I],Status,
       EFI_ERROR(Status)?0:Last,EFI_ERROR(Status)?0:Block));
     if(EFI_ERROR(Status))return Status;
