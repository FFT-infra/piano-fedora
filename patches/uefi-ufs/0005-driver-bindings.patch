两处编译错误都已修：上一版猜的 MEDIA_FV_FILEPATH_DP 在 MdePkg 的 DevicePath.h 里不存在
（只有 MEDIA_FILEPATH_DP 0x04），本版不依赖任何 subtype 常量、直接 dump 原始字节；
HandleProtocol 要非 const 的 EFI_GUID *，本地常量需显式 cast。
---
 uefi/core/PianoProductCore.c | 39 ++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/uefi/core/PianoProductCore.c b/uefi/core/PianoProductCore.c
index 0e97563..d98e712 100644
--- a/uefi/core/PianoProductCore.c
+++ b/uefi/core/PianoProductCore.c
@@ -26,6 +26,9 @@
 #include <Library/TimerLib.h>
 #include <Library/PrintLib.h>
 #include <Library/FdtLib.h>
+#include <Protocol/DevicePath.h>
+#include <Protocol/DriverBinding.h>
+#include <Protocol/LoadedImage.h>
 VOID PianoProbeFoundation(VOID);
 VOID PianoNativeSetObserver(VOID (*Observer)(CONST CHAR8 *,BOOLEAN));
 VOID PianoProbeUfs(CONST VOID *Fdt);
@@ -49,7 +52,30 @@ STATIC CONST EFI_GUID mDiagDiskIoGuid={0xCE345171,0xBA0B,0x11D2,{0x8E,0x4F,0x00,
 STATIC CONST EFI_GUID mDiagSfsGuid={0x964E5B22,0x6459,0x11D2,{0x8E,0x39,0x00,0xA0,0xC9,0x69,0x72,0x3B}};
 STATIC CONST EFI_GUID mDiagDriverBindingGuid={0x18A031AB,0xB443,0x4D1A,{0xA5,0xC0,0x0C,0x09,0x26,0x1E,0x9F,0x71}};
 STATIC CONST EFI_GUID mDiagCollation2Guid={0xA4C751FC,0x23AE,0x4C3E,{0x92,0xE9,0x49,0x64,0xCF,0x63,0xF3,0x49}};
+STATIC CONST EFI_GUID mDiagLoadedImageGuid={0x5B1B31A1,0x9562,0x11D2,{0x8E,0x3F,0x00,0xA0,0xC9,0x69,0x72,0x3B}};
 STATIC UINT32 mDiagBlockIo,mDiagDiskIo,mDiagSfs,mDiagDriverBindings,mDiagCollation2;
+STATIC UINT32 mDiagDriverDumped;
+// Dump the last real node of a driver image device path. The firmware-volume file
+// node carries the module FFS GUID, so the raw bytes identify the driver without
+// depending on a device-path subtype constant. No behaviour depends on this.
+STATIC VOID DiagDumpImagePath(CONST EFI_DEVICE_PATH_PROTOCOL *P){
+ STATIC CONST CHAR8 D[]="0123456789abcdef";
+ if(mDiagDriverDumped>=24)return;
+ if(P==NULL){DEBUG((DEBUG_WARN,"SUNUEFI_DRIVER %u path=none\n",mDiagDriverDumped++));return;}
+ CONST UINT8 *B=(CONST UINT8 *)P;CONST UINT8 *Last=NULL;UINTN LastLen=0;UINT32 LastT=0,LastS=0;
+ for(UINTN N=0;N<16;++N){
+  CONST EFI_DEVICE_PATH_PROTOCOL *Q=(CONST EFI_DEVICE_PATH_PROTOCOL *)B;
+  UINTN L=(UINTN)(Q->Length[0]|((UINT16)Q->Length[1]<<8));
+  if(Q->Type==END_DEVICE_PATH_TYPE || L<4)break;
+  Last=B;LastLen=L;LastT=(UINT32)Q->Type;LastS=(UINT32)Q->SubType;B+=L;
+ }
+ if(Last==NULL){DEBUG((DEBUG_WARN,"SUNUEFI_DRIVER %u path=empty\n",mDiagDriverDumped++));return;}
+ UINTN M=LastLen-4;if(M>24)M=24;
+ CHAR8 Hex[49];
+ for(UINTN I=0;I<M;++I){Hex[I*2]=D[(Last[4+I]>>4)&15];Hex[I*2+1]=D[Last[4+I]&15];}
+ Hex[M*2]=0;
+ DEBUG((DEBUG_WARN,"SUNUEFI_DRIVER %u type=%u sub=%u len=%u data=%a\n",mDiagDriverDumped++,LastT,LastS,(UINT32)LastLen,Hex));
+}
 STATIC UINT32 DiagHandles(CONST EFI_GUID *G){
  EFI_HANDLE *H=NULL;UINTN C=0;EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)G,NULL,&C,&H);
  UINT32 R=S==EFI_SUCCESS?(UINT32)C:(S==EFI_NOT_FOUND?0U:0xFFFFFFFFU);
@@ -61,6 +87,19 @@ STATIC VOID PianoDiagCountProviders(VOID){
  mDiagSfs=DiagHandles(&mDiagSfsGuid);
  mDiagDriverBindings=DiagHandles(&mDiagDriverBindingGuid);
  mDiagCollation2=DiagHandles(&mDiagCollation2Guid);
+ mDiagDriverDumped=0;
+ {EFI_HANDLE *H=NULL;UINTN C=0;
+  EFI_STATUS S2=gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagDriverBindingGuid,NULL,&C,&H);
+  if(S2==EFI_SUCCESS && H!=NULL){
+   if(C>64)C=64;
+   for(UINTN I=0;I<C;++I){
+    EFI_DRIVER_BINDING_PROTOCOL *DB=NULL;EFI_LOADED_IMAGE_PROTOCOL *LI=NULL;
+    if(gBS->HandleProtocol(H[I],(EFI_GUID *)&mDiagDriverBindingGuid,(VOID **)&DB)!=EFI_SUCCESS||DB==NULL)continue;
+    if(gBS->HandleProtocol(DB->ImageHandle,(EFI_GUID *)&mDiagLoadedImageGuid,(VOID **)&LI)!=EFI_SUCCESS||LI==NULL)continue;
+    DiagDumpImagePath(LI->FilePath);
+   }
+   gBS->FreePool(H);
+  }}
 }
 STATIC PIANO_PRODUCT_DISPLAY_STARTUP_REPORT mDisplayStartup;
 STATIC PIANO_SMMU_RETIRED_USB_PROOF mStartupUsbProof;
