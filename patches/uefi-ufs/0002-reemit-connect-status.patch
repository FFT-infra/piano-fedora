「整机没有任何 SimpleFileSystem 句柄」这条已经用三种方式确认（我们的探针、UEFI Shell
的映射表、Setup 的文件浏览器）。要知道断在驱动没被 dispatch 还是 Start 里分配失败，
只有 PublishBlocks 里那 6 个 ConnectController 返回码能回答——而它们永远落在 RAM 控制台
快照窗口之外：快照只回最新 256 KiB，而每次抓取前 ProductDebugReplay 会先写约 200 KB。

本补丁把那 6 个状态存下来，在同一个 replay 里重发一遍（和现有的时钟/显示观测重发同形），
于是它们落进窗口。不新增任何 Boot Services 调用，不改变任何判断。
---
 uefi/core/PianoProductCore.c    |  2 ++
 uefi/core/PianoUfsReadOnlyDma.c | 14 ++++++++++++++
 2 files changed, 16 insertions(+)

diff --git a/uefi/core/PianoProductCore.c b/uefi/core/PianoProductCore.c
index f98ca02..2473558 100644
--- a/uefi/core/PianoProductCore.c
+++ b/uefi/core/PianoProductCore.c
@@ -29,6 +29,7 @@
 VOID PianoProbeFoundation(VOID);
 VOID PianoNativeSetObserver(VOID (*Observer)(CONST CHAR8 *,BOOLEAN));
 VOID PianoProbeUfs(CONST VOID *Fdt);
+VOID PianoUfsReemitConnect(VOID);
 VOID PianoUfsSetProbeAction(EFI_STATUS (*Action)(CONST VOID *));
 EFI_STATUS PianoUfsReadOnlyDmaExperiment(CONST VOID *Fdt);
 EFI_STATUS PianoStartKeys(CONST VOID *Fdt);
@@ -105,6 +106,7 @@ STATIC EFI_STATUS ProductDebugReplay(VOID *Context) {
   EFI_STATUS Clock=PianoDisplayClockReemit(BootLogAlive);
   EFI_STATUS DisplayOwner=PianoProductDisplayReplay();
   (VOID)PianoProductBootObjectsReemit(BootLogAlive);
+  PianoUfsReemitConnect();
   if(!BootLogAlive())return EFI_ABORTED;
   if(PianoProductDisplayRetained())return Display==EFI_SUCCESS?EFI_COMPROMISED_DATA:Display;
   if(PianoDisplaySmmuRetained())return Translation==EFI_SUCCESS?EFI_COMPROMISED_DATA:Translation;
diff --git a/uefi/core/PianoUfsReadOnlyDma.c b/uefi/core/PianoUfsReadOnlyDma.c
index de3b650..b8bb5ec 100644
--- a/uefi/core/PianoUfsReadOnlyDma.c
+++ b/uefi/core/PianoUfsReadOnlyDma.c
@@ -6,6 +6,19 @@
 #include "PianoUfsDmaLayout.h"
 #include "PianoGpt.h"
 #include "PianoUfsProductVolume.h"
+// Diagnostic only. Whether the storage drivers bound to the published LUN
+// handles is only visible in PublishBlocks' ConnectController results, and
+// those lines are always outside the RAM console snapshot window: the capture
+// keeps the newest 256 KiB and ProductDebugReplay writes ~200 KB right before
+// it. Saving the statuses and re-emitting them from that same replay puts them
+// inside the window. No Boot Services call is added by this file.
+STATIC UINT8 mDiagConnectLun[8];
+STATIC EFI_STATUS mDiagConnectStatus[8];
+STATIC UINTN mDiagConnectCount;
+VOID PianoUfsReemitConnect(VOID) {
+  for(UINTN I=0;I<mDiagConnectCount;++I)
+    DEBUG((DEBUG_WARN,"SUNUEFI_UFS_CONNECT_REEMIT lun=%u status=%r\n",(UINT32)mDiagConnectLun[I],mDiagConnectStatus[I]));
+}
 #ifndef PIANO_UFS_PRODUCT_STORAGE
 #define PIANO_UFS_PRODUCT_STORAGE 0
 #endif
@@ -960,6 +973,7 @@ STATIC EFI_STATUS PublishBlocks(VOID) {
   for(UINTN I=0;I<mLunCount;++I) {
     Status=gBS->ConnectController(mBlockHandles[I],NULL,NULL,TRUE);
     DEBUG((DEBUG_WARN,"SUNUEFI_UFS_BLOCKIO_CONNECT lun=%u %r\n",mLuns[I].Id,Status));
+    if(mDiagConnectCount<8){mDiagConnectLun[mDiagConnectCount]=mLuns[I].Id;mDiagConnectStatus[mDiagConnectCount]=Status;++mDiagConnectCount;}
   }
   EFI_HANDLE *Handles=NULL;UINTN Count=0;
   Status=gBS->LocateHandleBuffer(ByProtocol,&gEfiBlockIoProtocolGuid,NULL,&Count,&Handles);
-- 
