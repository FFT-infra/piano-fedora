+static gint
+backlight_get_n_steps (GsdPowerManager *manager)
+{
+        gint step;
+
+        if (manager->kbd_brightness_max <= 0)
+                return 0;
+
+        step = BRIGHTNESS_STEP_AMOUNT (manager->kbd_brightness_max);
+        return (manager->kbd_brightness_max / step) + 1;
+}
