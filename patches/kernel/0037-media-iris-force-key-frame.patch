Subject: [PATCH] media: iris: forward encoder force-key-frame requests

Expose the gen2 button used at GOP boundaries by VA-API. Do not send this
one-shot request while configuring the session. Preserve firmware errors.

Protocol reference (Qualcomm GPL-2.0-only driver):
https://github.com/Pzqqt/android_kernel_xiaomi_marble/blob/bd6c3516f397ded311f7b7b787a52845a2d58fa0/techpack/video/driver/vidc/src/msm_vidc_control.c

--- a/drivers/media/platform/qcom/iris/iris_platform_common.h
+++ b/drivers/media/platform/qcom/iris/iris_platform_common.h
@@ -133,6 +133,7 @@
 	FRAME_SKIP_MODE,
 	FRAME_RC_ENABLE,
 	GOP_SIZE,
+	FORCE_KEY_FRAME,
 	ENTROPY_MODE,
 	DEBLOCK_MODE_H264,
 	DEBLOCK_ALPHA_H264,
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_defines.h
@@ -98,6 +98,12 @@
 #define HFI_PROP_BITRATE_LAYER4			0x0300013f
 #define HFI_PROP_BITRATE_LAYER5			0x03000140
 #define HFI_PROP_BITRATE_LAYER6			0x03000141
+enum hfi_syncframe_request_mode {
+	HFI_SYNC_FRAME_REQUEST_WITHOUT_SEQ_HDR = 0x00000001,
+	HFI_SYNC_FRAME_REQUEST_WITH_PREFIX_SEQ_HDR = 0x00000002,
+};
+
+#define HFI_PROP_REQUEST_SYNC_FRAME		0x03000145
 #define HFI_PROP_MAX_GOP_FRAMES			0x03000146
 #define HFI_PROP_MAX_B_FRAMES			0x03000147
 #define HFI_PROP_QUALITY_MODE			0x03000148
--- a/drivers/media/platform/qcom/iris/iris_ctrls.h
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.h
@@ -42,6 +42,7 @@
 int iris_set_use_ltr(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_mark_ltr(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_use_and_mark_ltr(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
+int iris_set_force_key_frame(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_intra_period(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_layer_type(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
 int iris_set_layer_count_gen1(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id);
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2.c
@@ -450,6 +450,12 @@
 		.value = 1,
 	},
 	{
+		.cap_id = FORCE_KEY_FRAME,
+		.hfi_id = HFI_PROP_REQUEST_SYNC_FRAME,
+		.flags = CAP_FLAG_INPUT_PORT | CAP_FLAG_DYNAMIC_ALLOWED,
+		.set = iris_set_force_key_frame,
+	},
+	{
 		.cap_id = GOP_SIZE,
 		.min = 0,
 		.max = INT_MAX,
--- a/drivers/media/platform/qcom/iris/iris_ctrls.c
+++ b/drivers/media/platform/qcom/iris/iris_ctrls.c
@@ -50,6 +50,8 @@
 		return FRAME_SKIP_MODE;
 	case V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE:
 		return FRAME_RC_ENABLE;
+	case V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME:
+		return FORCE_KEY_FRAME;
 	case V4L2_CID_MPEG_VIDEO_GOP_SIZE:
 		return GOP_SIZE;
 	case V4L2_CID_MPEG_VIDEO_H264_ENTROPY_MODE:
@@ -209,6 +211,8 @@
 		return V4L2_CID_MPEG_VIDEO_FRAME_SKIP_MODE;
 	case FRAME_RC_ENABLE:
 		return V4L2_CID_MPEG_VIDEO_FRAME_RC_ENABLE;
+	case FORCE_KEY_FRAME:
+		return V4L2_CID_MPEG_VIDEO_FORCE_KEY_FRAME;
 	case GOP_SIZE:
 		return V4L2_CID_MPEG_VIDEO_GOP_SIZE;
 	case ENTROPY_MODE:
@@ -357,7 +361,7 @@
 
 	if (vb2_is_streaming(q)) {
 		if (cap[cap_id].set)
-			cap[cap_id].set(inst, cap_id);
+			return cap[cap_id].set(inst, cap_id);
 	}
 
 	return 0;
@@ -1383,6 +1387,21 @@
 					     &hfi_val, sizeof(u32));
 }
 
+/* The first frame is already IDR. This button is sent only on a live request. */
+int iris_set_force_key_frame(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
+{
+	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
+	u32 hfi_value = inst->fw_caps[PREPEND_SPSPPS_TO_IDR].value ?
+		HFI_SYNC_FRAME_REQUEST_WITH_PREFIX_SEQ_HDR :
+		HFI_SYNC_FRAME_REQUEST_WITHOUT_SEQ_HDR;
+
+	return hfi_ops->session_set_property(inst, inst->fw_caps[cap_id].hfi_id,
+					     HFI_HOST_FLAGS_NONE,
+					     iris_get_port_info(inst, cap_id),
+					     HFI_PAYLOAD_U32_ENUM,
+					     &hfi_value, sizeof(hfi_value));
+}
+
 int iris_set_intra_period(struct iris_inst *inst, enum platform_inst_fw_cap_type cap_id)
 {
 	const struct iris_hfi_session_ops *hfi_ops = inst->hfi_session_ops;
@@ -1583,7 +1602,7 @@
 
 	for (i = 1; i < INST_FW_CAP_MAX; i++) {
 		cap = &inst->fw_caps[i];
-		if (!iris_valid_cap_id(cap->cap_id))
+		if (!iris_valid_cap_id(cap->cap_id) || cap->cap_id == FORCE_KEY_FRAME)
 			continue;
 
 		if (cap->cap_id && cap->set)
