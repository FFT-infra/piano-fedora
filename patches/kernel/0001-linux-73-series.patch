From 4f59763fe0e501ba2e404433b0b6cba6c59ce3cf Mon Sep 17 00:00:00 2001
From: piano-fedora <dev@piano.invalid>
Date: Sat, 24 Oct 2026 18:45:46 +0800
Subject: [PATCH] linux: carry the Iris, DPU, amplifier and panel-vendor work
 into the 7.3 series

7.3 prepares the release kernel by replaying one sealed mail series from the
public baseline; it no longer merges a stable branch, so there is no
merge_stable tuple to append our patches to. Their content has to live in the
series itself.

Register four patches there. The Iris one is required by the VA-API backend,
which refuses to decode without the decode-order-output capability. The DPU one
keeps the bonded slave's shared-CTL reset after both timing engines stop; 7.3
moved that cleanup to the top of the phys disable, so the slave now stops its
own engine and leaves the cleanup to the virtual encoder. The amplifier one is
unchanged from the 7.2.9 tree and still applies as-is. The touch one exports
the panel ID pin as panel_vendor and republishes the THP stream as a character
device, so the userspace reader can resolve the panel vendor from the path it
opened instead of assuming CSOT.

series.json is a strict chain: each row pins the original commit, its parent,
the resulting tree and an ISO committer date, and the last row's tree must equal
target_tree. config/release.json carries that same target_tree, so both move
together.

The patch files are stored as binary diffs because a mail patch keeps blank
context lines as a single space, and apply-patches.py applies with
--whitespace=error-all.
---
 config/release.json                           |   2 +-
 .../7.3/0025-dpu-defer-slave-cleanup.patch    | Bin 0 -> 4190 bytes
 ...dia-iris-decode-order-and-deblocking.patch | Bin 0 -> 16506 bytes
 .../0027-asoc-piano-speaker-gain-limit.patch  | Bin 0 -> 3013 bytes
 ...028-input-nt36532e-panel-vendor-misc.patch | Bin 0 -> 4997 bytes
 patches/linux/7.3/series.json                 |  36 +++++++++++++++++-
 6 files changed, 35 insertions(+), 3 deletions(-)
 create mode 100644 patches/linux/7.3/0025-dpu-defer-slave-cleanup.patch
 create mode 100644 patches/linux/7.3/0026-media-iris-decode-order-and-deblocking.patch
 create mode 100644 patches/linux/7.3/0027-asoc-piano-speaker-gain-limit.patch
 create mode 100644 patches/linux/7.3/0028-input-nt36532e-panel-vendor-misc.patch

diff --git a/config/release.json b/config/release.json
index e5fad05..991bf9d 100644
--- a/config/release.json
+++ b/config/release.json
@@ -7,7 +7,7 @@
     "stable_source": "https://github.com/torvalds/linux.git",
     "stable_commit": "c03c1a14507dfaf8b856c2608f9ac216021fc222",
     "stable_version": "7.3.0",
-    "target_tree": "4a5923915b4214f850287fc51c658781dc54a195",
+    "target_tree": "45528c432cd0767948a71a4086c1d4a36ef83583",
     "cpu_model_overlay": "linux/dts/piano-cpu-model.dtso",
     "additional_dtb_overlays": [
       "linux/dts/piano-cma.dtso",
