+/* The ADSP holds the adapter verified until the next authentication */
+static bool piano_mca_adapter_verified(struct piano_mca *mca)
+{
+	return mipps_auth &&
+	       piano_mca_read_u32(mca, MCA_PROP_PD_VERIFIED) == 1;
+}
