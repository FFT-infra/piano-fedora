+	mca->cp_mv = 0;
+	mca->cp_polls = 0;
+	mca->cp_low = 0;
+	mca->cp_ibus_hot = mca->cp_ibus_ma;
+	mca->cp_ibat_trip = 0;
+	mca->cp_warm_ma = MCA_CP_IBAT_MAX_MA;
+	mca->cp_buck_par = false;
