+	    min(tbat, tpack) < MCA_CP_TBAT_MIN ||
+	    max(tbat, tpack) >= MCA_CP_TBAT_WARM - MCA_CP_TBAT_HYS ||
+	    piano_mca_read_u32(mca, MCA_PROP_VERIFY_PROCESS))
+		return;
