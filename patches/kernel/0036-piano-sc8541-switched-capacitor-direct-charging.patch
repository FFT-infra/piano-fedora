+static int piano_mca_cp_request(struct piano_mca *mca, u32 mv)
+{
+	mv = clamp(rounddown(mv, 20), (u32)MCA_CP_PPS_MIN_MV,
+		   min_t(u32, mca->cp_max_mv, MCA_CP_PPS_MAX_MV));
+	if (mv == mca->cp_mv)
+		return 0;
