From: piano-fedora <dev@piano.invalid>
Date: Thu, 12 Nov 2026 21:30:00 +0800
Subject: [PATCH] usb: drain the Rx FIFO and prove the halt after the reset

Patch 0003 has a defect that no device run is needed to see: it waits for
DSTS.DCNRD to assert after CSftRst, but DCNRD means "device controller not
ready". Linux reads the same bit as "wait until it clears"
(dwc3_gadget_set_link_state) and every firmware reset path here only polls
CSftRst, so the fallback could never report success even when the reset
worked. After a soft reset the core is already reporting DevCtrlHlt (the
startup snapshot ends at DSTS 0x00D2046C with RunStop 0), so read that bit.

The stop sequence also ended EP0 before clearing RunStop. A SETUP that the
host sent during the handoff lives in the Rx FIFO until it is DMA'd out, and
the core does not process End Transfer while one is pending
(dwc3_stop_active_transfer). Ending it and returning the TRB leaves the core
without a target for that packet, which matches the captured failure: RxFIFO
not empty, CoreIdle and DevCtrlHlt both clear, and a link that went from
unconnected to Address while the 2 s poll ran.

So keep RunStop set, leave EP0's setup TRB armed, and poll DSTS.RXFIFOEMPTY
for up to 100 ms so the pending SETUP can leave the FIFO. Only after the
FIFO is empty, end the transfers that can be ended (EP0 only outside the
setup phase), then clear RunStop. If DevCtrlHlt still does not come, wake
both PHY interfaces like ServiceReset() does, run the soft reset, and take
DevCtrlHlt as the proof. Log the decoded DSTS fields and EP0's TRB so the
next failure does not need another guess.
---
diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index 76ec123..5f364c4 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -255,10 +255,13 @@ STATIC UINT32 AcknowledgeEvents(VOID);
 STATIC VOID HaltState(CONST CHAR8 *Tag,UINT32 Armed,BOOLEAN Halted) {
   // The RAM log ring drops bits under load, so the DMA trace writes every
   // record twice. Duplicate this one the same way.
+  UINT32 Dsts=Dr(0xC70C);
   for(UINTN Copy=0;Copy<2;++Copy)
-    DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_STATE tag=%a copy=%u halted=%u armed=%x phase=%u gevnt=%u gctl=%08x dcfg=%08x dctl=%08x dsts=%08x phy=%08x pipe=%08x\n",
+    DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_STATE tag=%a copy=%u halted=%u armed=%x phase=%u gevnt=%u gctl=%08x dcfg=%08x dctl=%08x dsts=%08x hlt=%u idle=%u rxf=%u link=%u spd=%u phy=%08x pipe=%08x\n",
       Tag,(UINT32)Copy,Halted?1U:0U,Armed,(UINT32)mPhase,Dr(0xC40C)&0xFFFF,
-      Dr(0xC110),Dr(0xC700),Dr(0xC704),Dr(0xC70C),Dr(0xC200),Dr(0xC2C0)));
+      Dr(0xC110),Dr(0xC700),Dr(0xC704),Dsts,
+      (Dsts&BIT22)?1U:0U,(Dsts&BIT23)?1U:0U,(Dsts&BIT17)?1U:0U,(Dsts>>18)&0xF,Dsts&7,
+      Dr(0xC200),Dr(0xC2C0)));
 }
 STATIC UINT32 AcknowledgeEvents(VOID) {
   UINT32 Count=Dr(0xC40C)&0xFFFF;
@@ -269,16 +272,31 @@ STATIC UINT32 AcknowledgeEvents(VOID) {
 STATIC EFI_STATUS Halt(VOID) {
   UINT32 Armed=0;for(UINTN Ep=0;Ep<ARRAY_SIZE(mPending);++Ep)if(mPending[Ep])Armed|=1U<<Ep;
   HaltState("entry",Armed,FALSE);
-  // Databook 4.1.8: a device-initiated disconnect must end every active
-  // transfer before RunStop is cleared, or the core can stay in a transfer
-  // state and never report DevCtrlHlt.
-  for(UINTN Ep=0;Ep<ARRAY_SIZE(mPending);++Ep)if(mPending[Ep])(VOID)StopTransfer((UINT8)Ep);
+  DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_EP0 pending=%u phase=%u status_waiting=%u trb_control=%08x trb_size=%08x setup=%02x%02x%02x%02x\n",
+    mPending[0]?1U:0U,(UINT32)mPhase,mStatusWaiting?1U:0U,
+    ((DWC_TRB *)mTrbs[0].Cpu)->Control,((DWC_TRB *)mTrbs[0].Cpu)->Size,
+    ((UINT8 *)mSetup.Cpu)[0],((UINT8 *)mSetup.Cpu)[1],((UINT8 *)mSetup.Cpu)[2],((UINT8 *)mSetup.Cpu)[7]));
+  // DevCtrlHlt needs an idle core with an empty Rx FIFO, and the core refuses
+  // End Transfer while a SETUP is still waiting to be DMA'd out. Keep RunStop
+  // set and leave EP0's setup TRB armed so a SETUP that arrived during the
+  // handoff can leave the FIFO first.
+  if(!mPending[0] && mPhase==0)(VOID)ArmSetup();
+  UINT32 Drained=0;
+  for(;Drained<100;++Drained){
+    if(Dr(0xC70C)&BIT17)break;
+    if(!mPending[0] && mPhase==0)(VOID)ArmSetup();
+    (VOID)AcknowledgeEvents();
+    gBS->Stall(1000);
+  }
+  HaltState("drained",Armed,FALSE);
+  // EP0 in the setup phase keeps its TRB: the End Transfer command is not
+  // processed until that SETUP is out of the FIFO, and returning its buffers
+  // would leave the core without a target for the packet.
+  for(UINTN Ep=0;Ep<ARRAY_SIZE(mPending);++Ep)
+    if(mPending[Ep] && (Ep>1 || mPhase!=0))(VOID)StopTransfer((UINT8)Ep);
   (VOID)AcknowledgeEvents();
-  // dwc3_ep0_reset_state parks a half-finished control transfer back in the
-  // setup phase; otherwise the core keeps waiting for the host to finish it.
-  if(mPhase!=0 || mStatusWaiting)(VOID)ArmSetup();
   // dwc3_gadget_run_stop keeps the HS/FS interface awake across the stop.
-  UINT32 Phy=Dr(0xC200),Saved=mControl.SuperSpeed?0:Phy&(BIT6|BIT8);
+  UINT32 Phy=Dr(0xC200),Pipe=Dr(0xC2C0),Saved=mControl.SuperSpeed?0:(Phy&(BIT6|BIT8));
   if(Saved)Dw(0xC200,Phy&~Saved);
   // The core ignores DCTL writes while a DEPCMD is still running, so confirm
   // RunStop reads back as cleared instead of trusting the write.
@@ -287,19 +305,27 @@ STATIC EFI_STATUS Halt(VOID) {
   HaltState("stop",Armed,FALSE);
   BOOLEAN Halted=FALSE;UINT32 Acked=0,Loops=0;
   for(;Loops<2000;++Loops){if(Dr(0xC70C)&BIT22){Halted=TRUE;break;}Acked+=AcknowledgeEvents();gBS->Stall(1000);}
-  // While the host keeps the link addressed the core can refuse to halt. A
-  // core soft reset (dwc3_core_soft_reset) proves it stopped fetching DMA, and
-  // it is what the kernel applies to the core right after this handoff.
+  // While the host keeps the link addressed the core can refuse to idle. A
+  // core soft reset stops the DMA engine; Linux applies the same reset to this
+  // core in dwc3_core_soft_reset() as soon as it probes, so the kernel inherits
+  // nothing worse. Wake both PHY interfaces first, exactly like ServiceReset().
+  // Success is DevCtrlHlt after the reset: Linux reads DSTS.DCNRD as "not
+  // ready" and waits for it to clear, so polling for it to be set never ends.
   BOOLEAN Reset=FALSE;
   if(!Halted) {
-    Dw(0xC704,(Dr(0xC704)|BIT30)&~BIT31);
-    for(UINTN I=0;I<1000;++I)if(!(Dr(0xC704)&BIT30))break;else gBS->Stall(1000);
-    for(UINTN I=0;I<1000;++I)if(Dr(0xC70C)&BIT29){Reset=TRUE;break;}else gBS->Stall(1000);
+    Dw(0xC200,Dr(0xC200)&~(BIT6|BIT8));
+    Dw(0xC2C0,Pipe&~BIT17);
+    Dw(0xC704,(Dr(0xC704)&~(BIT31|(0xfU<<5)))|BIT30);
+    BOOLEAN Cleared=FALSE;
+    for(UINTN I=0;I<200;++I)if(!(Dr(0xC704)&BIT30)){Cleared=TRUE;break;}else gBS->Stall(1000);
+    if(Cleared) {
+      for(UINTN I=0;I<200;++I){if(Dr(0xC70C)&BIT22){Reset=TRUE;break;}gBS->Stall(1000);}
+    }
   }
-  if(Saved)Dw(0xC200,Phy);
+  Dw(0xC200,Phy);Dw(0xC2C0,Pipe);
   HaltState(Reset?"reset":Halted?"halted":"timeout",Armed,Halted);
-  DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_RESULT halted=%u reset=%u armed=%x acked=%u loops=%u attempts=%u gevnt=%u\n",
-    Halted?1U:0U,Reset?1U:0U,Armed,Acked,Loops,Attempts,Dr(0xC40C)&0xFFFF));
+  DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_RESULT halted=%u reset=%u armed=%x acked=%u loops=%u attempts=%u drained=%u gevnt=%u dctl=%08x dsts=%08x\n",
+    Halted?1U:0U,Reset?1U:0U,Armed,Acked,Loops,Attempts,Drained,Dr(0xC40C)&0xFFFF,Dr(0xC704),Dr(0xC70C)));
   return Halted||Reset?EFI_SUCCESS:EFI_TIMEOUT;
 }
 STATIC EFI_STATUS CompleteEventDma(PIANO_DMA_BUFFER *Buffer) {
