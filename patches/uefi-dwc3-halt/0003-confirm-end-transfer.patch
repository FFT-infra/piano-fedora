From: piano-fedora <dev@piano.invalid>
Date: Thu, 12 Nov 2026 20:00:00 +0800
Subject: [PATCH] usb: confirm the end-transfer command and prove the core stopped

The second device run cleared the previous guess. Halt() logged the state it
started from and the state it gave up in:

  SUNUEFI_USB_HALT_ENTRY armed=1 phase=0 status_waiting=0 gevnt=0
  SUNUEFI_USB_HALT_RESULT halted=0 armed=1 acked=0 loops=2000 gevnt=0 dsts=0011707C

One posted transfer (EP0), a completely empty event ring for the whole two
second poll, and a core that still reports USBLNKST 4 (Address) with neither
DevCtrlHlt nor CoreIdle set. The two DMA completions in between are
StopTransfer() returning its own buffers, not the core finishing anything.

Two things can keep RunStop from taking effect. The END command is sent without
CMDIOC, and Command() returns after a fixed one millisecond without learning
whether the core finished it; a DCTL write while a DEPCMD is still running is
ignored. Linux sends END with CMDIOC in dwc3_gadget_soft_disconnect() and waits
for the completion. Do the same, then read DCTL back and retry the clear
instead of trusting a single write.

If the core still refuses to halt while the host keeps the link addressed, fall
back to dwc3_core_soft_reset(): set DCTL CSftRst with RunStop cleared, wait for
CSftRst to drop and DSTS DCNRD to assert. That is the same reset the kernel
applies to this core right after the handoff, and it proves the core is no
longer fetching DMA. Report it as reset=1 rather than hiding it.

Mirror the state line twice because the RAM log ring corrupts records, and log
DCTL/DSTS/GCTL/DCFG/GEVNT/GUSB2PHYCFG/GUSB3PIPECTL so the next run is readable
without another guess.
---
diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index 52beb7e..76ec123 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -251,10 +251,15 @@ STATIC EFI_STATUS Command(UINT8 Ep,UINT32 Cmd,UINT32 P0,UINT32 P1,UINT32 P2) {
 }
 STATIC EFI_STATUS StopTransfer(UINT8 Ep);
 STATIC EFI_STATUS ArmSetup(VOID);
-// The controller does not reach DevCtrlHlt while the event ring still reports
-// unread events, and dwc3_gadget_soft_disconnect leans on its interrupt handler
-// to acknowledge them during the same poll. Nothing pumps the service loop at
-// this point, so acknowledge them in place.
+STATIC UINT32 AcknowledgeEvents(VOID);
+STATIC VOID HaltState(CONST CHAR8 *Tag,UINT32 Armed,BOOLEAN Halted) {
+  // The RAM log ring drops bits under load, so the DMA trace writes every
+  // record twice. Duplicate this one the same way.
+  for(UINTN Copy=0;Copy<2;++Copy)
+    DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_STATE tag=%a copy=%u halted=%u armed=%x phase=%u gevnt=%u gctl=%08x dcfg=%08x dctl=%08x dsts=%08x phy=%08x pipe=%08x\n",
+      Tag,(UINT32)Copy,Halted?1U:0U,Armed,(UINT32)mPhase,Dr(0xC40C)&0xFFFF,
+      Dr(0xC110),Dr(0xC700),Dr(0xC704),Dr(0xC70C),Dr(0xC200),Dr(0xC2C0)));
+}
 STATIC UINT32 AcknowledgeEvents(VOID) {
   UINT32 Count=Dr(0xC40C)&0xFFFF;
   if(!Count || Count>4096 || (Count&3))return 0;
@@ -263,26 +268,39 @@ STATIC UINT32 AcknowledgeEvents(VOID) {
 }
 STATIC EFI_STATUS Halt(VOID) {
   UINT32 Armed=0;for(UINTN Ep=0;Ep<ARRAY_SIZE(mPending);++Ep)if(mPending[Ep])Armed|=1U<<Ep;
-  DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_ENTRY armed=%x phase=%u status_waiting=%u gevnt=%u dctl=%08x dsts=%08x phy=%08x\n",
-    Armed,(UINT32)mPhase,mStatusWaiting?1U:0U,Dr(0xC40C)&0xFFFF,Dr(0xC704),Dr(0xC70C),Dr(0xC200)));
+  HaltState("entry",Armed,FALSE);
   // Databook 4.1.8: a device-initiated disconnect must end every active
   // transfer before RunStop is cleared, or the core can stay in a transfer
-  // state and never report DevCtrlHlt. A host that re-enumerates while the
-  // loader reads its image leaves EP0 armed, which is where this timed out.
+  // state and never report DevCtrlHlt.
   for(UINTN Ep=0;Ep<ARRAY_SIZE(mPending);++Ep)if(mPending[Ep])(VOID)StopTransfer((UINT8)Ep);
+  (VOID)AcknowledgeEvents();
   // dwc3_ep0_reset_state parks a half-finished control transfer back in the
   // setup phase; otherwise the core keeps waiting for the host to finish it.
   if(mPhase!=0 || mStatusWaiting)(VOID)ArmSetup();
   // dwc3_gadget_run_stop keeps the HS/FS interface awake across the stop.
   UINT32 Phy=Dr(0xC200),Saved=mControl.SuperSpeed?0:Phy&(BIT6|BIT8);
   if(Saved)Dw(0xC200,Phy&~Saved);
-  Dw(0xC704,Dr(0xC704)&~BIT31);
+  // The core ignores DCTL writes while a DEPCMD is still running, so confirm
+  // RunStop reads back as cleared instead of trusting the write.
+  UINT32 Attempts=0;
+  for(;Attempts<3;++Attempts){Dw(0xC704,Dr(0xC704)&~BIT31);if(!(Dr(0xC704)&BIT31))break;}
+  HaltState("stop",Armed,FALSE);
   BOOLEAN Halted=FALSE;UINT32 Acked=0,Loops=0;
   for(;Loops<2000;++Loops){if(Dr(0xC70C)&BIT22){Halted=TRUE;break;}Acked+=AcknowledgeEvents();gBS->Stall(1000);}
+  // While the host keeps the link addressed the core can refuse to halt. A
+  // core soft reset (dwc3_core_soft_reset) proves it stopped fetching DMA, and
+  // it is what the kernel applies to the core right after this handoff.
+  BOOLEAN Reset=FALSE;
+  if(!Halted) {
+    Dw(0xC704,(Dr(0xC704)|BIT30)&~BIT31);
+    for(UINTN I=0;I<1000;++I)if(!(Dr(0xC704)&BIT30))break;else gBS->Stall(1000);
+    for(UINTN I=0;I<1000;++I)if(Dr(0xC70C)&BIT29){Reset=TRUE;break;}else gBS->Stall(1000);
+  }
   if(Saved)Dw(0xC200,Phy);
-  DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_RESULT halted=%u armed=%x acked=%u loops=%u gevnt=%u dctl=%08x dsts=%08x\n",
-    Halted?1U:0U,Armed,Acked,Loops,Dr(0xC40C)&0xFFFF,Dr(0xC704),Dr(0xC70C)));
-  return Halted?EFI_SUCCESS:EFI_TIMEOUT;
+  HaltState(Reset?"reset":Halted?"halted":"timeout",Armed,Halted);
+  DEBUG((DEBUG_WARN,"SUNUEFI_USB_HALT_RESULT halted=%u reset=%u armed=%x acked=%u loops=%u attempts=%u gevnt=%u\n",
+    Halted?1U:0U,Reset?1U:0U,Armed,Acked,Loops,Attempts,Dr(0xC40C)&0xFFFF));
+  return Halted||Reset?EFI_SUCCESS:EFI_TIMEOUT;
 }
 STATIC EFI_STATUS CompleteEventDma(PIANO_DMA_BUFFER *Buffer) {
   EFI_STATUS S=PianoDmaComplete(Buffer,EFI_SUCCESS,TRUE);
@@ -293,7 +311,9 @@ STATIC EFI_STATUS CompleteEventDma(PIANO_DMA_BUFFER *Buffer) {
 }
 STATIC EFI_STATUS StopTransfer(UINT8 Ep) {
   if(!mPending[Ep])return EFI_SUCCESS;
-  EFI_STATUS Status=Command(Ep,8|BIT11|((UINT32)mResource[Ep]<<16),0,0,0);
+  // CMDIOC so the END reports through CMDACT: Halt clears RunStop right after
+  // this, and the core ignores that write while the command is still running.
+  EFI_STATUS Status=Command(Ep,8|BIT8|BIT11|((UINT32)mResource[Ep]<<16),0,0,0);
   if(EFI_ERROR(Status))return Status;
   // Command completed the documented non-IOC END delay before DMA is returned.
   Status=CompleteEventDma(&mTrbs[Ep]);if(EFI_ERROR(Status))return Status;
