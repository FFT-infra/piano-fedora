+
+# The manifest lists names relative to the store directory, so verify from
+# there. --strict rejects a truncated or malformed line instead of skipping it.
+store_matches() {
+    manifest=$1
+    directory=$2
+    [ -s "$manifest" ] || return 1
+    (cd "$directory" && sha256sum --check --quiet --strict "$manifest") >/dev/null 2>&1
+}
 
