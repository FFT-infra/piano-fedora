+
+# Libraries the PD loads at run time are named in the dynamic sensor configs
+# and exist only on the vendor partition. The file service resolves them
+# through ADSP_LIBRARY_PATH, which the unit points at this store.
+rfsa_libraries() {
+    grep -ho '"data"[[:space:]]*:[[:space:]]*"[^"]*\.so"' "$ROOT/odm/config"/*_dynamic_sensors.json 2>/dev/null |
+        sed 's/.*"\([^"]*\.so\)"/\1/' | sort -u
+}
+
+import_rfsa() {
+    ensure_vendor
+    target=$ROOT/rfsa/adsp
+    mkdir -p "$target"
+    n=0
+    absent=
+    for library in $(rfsa_libraries); do
+        safe_name "$library"
+        tmp=$(mktemp "$target/.$library.XXXXXX")
+        if ! dump.erofs --path="/lib/rfsa/adsp/$library" --cat "$VENDOR" > "$tmp" || [ ! -s "$tmp" ]; then
+            rm -f "$tmp"
+            # odm names libraries for other SKUs too; a missing one is the same
+            # state Android boots with, so record it and keep going.
+            absent="$absent $library"
+            continue
+        fi
+        chmod 0644 "$tmp"
+        sync -- "$tmp"
+        mv "$tmp" "$target/$library"
+        n=$((n + 1))
+    done
+    [ -z "$absent" ] || log "not present on $VENDOR:$absent"
+    (cd "$target" && sha256sum -- * > "$ROOT/rfsa/.adsp.sha256.$$")
+    mv "$ROOT/rfsa/.adsp.sha256.$$" "$ROOT/rfsa/adsp.sha256"
+    sync -- "$ROOT/rfsa"
+    log "imported $n sensors dynamic libraries from $VENDOR"
+}
+
+# Import, then prove the copy on disk matches the manifest before the PD reads
+# it. Retry when it does not: a store the filesystem failed to persist is not
+# fixed by a later verification pass alone.
+ensure_store() {
+    directory=$1
+    manifest=$2
+    importer=$3
+    attempt=0
+    store_matches "$manifest" "$directory" && return 0
+    while [ "$attempt" -lt 3 ]; do
+        attempt=$((attempt + 1))
+        [ "$attempt" -eq 1 ] || log "store $directory does not match its manifest, re-importing (attempt $attempt)"
+        "$importer"
+        store_matches "$manifest" "$directory" && return 0
+    done
+    log "store $directory still does not match its manifest after $attempt imports"
+    exit 1
+}
+
+mkdir -p "$ROOT"
+
+ensure_store "$ROOT/odm/config" "$ROOT/odm/config.sha256" import_odm
+ensure_store "$ROOT/vendor" "$ROOT/vendor/sns_reg_config.sha256" import_vendor
+
+# Only rebuild the libraries when the store exists but does not verify; the
+# names come from the configuration just verified above.
+libraries=$(rfsa_libraries 2>/dev/null || true)
+if [ -n "$libraries" ] && ! store_matches "$ROOT/rfsa/adsp.sha256" "$ROOT/rfsa/adsp"; then
+    attempt=0
+    while [ "$attempt" -lt 3 ]; do
+        attempt=$((attempt + 1))
+        [ "$attempt" -eq 1 ] || log "sensors dynamic library store does not match its manifest, re-importing (attempt $attempt)"
+        import_rfsa
+        store_matches "$ROOT/rfsa/adsp.sha256" "$ROOT/rfsa/adsp" && break
+    done
+    store_matches "$ROOT/rfsa/adsp.sha256" "$ROOT/rfsa/adsp" ||
+        { log "sensors dynamic library store still does not match its manifest"; exit 1; }
 fi
 
