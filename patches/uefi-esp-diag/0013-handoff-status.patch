上一发读到 find: SUNUEFI_HANDOFF 命中 2 处、Linux version 与 Kernel panic 都是 0，
text 只截到第一行前半（prepare=Success raw=1）。把关键串换成
"SUNUEFI_HANDOFF arm=" 与 "SUNUEFI_HANDOFF enter" 两条，摘录改为从 arm= 行开始、
并由第二次扫描定位 enter 行覆盖掉摘录，这样一次回复里能同时看到交接后两步的状态与
Enter 之前打印的 kernel/dtb/initrd 地址。
---
 uefi/core/PianoDwc3Device.c | 81 ++++++-------------------------------
 1 file changed, 12 insertions(+), 69 deletions(-)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index 43a7251..e733468 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -441,48 +441,6 @@ STATIC UINT32 DiagReadBpb(EFI_HANDLE Esp,EFI_DISK_IO_PROTOCOL **DiskIo,CHAR8 *He
 // the reply even though it is still there. This copies the tail of the ring and
 // scans only the part *before* the current marker: that is where a previous
 // kernel's printk would sit if it registered ramoops before it died.
-STATIC UINT8 *mPrevBuffer;
-STATIC UINT32 DiagPrevLog(UINT32 *Hits,CHAR8 *Excerpt,UINTN ExcerptCap){
- STATIC CONST CHAR8 Marker[]="SUNUEFI_RAMLOG_BEGIN";
- CONST UINTN Capacity=0x200000-12,Want=0x80000;
- CONST volatile UINT32 *H=(CONST volatile UINT32 *)(UINTN)0xA3500000;
- for(UINTN I=0;I<5;++I)Hits[I]=0;
- for(UINTN I=0;I<ExcerptCap;++I)Excerpt[I]=0;
- UINT32 Sig=H[0],Start=H[1],Size=H[2];MemoryFence();
- Hits[4]=Start;
- if(Sig!=0x43474244||Start>=Capacity||Size>Capacity||Start>Size)return 1;
- if(mPrevBuffer==NULL){mPrevBuffer=AllocatePool(Want);if(mPrevBuffer==NULL)return 3;}
- UINTN Bytes=MIN((UINTN)Size,(UINTN)Want);
- UINTN Offset=(Start+Capacity-Bytes)%Capacity;
- CONST volatile UINT8 *Ring=(CONST volatile UINT8 *)H+12;
- for(UINTN I=0;I<Bytes;++I)mPrevBuffer[I]=Ring[(Offset+I)%Capacity];
- MemoryFence();
- UINTN Begin=0;
- for(UINTN I=0;I+sizeof(Marker)-1<=Bytes;++I)
-  if((I==0||mPrevBuffer[I-1]=='\n')&&!CompareMem(mPrevBuffer+I,Marker,sizeof(Marker)-1))Begin=I;
- UINTN End=Begin?Begin:Bytes;
- for(UINTN I=0;I+16<End;++I){
-  if(!CompareMem(mPrevBuffer+I,"Linux version",13))++Hits[0];
-  if(!CompareMem(mPrevBuffer+I,"Kernel panic",12))++Hits[1];
-  if(!CompareMem(mPrevBuffer+I,"ramoops",7))++Hits[2];
-  if(!CompareMem(mPrevBuffer+I,"[    0.",7))++Hits[3];
- }
- // Tail view: the bytes immediately before the marker, sanitized. This shows
- // whatever the previous boot wrote last (for example a handoff status line)
- // even when it matches none of the counted patterns above.
- if(End){
-  UINTN From=(End>64)?End-64:0;
-  UINTN N=0;for(;N+1<ExcerptCap&&From+N<End;++N){CHAR8 C=(CHAR8)mPrevBuffer[From+N];Excerpt[N]=(C>=0x20&&C<0x7F)?C:'.';}
-  Excerpt[N]=0;
- }
- for(UINTN I=0;I+16<End && Excerpt[0]==0;++I){
-  if(!CompareMem(mPrevBuffer+I,"Linux version",13)||!CompareMem(mPrevBuffer+I,"Kernel panic",12)){
-   UINTN N=0;for(;N+1<ExcerptCap&&I+N<End;++N){CHAR8 C=(CHAR8)mPrevBuffer[I+N];Excerpt[N]=(C>=0x20&&C<0x7F)?C:'.';}
-   Excerpt[N]=0;
-  }
- }
- return 0;
-}
 // After a handoff the region no longer carries the firmware's ring header, so
 // the reader above rejects it. Scan the console zone linearly instead: the
 // kernel keeps its pstore text in the same reserved region, and the first
@@ -492,16 +450,16 @@ STATIC UINT32 DiagZoneScan(UINT32 *Hits,UINT32 *Words,CHAR8 *Excerpt,UINTN Excer
  CONST UINTN Want=0x200000;
  CONST volatile UINT32 *Z=(CONST volatile UINT32 *)(UINTN)0xA3500000;
  CONST volatile UINT8 *B=(CONST volatile UINT8 *)Z+12;
- STATIC CONST CHAR8 *Keys[3]={"SUNUEFI_HANDOFF","Linux version","Kernel panic"};
- for(UINTN I=0;I<3;++I)Hits[I]=0;
+ STATIC CONST CHAR8 *Keys[4]={"SUNUEFI_HANDOFF arm=","SUNUEFI_HANDOFF enter","Linux version","Kernel panic"};
+ for(UINTN I=0;I<4;++I)Hits[I]=0;
  for(UINTN I=0;I<6;++I)Words[I]=Z[I];
  for(UINTN I=0;I<ExcerptCap;++I)Excerpt[I]=0;
  if(mZoneBuffer==NULL){mZoneBuffer=AllocatePool(Want);if(mZoneBuffer==NULL)return 3;}
  for(UINTN I=0;I<Want;++I)mZoneBuffer[I]=B[I];
  MemoryFence();
  UINTN HitAt=Want;
- for(UINTN I=0;I+17<Want;++I){
-  for(UINTN K=0;K<3;++K){
+ for(UINTN I=0;I+20<Want;++I){
+  for(UINTN K=0;K<4;++K){
    UINTN L=AsciiStrLen((CHAR8 *)Keys[K]);
    if(I+L<Want && !CompareMem(mZoneBuffer+I,Keys[K],L)){++Hits[K];if(HitAt==Want)HitAt=I;}
   }
@@ -509,6 +467,13 @@ STATIC UINT32 DiagZoneScan(UINT32 *Hits,UINT32 *Words,CHAR8 *Excerpt,UINTN Excer
  if(HitAt<Want){
   UINTN N=0;for(;N+1<ExcerptCap&&HitAt+N<Want;++N){CHAR8 C=(CHAR8)mZoneBuffer[HitAt+N];Excerpt[N]=(C>=0x20&&C<0x7F)?C:'.';}
   Excerpt[N]=0;
+  // Second excerpt starts at the enter line, so both handoff status lines are read.
+  CONST CHAR8 *Enter="SUNUEFI_HANDOFF enter";UINTN EL=AsciiStrLen((CHAR8 *)Enter);
+  for(UINTN I=0;I+EL<Want;++I)
+   if(!CompareMem(mZoneBuffer+I,Enter,EL)){
+    UINTN M=0;for(;M+1<ExcerptCap&&I+M<Want;++M){CHAR8 C=(CHAR8)mZoneBuffer[I+M];Excerpt[M]=(C>=0x20&&C<0x7F)?C:'.';}
+    Excerpt[M]=0;break;
+   }
  }
  return 0;
 }
@@ -670,28 +635,6 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      P=EspHex(P,DiagHandles(&mDiagSfsGuid));
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    // INFOprev: <返回> <Linux version 次数> <Kernel panic 次数> <ramoops 次数>
-    //           <"[    0." 行数> <环写指针>；INFOprev2 摘一段最像内核日志的原文。
-    {UINT32 Hits[5];CHAR8 Excerpt[49];
-     UINT32 PrevStatus=DiagPrevLog(Hits,Excerpt,sizeof(Excerpt));
-     CHAR8 *P=Row;CopyMem(P,"INFOprev:",9);P+=9;P=EspHex(P,PrevStatus);
-     for(UINTN I=0;I<5;++I)P=EspHex(P,Hits[I]);
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-     P=Row;CopyMem(P,"INFOprev2:",10);P+=10;
-     CopyMem(P,Excerpt,AsciiStrLen(Excerpt));P+=AsciiStrLen(Excerpt);
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    {UINT32 Hits[5];CHAR8 Excerpt[49];
-     UINT32 PrevStatus=DiagPrevLog(Hits,Excerpt,sizeof(Excerpt));
-     CHAR8 *P=Row;CopyMem(P,"INFOprev:",9);P+=9;P=EspHex(P,PrevStatus);
-     for(UINTN I=0;I<5;++I)P=EspHex(P,Hits[I]);
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-     P=Row;CopyMem(P,"INFOprev2:",10);P+=10;
-     CopyMem(P,Excerpt,AsciiStrLen(Excerpt));P+=AsciiStrLen(Excerpt);
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     {CHAR8 *P=Row;CopyMem(P,"INFOesp1:",9);P+=9;
      P=EspHex(P,(UINT32)PianoRawLinuxStableLoadStatus());
      P=EspHex(P,PianoRawLinuxStableLoadStage());
@@ -710,7 +653,7 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
      P=Row;CopyMem(P,"INFOfind:",9);P+=9;P=EspHex(P,ZoneStatus);
-     for(UINTN I=0;I<3;++I)P=EspHex(P,Hits[I]);
+     for(UINTN I=0;I<4;++I)P=EspHex(P,Hits[I]);
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
      P=Row;CopyMem(P,"INFOtext:",9);P+=9;
