ESP 加载成功后设备不重启、USB 消失、屏幕黑而背光亮，而内核侧没有任何 printk——所以
必须先把「固件交接失败」与「内核起步即死」这条边界划出来。固件原先对
PianoRawLinuxPrepare / PianoLateHandoffArmRaw / PianoRawLinuxEnter 三步没有任何日志，
本提交给三步各加一行 DEBUG（进入 Enter 前还打印 kernel/dtb/initrd 地址与 initrd 长度），
失败时 FailStop 之前的最后一条即可定性。

同时给 INFOprev 的摘录加一个尾部视图：当环里存在本次会话标记时，摘录直接取标记之前那
64 字节（可打印化），避免只按四种固定模式匹配而漏掉自定义日志行。
---
 uefi/core/PianoDwc3Device.c  | 8 ++++++++
 uefi/core/PianoProductCore.c | 9 ++++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index 74a4f43..a7e9443 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -468,6 +468,14 @@ STATIC UINT32 DiagPrevLog(UINT32 *Hits,CHAR8 *Excerpt,UINTN ExcerptCap){
   if(!CompareMem(mPrevBuffer+I,"ramoops",7))++Hits[2];
   if(!CompareMem(mPrevBuffer+I,"[    0.",7))++Hits[3];
  }
+ // Tail view: the bytes immediately before the marker, sanitized. This shows
+ // whatever the previous boot wrote last (for example a handoff status line)
+ // even when it matches none of the counted patterns above.
+ if(End){
+  UINTN From=(End>64)?End-64:0;
+  UINTN N=0;for(;N+1<ExcerptCap&&From+N<End;++N){CHAR8 C=(CHAR8)mPrevBuffer[From+N];Excerpt[N]=(C>=0x20&&C<0x7F)?C:'.';}
+  Excerpt[N]=0;
+ }
  for(UINTN I=0;I+16<End && Excerpt[0]==0;++I){
   if(!CompareMem(mPrevBuffer+I,"Linux version",13)||!CompareMem(mPrevBuffer+I,"Kernel panic",12)){
    UINTN N=0;for(;N+1<ExcerptCap&&I+N<End;++N){CHAR8 C=(CHAR8)mPrevBuffer[I+N];Excerpt[N]=(C>=0x20&&C<0x7F)?C:'.';}
diff --git a/uefi/core/PianoProductCore.c b/uefi/core/PianoProductCore.c
index f98ca02..23b205a 100644
--- a/uefi/core/PianoProductCore.c
+++ b/uefi/core/PianoProductCore.c
@@ -387,8 +387,15 @@ EFI_STATUS EFIAPI PianoProductCoreEntry(EFI_HANDLE Image,EFI_SYSTEM_TABLE *Syste
       if(mOwners.Report.AllowedAction==PianoUsbServiceActionBoot){
         CONST PIANO_RAW_LINUX_REPORT *Raw=NULL;
         Status=PianoRawLinuxPrepare(&mOwners,Image,&Raw);
+        DEBUG((DEBUG_WARN,"SUNUEFI_HANDOFF prepare=%r raw=%u\n",Status,Raw!=NULL));
         if(Status==EFI_SUCCESS)Status=PianoLateHandoffArmRaw(&mLateHandoff,Image,Raw);
-        if(Status==EFI_SUCCESS)Status=PianoRawLinuxEnter(Raw);
+        DEBUG((DEBUG_WARN,"SUNUEFI_HANDOFF arm=%r\n",Status));
+        if(Status==EFI_SUCCESS){
+          DEBUG((DEBUG_WARN,"SUNUEFI_HANDOFF enter kernel=%lx dtb=%lx initrd=%lx bytes=%lu\n",
+            Raw->Kernel,Raw->Dtb,Raw->Initrd,Raw->InitrdBytes));
+          Status=PianoRawLinuxEnter(Raw);
+        }
+        DEBUG((DEBUG_WARN,"SUNUEFI_HANDOFF enter_returned=%r\n",Status));
         FailStop(Status==EFI_SUCCESS?EFI_ABORTED:Status);
       }
       FailStop(EFI_UNSUPPORTED);
