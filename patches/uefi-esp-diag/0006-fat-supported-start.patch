上一行 INFOconn 用的是 ConnectController(ESP, [Fat,...], NULL, TRUE)，读到 0x0e
(EFI_NOT_FOUND)。但 CoreConnectSingleController 只在「没有任何驱动连上」时返回
EFI_NOT_FOUND——它给的是聚合结果，看不出是 Supported 拒了还是 Start 半路失败。
（另：DriverImageHandle 是 NULL 结尾的数组，传单个句柄本身也不严谨。）

本行改成直接调 Fat 自己的函数指针，取回各自的返回码：
  INFOfat: <Fat 找到> <ESP 上有 BlockIo> <ESP 上有 DiskIo> <Supported 返回码>
           <Start 返回码> <Start 之后的 SFS 句柄数>
两个函数按核心的调用方式调，只落在这一个句柄上；Start 失败时 Fat 自己会关掉
DiskIo 并清理，成功则文件系统当场出现、不撤销。

这一步把「Fat 从未被连上来」与「Fat 的 Start 跑到某层失败」彻底分开：返回码直接
指出是哪一层（读 BPB 失败 / 不是 FAT / 卷结构被拒 / 分配失败）。
---
 uefi/core/PianoDwc3Device.c | 94 +++++++++++++++++++++----------------
 1 file changed, 53 insertions(+), 41 deletions(-)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index a36ed55..e12fbd8 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -34,6 +34,8 @@ typedef EFI_STATUS (*PIANO_USB_STORAGE_CHECK)(VOID *Context,CONST CHAR8 *Phase,B
 #include <Protocol/DriverBinding.h>
 #include <Protocol/LoadedImage.h>
 #include <Protocol/PartitionInfo.h>
+#include <Protocol/BlockIo.h>
+#include <Protocol/DiskIo.h>
 #define DW 0xA600000U
 // Native UsbfnDwc3Dxe RVAs e988/e9c0 use these exact USB0 QSCRATCH registers.
 #define USB_SESSION_HS 0xF8810U
@@ -352,10 +354,11 @@ STATIC UINT32 DiagHandles(CONST EFI_GUID *G){
  UINT32 R=S==EFI_SUCCESS?(UINT32)C:(S==EFI_NOT_FOUND?0U:0xFFFFFFFFU);
  if(H!=NULL)gBS->FreePool(H);return R;
 }
-STATIC UINT32 DiagDriverMask(UINT32 *Bindings,EFI_HANDLE *FatBinding){
+STATIC UINT32 DiagDriverMask(UINT32 *Bindings,EFI_HANDLE *FatBinding,EFI_DRIVER_BINDING_PROTOCOL **FatDb){
  EFI_HANDLE *H=NULL;UINTN C=0;UINT32 Mask=0;
  if(Bindings!=NULL)*Bindings=0;
  if(FatBinding!=NULL)*FatBinding=NULL;
+ if(FatDb!=NULL)*FatDb=NULL;
  if(gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagDriverBindingGuid,NULL,&C,&H)!=EFI_SUCCESS||H==NULL)return 0;
  if(Bindings!=NULL)*Bindings=(UINT32)C;
  for(UINTN I=0;I<C;++I){
@@ -370,43 +373,49 @@ STATIC UINT32 DiagDriverMask(UINT32 *Bindings,EFI_HANDLE *FatBinding){
    Last=B;LastLen=L;B+=L;
   }
   if(Last==NULL||LastLen<20)continue;
-  if(!CompareMem(Last+4,&mDiagFatFvGuid,16)){Mask|=BIT0;if(FatBinding!=NULL)*FatBinding=H[I];}
+  if(!CompareMem(Last+4,&mDiagFatFvGuid,16)){Mask|=BIT0;if(FatBinding!=NULL)*FatBinding=H[I];if(FatDb!=NULL)*FatDb=Db;}
   else if(!CompareMem(Last+4,&mDiagDiskIoFvGuid,16))Mask|=BIT1;
   else if(!CompareMem(Last+4,&mDiagPartitionFvGuid,16))Mask|=BIT2;
   else if(!CompareMem(Last+4,&mDiagEnglishFvGuid,16))Mask|=BIT3;
  }
  gBS->FreePool(H);return Mask;
 }
-// Ask Fat itself to bind the ESP partition and report what it answered. Fat is
-// in the DriverBinding set and FatDriverBindingSupported opens only DiskIo and
-// BlockIo, both present on all 141 handles, yet the system holds zero
-// SimpleFileSystem handles. This one ConnectController separates "no driver ever
-// bound this handle" from "Fat start ran and failed", and it is the only handle
-// connected: binding every partition allocates driver state per handle and has
-// already exhausted the DXE pool on this firmware. On success the volume appears
-// and nothing is undone, so the ESP load can be retried in the same boot.
-STATIC UINT32 DiagBindEsp(EFI_HANDLE FatBinding,UINT32 *EspFound,UINT32 *EspNamed,
-                          UINT32 *SfsBefore,UINT32 *SfsAfter){
+// The ESP partition this firmware boots from, found by partition type and
+// preferred by name. Every partition child carries PartitionInfo, so this needs
+// no SimpleFileSystem handle and works while the system still has none.
+STATIC EFI_HANDLE DiagEspHandle(UINT32 *Found,UINT32 *Named){
  STATIC CONST CHAR16 EspName[]=L"sunuefi_esp";
- EFI_HANDLE *H=NULL;UINTN C=0;EFI_HANDLE FirstEsp=NULL,NamedEsp=NULL;UINT32 Result=0xFFFFFFFFU;
- if(EspFound!=NULL)*EspFound=0;
- if(EspNamed!=NULL)*EspNamed=0;
- if(SfsBefore!=NULL)*SfsBefore=DiagHandles(&mDiagSfsGuid);
- if(FatBinding!=NULL && gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagPartitionInfoGuid,NULL,&C,&H)==EFI_SUCCESS && H!=NULL){
-  for(UINTN I=0;I<C;++I){
-   EFI_PARTITION_INFO_PROTOCOL *P=NULL;
-   if(gBS->HandleProtocol(H[I],(EFI_GUID *)&mDiagPartitionInfoGuid,(VOID **)&P)!=EFI_SUCCESS||P==NULL)continue;
-   if(P->Revision<EFI_PARTITION_INFO_PROTOCOL_REVISION||P->Type!=PARTITION_TYPE_GPT||!CompareGuid(&P->Info.Gpt.PartitionTypeGUID,&mDiagEspTypeGuid))continue;
-   if(EspFound!=NULL)*EspFound+=1;
-   if(FirstEsp==NULL)FirstEsp=H[I];
-   if(NamedEsp==NULL && !CompareMem(P->Info.Gpt.PartitionName,EspName,sizeof(EspName))){NamedEsp=H[I];if(EspNamed!=NULL)*EspNamed=1;}
-  }
-  if(NamedEsp!=NULL)Result=(UINT32)gBS->ConnectController(NamedEsp,FatBinding,NULL,TRUE);
-  else if(FirstEsp!=NULL)Result=(UINT32)gBS->ConnectController(FirstEsp,FatBinding,NULL,TRUE);
-  gBS->FreePool(H);
+ EFI_HANDLE *H=NULL;UINTN C=0;EFI_HANDLE First=NULL,Match=NULL;
+ if(Found!=NULL)*Found=0;
+ if(Named!=NULL)*Named=0;
+ if(gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagPartitionInfoGuid,NULL,&C,&H)!=EFI_SUCCESS||H==NULL)return NULL;
+ for(UINTN I=0;I<C;++I){
+  EFI_PARTITION_INFO_PROTOCOL *P=NULL;
+  if(gBS->HandleProtocol(H[I],(EFI_GUID *)&mDiagPartitionInfoGuid,(VOID **)&P)!=EFI_SUCCESS||P==NULL)continue;
+  if(P->Revision<EFI_PARTITION_INFO_PROTOCOL_REVISION||P->Type!=PARTITION_TYPE_GPT||!CompareGuid(&P->Info.Gpt.PartitionTypeGUID,&mDiagEspTypeGuid))continue;
+  if(Found!=NULL)*Found+=1;
+  if(First==NULL)First=H[I];
+  if(Match==NULL && !CompareMem(P->Info.Gpt.PartitionName,EspName,sizeof(EspName))){Match=H[I];if(Named!=NULL)*Named=1;}
  }
- if(SfsAfter!=NULL)*SfsAfter=DiagHandles(&mDiagSfsGuid);
- return Result;
+ gBS->FreePool(H);
+ return Match!=NULL?Match:First;
+}
+// ConnectController answers only in aggregate, so ask Fat directly: its own
+// Supported and Start return the layer that refuses the volume. Both are called
+// exactly as the core would call them, on the ESP partition handle alone.
+STATIC VOID DiagFatOnEsp(EFI_DRIVER_BINDING_PROTOCOL *FatDb,EFI_HANDLE Esp,
+                         UINT32 *HasBlockIo,UINT32 *HasDiskIo,UINT32 *Supported,EFI_STATUS *Start){
+ EFI_BLOCK_IO_PROTOCOL *B=NULL;EFI_DISK_IO_PROTOCOL *D=NULL;
+ if(HasBlockIo!=NULL)*HasBlockIo=0;
+ if(HasDiskIo!=NULL)*HasDiskIo=0;
+ if(Supported!=NULL)*Supported=0xFFFFFFFFU;
+ if(Start!=NULL)*Start=(EFI_STATUS)0xFFFFFFFFU;
+ if(Esp==NULL||FatDb==NULL)return;
+ if(HasBlockIo!=NULL)*HasBlockIo=(gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagBlockIoGuid,(VOID **)&B)==EFI_SUCCESS&&B!=NULL)?1U:0U;
+ if(HasDiskIo!=NULL)*HasDiskIo=(gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagDiskIoGuid,(VOID **)&D)==EFI_SUCCESS&&D!=NULL)?1U:0U;
+ EFI_STATUS S=FatDb->Supported(FatDb,Esp,NULL);
+ if(Supported!=NULL)*Supported=(UINT32)S;
+ if(!EFI_ERROR(S) && Start!=NULL)*Start=FatDb->Start(FatDb,Esp,NULL);
 }
 UINT32 PianoEspDiagEspNameStep(VOID);
 UINT32 PianoEspDiagEspNameSeen(VOID);
@@ -493,8 +502,8 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
     // this reply has to stay well inside the queue or the host reads nothing.
     CHAR8 Row[96];
     EFI_STATUS S;
-    UINT32 Bindings=0;EFI_HANDLE FatBinding=NULL;
-    UINT32 Mask=DiagDriverMask(&Bindings,&FatBinding);
+    UINT32 Bindings=0;EFI_HANDLE FatBinding=NULL;EFI_DRIVER_BINDING_PROTOCOL *FatDb=NULL;
+    UINT32 Mask=DiagDriverMask(&Bindings,&FatBinding,&FatDb);
     {CHAR8 *P=Row;CopyMem(P,"INFOprov:",9);P+=9;
      P=EspHex(P,DiagHandles(&mDiagBlockIoGuid));
      P=EspHex(P,DiagHandles(&mDiagDiskIoGuid));
@@ -508,15 +517,18 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
     // already prove they ran, so they must appear here.
     {CHAR8 *P=Row;CopyMem(P,"INFOdrv:",8);P+=8;P=EspHex(P,Mask);*P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    {UINT32 EspFound=0,EspNamed=0,SfsBefore=0,SfsAfter=0;
-     UINT32 Conn=DiagBindEsp(FatBinding,&EspFound,&EspNamed,&SfsBefore,&SfsAfter);
-     CHAR8 *P=Row;CopyMem(P,"INFOconn:",9);P+=9;
-     P=EspHex(P,FatBinding!=NULL?1U:0U);
-     P=EspHex(P,EspFound);
-     P=EspHex(P,EspNamed);
-     P=EspHex(P,Conn);
-     P=EspHex(P,SfsBefore);
-     P=EspHex(P,SfsAfter);
+    // INFOfat: <Fat 找到> <ESP 上 BlockIo> <ESP 上 DiskIo> <Supported 返回码>
+    //          <Start 返回码> <Start 之后的 SFS 句柄数>。0xffffffff 表示没到那一步。
+    {UINT32 EspFound=0,EspNamed=0,HasBlockIo=0,HasDiskIo=0,Sup=0;EFI_STATUS Start=(EFI_STATUS)0xFFFFFFFFU;
+     EFI_HANDLE Esp=DiagEspHandle(&EspFound,&EspNamed);
+     DiagFatOnEsp(FatDb,Esp,&HasBlockIo,&HasDiskIo,&Sup,&Start);
+     CHAR8 *P=Row;CopyMem(P,"INFOfat:",8);P+=8;
+     P=EspHex(P,FatDb!=NULL?1U:0U);
+     P=EspHex(P,HasBlockIo);
+     P=EspHex(P,HasDiskIo);
+     P=EspHex(P,Sup);
+     P=EspHex(P,(UINT32)Start);
+     P=EspHex(P,DiagHandles(&mDiagSfsGuid));
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     {CHAR8 *P=Row;CopyMem(P,"INFOesp1:",9);P+=9;
