实测链：ESP 经 DiskIo 读得到正确卷头、BlockSize=4096、Fat 的 Supported 通过，但 Start
返回 0x03 (EFI_UNSUPPORTED)。而该版本 EDK2 的 GetEfiGlobalVariable2 不做 ASCII 转换，
直接把 PlatformLang 的原始字节当语言串；本机这个变量存的是字节串 zh-CN（不是 UTF-16）。
改写它需要 NV 属性（易失写入被拒，实测 0x02 EFI_INVALID_PARAMETER），而本固件的存储策略
是非持久写，所以改走不改存储的路。

本提交把现有 UnicodeCollation2 实例的函数指针原样复制一份，只把 SupportedLanguages 换成
"en-US;en;zh-CN;zh;fr-FR;fr"，装成一个新句柄。Fat 的 worker 会遍历句柄、遇到语言匹配的
就用它，因此若 Start 随之变成 0 且 SFS 出现，语言这条即被证实；否则语言这条被排除。

INFOcoll: <装实例的状态> <再问一次 Fat 的 Start> <之后 SFS 数>。不写变量、不写存储。
---
 uefi/core/PianoDwc3Device.c | 34 ++++++++++++++++++++++++++++------
 1 file changed, 28 insertions(+), 6 deletions(-)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index a77ab74..d7aac37 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -436,6 +436,29 @@ STATIC UINT32 DiagReadBpb(EFI_HANDLE Esp,EFI_DISK_IO_PROTOCOL **DiskIo,CHAR8 *He
  if(!EFI_ERROR(S))for(UINTN I=0;I<4;++I){Hex[I*2]=Digits[(Buffer[I]>>4)&15];Hex[I*2+1]=Digits[Buffer[I]&15];}
  return (UINT32)S;
 }
+// FatDriverBindingStart refuses the whole volume when no UnicodeCollation2
+// instance matches the platform language it reads, and this firmware cannot
+// rewrite that variable (it already exists with NV attributes). Publishing one
+// more instance whose language list always contains a match reuses the existing
+// instance functions verbatim and writes nothing to any store. The struct must
+// outlive this call, so it lives at file scope.
+STATIC EFI_UNICODE_COLLATION_PROTOCOL mDiagCollation;
+STATIC EFI_HANDLE mDiagCollationHandle;
+STATIC UINT32 DiagAddCollation(VOID){
+ EFI_HANDLE *H=NULL;UINTN C=0;UINT32 Result=0xFFFFFFFFU;
+ if(mDiagCollationHandle!=NULL)return 0;
+ if(gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagCollation2Guid,NULL,&C,&H)!=EFI_SUCCESS||H==NULL)return Result;
+ for(UINTN I=0;I<C;++I){
+  EFI_UNICODE_COLLATION_PROTOCOL *U=NULL;
+  if(gBS->HandleProtocol(H[I],(EFI_GUID *)&mDiagCollation2Guid,(VOID **)&U)!=EFI_SUCCESS||U==NULL||U->SupportedLanguages==NULL)continue;
+  CopyMem(&mDiagCollation,U,sizeof(mDiagCollation));
+  mDiagCollation.SupportedLanguages="en-US;en;zh-CN;zh;fr-FR;fr";
+  Result=(UINT32)gBS->InstallMultipleProtocolInterfaces(&mDiagCollationHandle,(EFI_GUID *)&mDiagCollation2Guid,&mDiagCollation,NULL);
+  break;
+ }
+ gBS->FreePool(H);
+ return Result;
+}
 // Fat reads sizeof(FAT_BOOT_SECTOR) from offset 0 and then decides on these
 // fields alone. Reading them here through the same DiskIo protocol shows what
 // Fat actually sees, instead of what the partition image says it should see.
@@ -616,14 +639,13 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      for(UINTN I=5;I<10;++I)P=EspHex(P,F[I]);
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    // INFOlang2: <SetVariable 状态> <再问一次 Fat 的 Start> <之后 SFS 数>。
-    // PlatformLang is written volatile only: no device write, no NV variable.
-    {UINT32 SetStatus=(UINT32)gRT->SetVariable(L"PlatformLang",(EFI_GUID *)&mDiagGlobalVariableGuid,
-       EFI_VARIABLE_BOOTSERVICE_ACCESS|EFI_VARIABLE_RUNTIME_ACCESS,sizeof(L"en-US"),(VOID *)L"en-US");
+    // INFOcoll: <装语言实例的状态> <再问一次 Fat 的 Start> <之后 SFS 数>。
+    // No variable and no storage is written; only one protocol instance is added.
+    {UINT32 CollStatus=DiagAddCollation();
      UINT32 HasBlockIo=0,HasDiskIo=0,Sup=0;EFI_STATUS Start=(EFI_STATUS)0xFFFFFFFFU;
      DiagFatOnEsp(FatDb,Esp,&HasBlockIo,&HasDiskIo,&Sup,&Start);
-     CHAR8 *P=Row;CopyMem(P,"INFOlang2:",10);P+=10;
-     P=EspHex(P,SetStatus);
+     CHAR8 *P=Row;CopyMem(P,"INFOcoll:",9);P+=9;
+     P=EspHex(P,CollStatus);
      P=EspHex(P,(UINT32)Start);
      P=EspHex(P,DiagHandles(&mDiagSfsGuid));
      *P=0;
