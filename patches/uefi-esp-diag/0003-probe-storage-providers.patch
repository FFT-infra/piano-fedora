Subject: [PATCH] =?UTF-8?q?diag(uefi):=20=E5=AD=98=E5=82=A8=E6=8F=90?=
 =?UTF-8?q?=E4=BE=9B=E8=80=85=E6=8E=A2=E9=92=88=E6=94=B9=E4=B8=BA=E4=B8=89?=
 =?UTF-8?q?=E5=B8=A7=E6=89=93=E5=8C=85?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

实机发现：DWC3 的响应队列 FB_QUEUE_FRAMES=16（PianoDwc3Device.c:85），而 oem status
每一行占一帧。前几版把诊断拆成 17/24 行，超出队列后 FastbootSend 返回
EFI_OUT_OF_RESOURCES，前 16 帧排着队没人读走，BulkOut 又拒绝在有帧未清空时接收新命令
（:452），于是整个服务卡死——这解释了 round 3 两次和本探针一次的全部现象，
与 TPL 和调用位置无关。

现在把 status/stage/volstep/name/type/parent/calls 与 13 个提供者计数压成三行
（各 65/65/57 字节），运行时共 9 帧。Row 缓冲从 60 扩到 96。语义不变，只读。
---
 uefi/components/os-boot/PianoEspBootSource.c | 60 ++++++++++++++++++++
 uefi/core/PianoDwc3Device.c                  | 59 ++++++++++++++-----
 2 files changed, 104 insertions(+), 15 deletions(-)

diff --git a/uefi/components/os-boot/PianoEspBootSource.c b/uefi/components/os-boot/PianoEspBootSource.c
index 61a6cfd..e18d49f 100644
--- a/uefi/components/os-boot/PianoEspBootSource.c
+++ b/uefi/components/os-boot/PianoEspBootSource.c
@@ -25,12 +25,71 @@ typedef struct {
 // "no such volume" apart from "volume found but one identity field differs".
 // Nothing in the loader consults these values; they never change a decision.
 STATIC UINT32 mDiagEspTypeCount,mDiagEspNameStep,mDiagEspNameSeen,mDiagParentMatches,mDiagVolumeCalls;
+// GUID values carried locally: this module's INF does not declare these two protocols.
+STATIC CONST EFI_GUID mDiagDiskIoGuid={0xCE345171,0xBA0B,0x11D2,{0x8E,0x4F,0x00,0xA0,0xC9,0x69,0x72,0x3B}};
+STATIC CONST EFI_GUID mDiagDriverBindingGuid={0x18A031AB,0xB443,0x4D1A,{0xA5,0xC0,0x0C,0x09,0x26,0x1E,0x9F,0x71}};
+STATIC UINT32 mDiagBlk,mDiagDiskIo,mDiagDiskIoAfter,mDiagSfs,mDiagSfsAfter,mDiagDrvBind;
+STATIC UINT32 mDiagConnOk,mDiagConnNf,mDiagConnOther,mDiagEspLun,mDiagEspHits,mDiagEspLunSeen,mDiagConnRuns;
+STATIC UINT32 DiagCount(CONST EFI_GUID *G){
+ EFI_HANDLE *H=NULL;UINTN C=0;EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)G,NULL,&C,&H);
+ UINT32 R=S==EFI_SUCCESS?(UINT32)C:(S==EFI_NOT_FOUND?0U:0xFFFFFFFFU);
+ if(H!=NULL)gBS->FreePool(H);return R;
+}
+UINT32 PianoEspDiagBlk(VOID){return mDiagBlk;}
+UINT32 PianoEspDiagDiskIo(VOID){return mDiagDiskIo;}
+UINT32 PianoEspDiagDiskIoAfter(VOID){return mDiagDiskIoAfter;}
+UINT32 PianoEspDiagSfs(VOID){return mDiagSfs;}
+UINT32 PianoEspDiagSfsAfter(VOID){return mDiagSfsAfter;}
+UINT32 PianoEspDiagDrvBind(VOID){return mDiagDrvBind;}
+UINT32 PianoEspDiagConnOk(VOID){return mDiagConnOk;}
+UINT32 PianoEspDiagConnNf(VOID){return mDiagConnNf;}
+UINT32 PianoEspDiagConnOther(VOID){return mDiagConnOther;}
+UINT32 PianoEspDiagEspLun(VOID){return mDiagEspLun;}
+UINT32 PianoEspDiagEspHits(VOID){return mDiagEspHits;}
+UINT32 PianoEspDiagEspLunSeen(VOID){return mDiagEspLunSeen;}
+UINT32 PianoEspDiagConnRuns(VOID){return mDiagConnRuns;}
 UINT32 PianoEspDiagEspTypeCount(VOID){return mDiagEspTypeCount;}
 UINT32 PianoEspDiagEspNameStep(VOID){return mDiagEspNameStep;}
 UINT32 PianoEspDiagEspNameSeen(VOID){return mDiagEspNameSeen;}
 UINT32 PianoEspDiagParentMatches(VOID){return mDiagParentMatches;}
 UINT32 PianoEspDiagVolumeCalls(VOID){return mDiagVolumeCalls;}
 #define ESPFAIL(N) do{if(NameOk)mDiagEspNameStep=(N);return FALSE;}while(0)
+// Read-only storage-provider inventory taken in core context (ordinary TPL).
+STATIC VOID PianoEspProbeProviders(VOID){
+ EFI_HANDLE *H=NULL;UINTN C=0;
+ ++mDiagConnRuns;
+ mDiagBlk=DiagCount(&gEfiBlockIoProtocolGuid);
+ mDiagDiskIo=DiagCount(&mDiagDiskIoGuid);
+ mDiagSfs=DiagCount(&gEfiSimpleFileSystemProtocolGuid);
+ mDiagDrvBind=DiagCount(&mDiagDriverBindingGuid);
+ EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,&gEfiBlockIoProtocolGuid,NULL,&C,&H);
+ if(S!=EFI_SUCCESS || H==NULL)return;
+ if(C>256)C=256;
+ for(UINTN I=0;I<C;++I){
+  EFI_PARTITION_INFO_PROTOCOL *P=NULL;EFI_DEVICE_PATH_PROTOCOL *D=NULL;
+  if(gBS->HandleProtocol(H[I],&gEfiPartitionInfoProtocolGuid,(VOID **)&P)==EFI_SUCCESS && P!=NULL &&
+     P->Type==PARTITION_TYPE_GPT && !CompareMem(P->Info.Gpt.PartitionName,L"sunuefi_esp",72)){
+   ++mDiagEspHits;
+   if(gBS->HandleProtocol(H[I],&gEfiDevicePathProtocolGuid,(VOID **)&D)==EFI_SUCCESS && D!=NULL){
+    UINT8 *B=(UINT8 *)D;
+    for(UINTN N=0;N<8;++N){
+     EFI_DEVICE_PATH_PROTOCOL *Q=(EFI_DEVICE_PATH_PROTOCOL *)B;
+     if(Q->Type==END_DEVICE_PATH_TYPE)break;
+     if(Q->Type==MESSAGING_DEVICE_PATH && Q->SubType==MSG_UFS_DP &&
+        (UINTN)(Q->Length[0]|((UINT16)Q->Length[1]<<8))==sizeof(UFS_DEVICE_PATH)){
+      mDiagEspLun=((UFS_DEVICE_PATH *)Q)->Lun;++mDiagEspLunSeen;break;
+     }
+     B+=(UINTN)(Q->Length[0]|((UINT16)Q->Length[1]<<8));
+    }
+   }
+  }
+  EFI_STATUS Q=gBS->ConnectController(H[I],NULL,NULL,TRUE);
+  if(Q==EFI_SUCCESS)++mDiagConnOk;else if(Q==EFI_NOT_FOUND)++mDiagConnNf;else ++mDiagConnOther;
+ }
+ gBS->FreePool(H);
+ mDiagDiskIoAfter=DiagCount(&mDiagDiskIoGuid);
+ mDiagSfsAfter=DiagCount(&gEfiSimpleFileSystemProtocolGuid);
+}
 STATIC BOOLEAN Node(CONST EFI_DEVICE_PATH_PROTOCOL *P,UINT8 T,UINT8 S,UINTN N){
  return P&&P->Type==T&&P->SubType==S&&(UINTN)(P->Length[0]|((UINT16)P->Length[1]<<8))==N;
 }
@@ -103,6 +162,7 @@ EFI_STATUS PianoEspBootLoad(PIANO_ESP_BOOT_SOURCE *S,CONST PIANO_CPU_INPUT_ENV *
  }
  if(!Cpu->BootServicesAlive(Cpu->Context))return EFI_ABORTED;
  EFI_HANDLE *Handles=NULL,Found=NULL;UINTN Count=0,Matches=0;ESP_IDENTITY Before={0},After;
+ PianoEspProbeProviders();
  EFI_STATUS E=gBS->LocateHandleBuffer(ByProtocol,&gEfiSimpleFileSystemProtocolGuid,NULL,&Count,&Handles);
  if(E!=EFI_SUCCESS)return E;
  if(!Handles||!Count||Count>256){if(Handles)gBS->FreePool(Handles);return EFI_COMPROMISED_DATA;}
diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index a79d4ee..ead02d0 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -310,6 +310,20 @@ UINT32 PianoEspDiagEspNameSeen(VOID);
 UINT32 PianoEspDiagEspTypeCount(VOID);
 UINT32 PianoEspDiagParentMatches(VOID);
 UINT32 PianoEspDiagVolumeCalls(VOID);
+UINT32 PianoEspDiagBlk(VOID);
+UINT32 PianoEspDiagDiskIo(VOID);
+UINT32 PianoEspDiagDiskIoAfter(VOID);
+UINT32 PianoEspDiagSfs(VOID);
+UINT32 PianoEspDiagSfsAfter(VOID);
+UINT32 PianoEspDiagDrvBind(VOID);
+UINT32 PianoEspDiagConnOk(VOID);
+UINT32 PianoEspDiagConnNf(VOID);
+UINT32 PianoEspDiagConnOther(VOID);
+UINT32 PianoEspDiagEspLun(VOID);
+UINT32 PianoEspDiagEspHits(VOID);
+UINT32 PianoEspDiagEspLunSeen(VOID);
+UINT32 PianoEspDiagConnRuns(VOID);
+STATIC CHAR8 *EspHex(CHAR8 *Out,UINT32 V){FastHex(V,Out);return Out+8;}
 STATIC VOID FastHex(UINT32 Value,CHAR8 *Out) {
   STATIC CONST CHAR8 Digits[]="0123456789abcdef";
   for(UINTN I=0;I<8;++I)Out[I]=Digits[(Value>>((7-I)*4))&15];
@@ -385,23 +399,38 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
   if(!AsciiStrCmp(Cmd,"oem status")) {
     CONST CHAR8 *Rows[]={"INFOstorage-policy:no-persistent-writes","INFOtransport:owned-DMA-SMMU-bulk","INFOram-upload:download-or-frozen-log"};
     for(UINTN I=0;I<ARRAY_SIZE(Rows);++I){EFI_STATUS S=FastbootSend(NULL,Rows[I],AsciiStrLen(Rows[I]));if(EFI_ERROR(S))return S;}
-    CHAR8 Row[60]="INFODSTS:";FastHex(Dr(0xC70C),Row+9);
+    // 96 bytes: three packed diagnostic rows are 65 chars each.
+    CHAR8 Row[96]="INFODSTS:";FastHex(Dr(0xC70C),Row+9);
     EFI_STATUS S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
     CopyMem(Row,"INFODCFG:",9);FastHex(Dr(0xC700),Row+9);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-load:",13);FastHex((UINT32)PianoRawLinuxStableLoadStatus(),Row+13);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-stage:",14);FastHex(PianoRawLinuxStableLoadStage(),Row+14);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-volstep:",15);FastHex(PianoEspDiagEspNameStep(),Row+15);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-name:",13);FastHex(PianoEspDiagEspNameSeen(),Row+13);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-type:",13);FastHex(PianoEspDiagEspTypeCount(),Row+13);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-parent:",15);FastHex(PianoEspDiagParentMatches(),Row+15);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-calls:",14);FastHex(PianoEspDiagVolumeCalls(),Row+14);
+    // Diagnostic rows packed into three frames: the DWC3 response queue holds
+    // FB_QUEUE_FRAMES=16 frames and one row per value would overflow it.
+    {CHAR8 *P=Row;CopyMem(P,"INFOesp1:",9);P+=9;
+     P=EspHex(P,(UINT32)PianoRawLinuxStableLoadStatus());
+     P=EspHex(P,PianoRawLinuxStableLoadStage());
+     P=EspHex(P,PianoEspDiagEspNameStep());
+     P=EspHex(P,PianoEspDiagEspNameSeen());
+     P=EspHex(P,PianoEspDiagEspTypeCount());
+     P=EspHex(P,PianoEspDiagParentMatches());
+     P=EspHex(P,PianoEspDiagVolumeCalls());*P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
+    {CHAR8 *P=Row;CopyMem(P,"INFOesp2:",9);P+=9;
+     P=EspHex(P,PianoEspDiagConnRuns());
+     P=EspHex(P,PianoEspDiagBlk());
+     P=EspHex(P,PianoEspDiagDiskIo());
+     P=EspHex(P,PianoEspDiagDiskIoAfter());
+     P=EspHex(P,PianoEspDiagSfs());
+     P=EspHex(P,PianoEspDiagSfsAfter());
+     P=EspHex(P,PianoEspDiagDrvBind());*P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
+    {CHAR8 *P=Row;CopyMem(P,"INFOesp3:",9);P+=9;
+     P=EspHex(P,PianoEspDiagConnOk());
+     P=EspHex(P,PianoEspDiagConnNf());
+     P=EspHex(P,PianoEspDiagConnOther());
+     P=EspHex(P,PianoEspDiagEspLun());
+     P=EspHex(P,PianoEspDiagEspHits());
+     P=EspHex(P,PianoEspDiagEspLunSeen());*P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
     return FastbootSend(NULL,"OKAY",4);
   }
-- 
