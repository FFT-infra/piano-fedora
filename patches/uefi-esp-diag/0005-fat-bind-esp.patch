 #include <Protocol/DevicePath.h>
 #include <Protocol/DriverBinding.h>
 #include <Protocol/LoadedImage.h>
+#include <Protocol/PartitionInfo.h>
 #define DW 0xA600000U
 // Native UsbfnDwc3Dxe RVAs e988/e9c0 use these exact USB0 QSCRATCH registers.
 #define USB_SESSION_HS 0xF8810U
@@ -344,14 +345,17 @@ STATIC CONST EFI_GUID mDiagFatFvGuid={0x961578FE,0xB6B7,0x44C3,{0xAF,0x35,0x6B,0
 STATIC CONST EFI_GUID mDiagDiskIoFvGuid={0x6B38F7B4,0xAD98,0x40E9,{0x90,0x93,0xAC,0xA2,0xB5,0xA2,0x53,0xC4}};
 STATIC CONST EFI_GUID mDiagPartitionFvGuid={0x1FA1F39E,0xFEFF,0x4AAE,{0xBD,0x7B,0x38,0xA0,0x70,0xA3,0xB6,0x09}};
 STATIC CONST EFI_GUID mDiagEnglishFvGuid={0xCD3BAFB6,0x50FB,0x4FE8,{0x8E,0x4E,0xAB,0x74,0xD2,0xC1,0xA6,0x00}};
+STATIC CONST EFI_GUID mDiagPartitionInfoGuid={0x8CF2F62C,0xBC9B,0x4821,{0x80,0x8D,0xEC,0x9E,0xC4,0x21,0xA1,0xA0}};
+STATIC CONST EFI_GUID mDiagEspTypeGuid={0xC12A7328,0xF81F,0x11D2,{0xBA,0x4B,0x00,0xA0,0xC9,0x3E,0xC9,0x3B}};
 STATIC UINT32 DiagHandles(CONST EFI_GUID *G){
  EFI_HANDLE *H=NULL;UINTN C=0;EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)G,NULL,&C,&H);
  UINT32 R=S==EFI_SUCCESS?(UINT32)C:(S==EFI_NOT_FOUND?0U:0xFFFFFFFFU);
  if(H!=NULL)gBS->FreePool(H);return R;
 }
-STATIC UINT32 DiagDriverMask(UINT32 *Bindings){
+STATIC UINT32 DiagDriverMask(UINT32 *Bindings,EFI_HANDLE *FatBinding){
  EFI_HANDLE *H=NULL;UINTN C=0;UINT32 Mask=0;
  if(Bindings!=NULL)*Bindings=0;
+ if(FatBinding!=NULL)*FatBinding=NULL;
  if(gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagDriverBindingGuid,NULL,&C,&H)!=EFI_SUCCESS||H==NULL)return 0;
  if(Bindings!=NULL)*Bindings=(UINT32)C;
  for(UINTN I=0;I<C;++I){
@@ -366,13 +370,44 @@ STATIC UINT32 DiagDriverMask(UINT32 *Bindings){
    Last=B;LastLen=L;B+=L;
   }
   if(Last==NULL||LastLen<20)continue;
-  if(!CompareMem(Last+4,&mDiagFatFvGuid,16))Mask|=BIT0;
+  if(!CompareMem(Last+4,&mDiagFatFvGuid,16)){Mask|=BIT0;if(FatBinding!=NULL)*FatBinding=H[I];}
   else if(!CompareMem(Last+4,&mDiagDiskIoFvGuid,16))Mask|=BIT1;
   else if(!CompareMem(Last+4,&mDiagPartitionFvGuid,16))Mask|=BIT2;
   else if(!CompareMem(Last+4,&mDiagEnglishFvGuid,16))Mask|=BIT3;
  }
  gBS->FreePool(H);return Mask;
 }
+// Ask Fat itself to bind the ESP partition and report what it answered. Fat is
+// in the DriverBinding set and FatDriverBindingSupported opens only DiskIo and
+// BlockIo, both present on all 141 handles, yet the system holds zero
+// SimpleFileSystem handles. This one ConnectController separates "no driver ever
+// bound this handle" from "Fat start ran and failed", and it is the only handle
+// connected: binding every partition allocates driver state per handle and has
+// already exhausted the DXE pool on this firmware. On success the volume appears
+// and nothing is undone, so the ESP load can be retried in the same boot.
+STATIC UINT32 DiagBindEsp(EFI_HANDLE FatBinding,UINT32 *EspFound,UINT32 *EspNamed,
+                          UINT32 *SfsBefore,UINT32 *SfsAfter){
+ STATIC CONST CHAR16 EspName[]=L"sunuefi_esp";
+ EFI_HANDLE *H=NULL;UINTN C=0;EFI_HANDLE FirstEsp=NULL,NamedEsp=NULL;UINT32 Result=0xFFFFFFFFU;
+ if(EspFound!=NULL)*EspFound=0;
+ if(EspNamed!=NULL)*EspNamed=0;
+ if(SfsBefore!=NULL)*SfsBefore=DiagHandles(&mDiagSfsGuid);
+ if(FatBinding!=NULL && gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagPartitionInfoGuid,NULL,&C,&H)==EFI_SUCCESS && H!=NULL){
+  for(UINTN I=0;I<C;++I){
+   EFI_PARTITION_INFO_PROTOCOL *P=NULL;
+   if(gBS->HandleProtocol(H[I],(EFI_GUID *)&mDiagPartitionInfoGuid,(VOID **)&P)!=EFI_SUCCESS||P==NULL)continue;
+   if(P->Revision<EFI_PARTITION_INFO_PROTOCOL_REVISION||P->Type!=PARTITION_TYPE_GPT||!CompareGuid(&P->Info.Gpt.PartitionTypeGUID,&mDiagEspTypeGuid))continue;
+   if(EspFound!=NULL)*EspFound+=1;
+   if(FirstEsp==NULL)FirstEsp=H[I];
+   if(NamedEsp==NULL && !CompareMem(P->Info.Gpt.PartitionName,EspName,sizeof(EspName))){NamedEsp=H[I];if(EspNamed!=NULL)*EspNamed=1;}
+  }
+  if(NamedEsp!=NULL)Result=(UINT32)gBS->ConnectController(NamedEsp,FatBinding,NULL,TRUE);
+  else if(FirstEsp!=NULL)Result=(UINT32)gBS->ConnectController(FirstEsp,FatBinding,NULL,TRUE);
+  gBS->FreePool(H);
+ }
+ if(SfsAfter!=NULL)*SfsAfter=DiagHandles(&mDiagSfsGuid);
+ return Result;
+}
 UINT32 PianoEspDiagEspNameStep(VOID);
 UINT32 PianoEspDiagEspNameSeen(VOID);
 UINT32 PianoEspDiagEspTypeCount(VOID);
@@ -458,7 +493,8 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
     // this reply has to stay well inside the queue or the host reads nothing.
     CHAR8 Row[96];
     EFI_STATUS S;
-    UINT32 Bindings=0;UINT32 Mask=DiagDriverMask(&Bindings);
+    UINT32 Bindings=0;EFI_HANDLE FatBinding=NULL;
+    UINT32 Mask=DiagDriverMask(&Bindings,&FatBinding);
     {CHAR8 *P=Row;CopyMem(P,"INFOprov:",9);P+=9;
      P=EspHex(P,DiagHandles(&mDiagBlockIoGuid));
      P=EspHex(P,DiagHandles(&mDiagDiskIoGuid));
@@ -472,6 +508,17 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
     // already prove they ran, so they must appear here.
     {CHAR8 *P=Row;CopyMem(P,"INFOdrv:",8);P+=8;P=EspHex(P,Mask);*P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
+    {UINT32 EspFound=0,EspNamed=0,SfsBefore=0,SfsAfter=0;
+     UINT32 Conn=DiagBindEsp(FatBinding,&EspFound,&EspNamed,&SfsBefore,&SfsAfter);
+     CHAR8 *P=Row;CopyMem(P,"INFOconn:",9);P+=9;
+     P=EspHex(P,FatBinding!=NULL?1U:0U);
+     P=EspHex(P,EspFound);
+     P=EspHex(P,EspNamed);
+     P=EspHex(P,Conn);
+     P=EspHex(P,SfsBefore);
+     P=EspHex(P,SfsAfter);
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     {CHAR8 *P=Row;CopyMem(P,"INFOesp1:",9);P+=9;
      P=EspHex(P,(UINT32)PianoRawLinuxStableLoadStatus());
      P=EspHex(P,PianoRawLinuxStableLoadStage());
