Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

本机实测：\`PianoEspBootLoad\` 返回 EFI_NOT_FOUND 且 Volume() 一次都没被调用，
UEFI Shell 的启动映射表里只有 blk* 没有 fs*——系统里 0 个 SimpleFileSystem 句柄。

FatDxe 编在固件里（tools/prepare_product.py 的 DISK_MODULES），但本固件只有
PianoUfsProductTransportPublish() 里那一句 ConnectController 会绑定存储驱动，
而它要求 GPT 第 95 项存在产品卷 PianoUEFI Storage。本机盘上没有该分区，
PianoUfsProductVolumeOpen 返回 EFI_NOT_FOUND 并被容忍，于是一次绑定都没发生，
ESP 里的文件再正常也读不到。

改动只落在 ESP 加载这条路径：LocateHandleBuffer(SimpleFileSystem) 取不到句柄时，
先对已发布的块设备句柄补一次 ConnectController，再重试一次枚举。跑在核心上下文
的普通 TPL 上；取不到就照原样返回 EFI_NOT_FOUND，开机路径不受影响。

同时新增 oem status 的三行计数器（esp-conn / esp-connh / esp-sfs0）用来确认
这条修复是否真的执行、绑定了多少个句柄、以及绑定前那次枚举的返回码。
---
 uefi/components/os-boot/PianoEspBootSource.c | 24 ++++++++++++++++++++
 uefi/core/PianoDwc3Device.c                  |  9 ++++++++
 2 files changed, 33 insertions(+)

diff --git a/uefi/components/os-boot/PianoEspBootSource.c b/uefi/components/os-boot/PianoEspBootSource.c
index 61a6cfd..4f6e458 100644
--- a/uefi/components/os-boot/PianoEspBootSource.c
+++ b/uefi/components/os-boot/PianoEspBootSource.c
@@ -25,12 +25,28 @@ typedef struct {
 // "no such volume" apart from "volume found but one identity field differs".
 // Nothing in the loader consults these values; they never change a decision.
 STATIC UINT32 mDiagEspTypeCount,mDiagEspNameStep,mDiagEspNameSeen,mDiagParentMatches,mDiagVolumeCalls;
+STATIC UINT32 mDiagEspConnect,mDiagEspBlkConnect,mDiagEspSfsBefore;
+UINT32 PianoEspDiagConnectRuns(VOID){return mDiagEspConnect;}
+UINT32 PianoEspDiagConnectHandles(VOID){return mDiagEspBlkConnect;}
+UINT32 PianoEspDiagSfsBefore(VOID){return mDiagEspSfsBefore;}
 UINT32 PianoEspDiagEspTypeCount(VOID){return mDiagEspTypeCount;}
 UINT32 PianoEspDiagEspNameStep(VOID){return mDiagEspNameStep;}
 UINT32 PianoEspDiagEspNameSeen(VOID){return mDiagEspNameSeen;}
 UINT32 PianoEspDiagParentMatches(VOID){return mDiagParentMatches;}
 UINT32 PianoEspDiagVolumeCalls(VOID){return mDiagVolumeCalls;}
 #define ESPFAIL(N) do{if(NameOk)mDiagEspNameStep=(N);return FALSE;}while(0)
+// Storage drivers are only bound through the owned product volume elsewhere in
+// this firmware. On a disk without it no FAT driver ever binds, so no
+// SimpleFileSystem volume exists and the fixed ESP can never be opened. Bind
+// the already published block devices once here, on the ESP load path only.
+STATIC VOID PianoEspConnectStorage(VOID){
+ EFI_HANDLE *H=NULL;UINTN C=0;
+ EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,&gEfiBlockIoProtocolGuid,NULL,&C,&H);
+ ++mDiagEspConnect;if(S!=EFI_SUCCESS || H==NULL)return;
+ if(C>256)C=256;mDiagEspBlkConnect=(UINT32)C;
+ for(UINTN I=0;I<C;++I)(VOID)gBS->ConnectController(H[I],NULL,NULL,TRUE);
+ gBS->FreePool(H);
+}
 STATIC BOOLEAN Node(CONST EFI_DEVICE_PATH_PROTOCOL *P,UINT8 T,UINT8 S,UINTN N){
  return P&&P->Type==T&&P->SubType==S&&(UINTN)(P->Length[0]|((UINT16)P->Length[1]<<8))==N;
 }
@@ -104,6 +120,14 @@ EFI_STATUS PianoEspBootLoad(PIANO_ESP_BOOT_SOURCE *S,CONST PIANO_CPU_INPUT_ENV *
  if(!Cpu->BootServicesAlive(Cpu->Context))return EFI_ABORTED;
  EFI_HANDLE *Handles=NULL,Found=NULL;UINTN Count=0,Matches=0;ESP_IDENTITY Before={0},After;
  EFI_STATUS E=gBS->LocateHandleBuffer(ByProtocol,&gEfiSimpleFileSystemProtocolGuid,NULL,&Count,&Handles);
+ if(E!=EFI_SUCCESS || Handles==NULL || !Count) {
+   mDiagEspSfsBefore=(E==EFI_SUCCESS)?0U:(UINT32)E;
+   if(Handles!=NULL)gBS->FreePool(Handles);
+   Handles=NULL;Count=0;
+   PianoEspConnectStorage();
+   E=gBS->LocateHandleBuffer(ByProtocol,&gEfiSimpleFileSystemProtocolGuid,NULL,&Count,&Handles);
+   if(E==EFI_SUCCESS && (Handles==NULL || !Count))return EFI_NOT_FOUND;
+ }
  if(E!=EFI_SUCCESS)return E;
  if(!Handles||!Count||Count>256){if(Handles)gBS->FreePool(Handles);return EFI_COMPROMISED_DATA;}
  for(UINTN I=0;I<Count;++I){ESP_IDENTITY Candidate;if(Volume(Handles[I],&Candidate)){Found=Handles[I];Before=Candidate;++Matches;}}
diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index a79d4ee..cf47c46 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -310,6 +310,9 @@ UINT32 PianoEspDiagEspNameSeen(VOID);
 UINT32 PianoEspDiagEspTypeCount(VOID);
 UINT32 PianoEspDiagParentMatches(VOID);
 UINT32 PianoEspDiagVolumeCalls(VOID);
+UINT32 PianoEspDiagConnectRuns(VOID);
+UINT32 PianoEspDiagConnectHandles(VOID);
+UINT32 PianoEspDiagSfsBefore(VOID);
 STATIC VOID FastHex(UINT32 Value,CHAR8 *Out) {
   STATIC CONST CHAR8 Digits[]="0123456789abcdef";
   for(UINTN I=0;I<8;++I)Out[I]=Digits[(Value>>((7-I)*4))&15];
@@ -403,6 +406,12 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
     CopyMem(Row,"INFOesp-calls:",14);FastHex(PianoEspDiagVolumeCalls(),Row+14);
     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOesp-conn:",13);FastHex(PianoEspDiagConnectRuns(),Row+13);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOesp-connh:",14);FastHex(PianoEspDiagConnectHandles(),Row+14);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOesp-sfs0:",13);FastHex(PianoEspDiagSfsBefore(),Row+13);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
     return FastbootSend(NULL,"OKAY",4);
   }
   return EFI_UNSUPPORTED;
