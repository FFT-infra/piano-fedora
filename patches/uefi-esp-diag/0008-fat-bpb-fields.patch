 =?UTF-8?q?=E6=AE=B5=EF=BC=8C=E5=B9=B6=E5=9C=A8=E4=BF=AE=E5=A5=BD=20Platfo?=
 =?UTF-8?q?rmLang=20=E5=90=8E=E9=87=8D=E9=97=AE=E4=B8=80=E6=AC=A1=20Fat?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

实测：ESP 经 DiskIo 读回的头 4 字节是 eb58906d（mkfs.fat 卷头），BlockSize=4096，
Supported=0，Start=0x03 (EFI_UNSUPPORTED)，SFS 仍是 0。Fat 早期返回 UNSUPPORTED 的三处
输入里，块大小与读路径都已实测通过，剩下语言匹配——而 lang 行读到 PlatformLang 变量存的
是字节串而不是 UTF-16（打印成 ??N，对应 ascii 的 zh-CN）。

本提交做两件事：
1. INFObpb/INFObpb2 按 EDK2 的 FAT_BOOT_SECTOR 字段布局，把 Fat 自己会读的那 512 字节
   里的 SectorSize/SectorsPerCluster/ReservedSectors/NumFats/Sectors16/Media/
   SectorsPerFat16/LargeSectorsPerFat/ExtFlags/FsVersion 逐个打出来——不再靠离线镜像推断
   Fat 看到什么。
2. INFOlang2 把 PlatformLang 写成合法的 UTF-16 "en-US"（**只写易失变量，不写 NV、
   不碰设备存储**），然后重新调用 Fat 的 Supported/Start，报回状态与之后的 SFS 数。
   若 Start 就此变 0 且 SFS 出现，语言这条即被证实，ESP 当场可读。

同时删掉 esp2..esp4 三行旧探针计数（那批 ConnectController 代码已不在固件里），
回复维持 12 帧。
---
 uefi/core/PianoDwc3Device.c | 87 ++++++++++++++++++++++++-------------
 1 file changed, 56 insertions(+), 31 deletions(-)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index df4d6c9..a77ab74 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -436,6 +436,31 @@ STATIC UINT32 DiagReadBpb(EFI_HANDLE Esp,EFI_DISK_IO_PROTOCOL **DiskIo,CHAR8 *He
  if(!EFI_ERROR(S))for(UINTN I=0;I<4;++I){Hex[I*2]=Digits[(Buffer[I]>>4)&15];Hex[I*2+1]=Digits[Buffer[I]&15];}
  return (UINT32)S;
 }
+// Fat reads sizeof(FAT_BOOT_SECTOR) from offset 0 and then decides on these
+// fields alone. Reading them here through the same DiskIo protocol shows what
+// Fat actually sees, instead of what the partition image says it should see.
+STATIC UINT32 DiagBpbFields(EFI_HANDLE Esp,UINT32 *Fields,UINTN Count){
+ EFI_DISK_IO_PROTOCOL *D=NULL;EFI_BLOCK_IO_PROTOCOL *B=NULL;UINT8 Buf[512];
+ for(UINTN I=0;I<Count;++I)Fields[I]=0xFFFFFFFFU;
+ if(Esp==NULL||Count<10)return 0xFFFFFFFFU;
+ if(gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagDiskIoGuid,(VOID **)&D)!=EFI_SUCCESS||D==NULL)return 0xFFFFFFFFU;
+ if(gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagBlockIoGuid,(VOID **)&B)!=EFI_SUCCESS||B==NULL||B->Media==NULL)return 0xFFFFFFFFU;
+ ZeroMem(Buf,sizeof(Buf));
+ EFI_STATUS S=D->ReadDisk(D,B->Media->MediaId,0,sizeof(Buf),Buf);
+ if(!EFI_ERROR(S)){
+  Fields[0]=(UINT32)(Buf[0x0B]|((UINT16)Buf[0x0C]<<8));
+  Fields[1]=(UINT32)Buf[0x0D];
+  Fields[2]=(UINT32)(Buf[0x0E]|((UINT16)Buf[0x0F]<<8));
+  Fields[3]=(UINT32)Buf[0x10];
+  Fields[4]=(UINT32)(Buf[0x13]|((UINT16)Buf[0x14]<<8));
+  Fields[5]=(UINT32)Buf[0x15];
+  Fields[6]=(UINT32)(Buf[0x16]|((UINT16)Buf[0x17]<<8));
+  Fields[7]=(UINT32)(Buf[0x20]|((UINT32)Buf[0x21]<<8)|((UINT32)Buf[0x22]<<16)|((UINT32)Buf[0x23]<<24));
+  Fields[8]=(UINT32)(Buf[0x24]|((UINT32)Buf[0x25]<<8)|((UINT32)Buf[0x26]<<16)|((UINT32)Buf[0x27]<<24));
+  Fields[9]=(UINT32)(Buf[0x28]|((UINT16)Buf[0x29]<<8));
+ }
+ return (UINT32)S;
+}
 // The two strings Fat compares when it decides whether UnicodeCollation2 is
 // usable: what the protocol declares and what PlatformLang holds. A mismatch
 // makes FatDriverBindingStart return EFI_UNSUPPORTED before reading any volume.
@@ -536,13 +561,15 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
   if(!AsciiStrCmp(Cmd,"oem status")) {
     CONST CHAR8 *Rows[]={"INFOstorage-policy:no-persistent-writes","INFOtransport:owned-DMA-SMMU-bulk","INFOram-upload:download-or-frozen-log"};
     for(UINTN I=0;I<ARRAY_SIZE(Rows);++I){EFI_STATUS R=FastbootSend(NULL,Rows[I],AsciiStrLen(Rows[I]));if(EFI_ERROR(R))return R;}
-    // Ten frames in total, each at most 64 bytes: DWC3 holds FB_QUEUE_FRAMES=16
+    // Twelve frames in total, each at most 64 bytes: DWC3 holds FB_QUEUE_FRAMES=16
     // response frames and rejects every later command once the queue is full, so
     // this reply has to stay well inside the queue or the host reads nothing.
     CHAR8 Row[96];
     EFI_STATUS S;
     UINT32 Bindings=0;EFI_HANDLE FatBinding=NULL;EFI_DRIVER_BINDING_PROTOCOL *FatDb=NULL;
     UINT32 Mask=DiagDriverMask(&Bindings,&FatBinding,&FatDb);
+    UINT32 EspFound=0,EspNamed=0;
+    EFI_HANDLE Esp=DiagEspHandle(&EspFound,&EspNamed);
     {CHAR8 *P=Row;CopyMem(P,"INFOprov:",9);P+=9;
      P=EspHex(P,DiagHandles(&mDiagBlockIoGuid));
      P=EspHex(P,DiagHandles(&mDiagDiskIoGuid));
@@ -551,15 +578,12 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      P=EspHex(P,Bindings);
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    // bit0 Fat, bit1 DiskIoDxe, bit2 PartitionDxe, bit3 EnglishDxe. The last
-    // three are controls: diskio=141, 135 partition children and collation2=1
-    // already prove they ran, so they must appear here.
+    // bit0 Fat, bit1 DiskIoDxe, bit2 PartitionDxe, bit3 EnglishDxe.
     {CHAR8 *P=Row;CopyMem(P,"INFOdrv:",8);P+=8;P=EspHex(P,Mask);*P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    // INFOesp: <DiskIo 读前 4 字节的状态> <这 4 字节的十六进制> <ESP 的 BlockSize>
-    //          <Fat 找到> <Supported 返回码> <Start 返回码> <之后 SFS 数>
-    {UINT32 EspFound=0,EspNamed=0,HasBlockIo=0,HasDiskIo=0,Sup=0;EFI_STATUS Start=(EFI_STATUS)0xFFFFFFFFU;
-     EFI_HANDLE Esp=DiagEspHandle(&EspFound,&EspNamed);
+    // INFOesp: <DiskIo 读前 4 字节的状态> <这 4 字节 hex> <ESP BlockSize> <Fat 找到>
+    //          <Supported> <Start> <之后 SFS 数>
+    {UINT32 HasBlockIo=0,HasDiskIo=0,Sup=0;EFI_STATUS Start=(EFI_STATUS)0xFFFFFFFFU;
      EFI_BLOCK_IO_PROTOCOL *Eb=NULL;UINT32 BlockBytes=0;
      EFI_DISK_IO_PROTOCOL *Ed=NULL;CHAR8 Hex[9];
      UINT32 ReadStatus=DiagReadBpb(Esp,&Ed,Hex);
@@ -580,6 +604,30 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      CopyMem(P,Lang,AsciiStrLen(Lang));P+=AsciiStrLen(Lang);*P++='|';
      CopyMem(P,Plat,AsciiStrLen(Plat));P+=AsciiStrLen(Plat);*P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
+    // INFObpb / INFObpb2: the fields Fat computes from the 512 bytes it reads.
+    // Order: SectorSize SectorsPerCluster ReservedSectors NumFats Sectors16 |
+    //        Media SectorsPerFat16 LargeSectorsPerFat ExtFlags FsVersion.
+    {UINT32 F[10];UINT32 ReadStatus=DiagBpbFields(Esp,F,10);
+     CHAR8 *P=Row;CopyMem(P,"INFObpb:",8);P+=8;P=EspHex(P,ReadStatus);
+     for(UINTN I=0;I<5;++I)P=EspHex(P,F[I]);
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+     P=Row;CopyMem(P,"INFObpb2:",9);P+=9;
+     for(UINTN I=5;I<10;++I)P=EspHex(P,F[I]);
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
+    // INFOlang2: <SetVariable 状态> <再问一次 Fat 的 Start> <之后 SFS 数>。
+    // PlatformLang is written volatile only: no device write, no NV variable.
+    {UINT32 SetStatus=(UINT32)gRT->SetVariable(L"PlatformLang",(EFI_GUID *)&mDiagGlobalVariableGuid,
+       EFI_VARIABLE_BOOTSERVICE_ACCESS|EFI_VARIABLE_RUNTIME_ACCESS,sizeof(L"en-US"),(VOID *)L"en-US");
+     UINT32 HasBlockIo=0,HasDiskIo=0,Sup=0;EFI_STATUS Start=(EFI_STATUS)0xFFFFFFFFU;
+     DiagFatOnEsp(FatDb,Esp,&HasBlockIo,&HasDiskIo,&Sup,&Start);
+     CHAR8 *P=Row;CopyMem(P,"INFOlang2:",10);P+=10;
+     P=EspHex(P,SetStatus);
+     P=EspHex(P,(UINT32)Start);
+     P=EspHex(P,DiagHandles(&mDiagSfsGuid));
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     {CHAR8 *P=Row;CopyMem(P,"INFOesp1:",9);P+=9;
      P=EspHex(P,(UINT32)PianoRawLinuxStableLoadStatus());
      P=EspHex(P,PianoRawLinuxStableLoadStage());
@@ -589,29 +637,6 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      P=EspHex(P,PianoEspDiagParentMatches());
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    {CHAR8 *P=Row;CopyMem(P,"INFOesp2:",9);P+=9;
-     P=EspHex(P,PianoEspDiagVolumeCalls());
-     P=EspHex(P,PianoEspDiagConnRuns());
-     P=EspHex(P,PianoEspDiagBlk());
-     P=EspHex(P,PianoEspDiagDiskIo());
-     P=EspHex(P,PianoEspDiagDiskIoAfter());
-     P=EspHex(P,PianoEspDiagSfs());
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    {CHAR8 *P=Row;CopyMem(P,"INFOesp3:",9);P+=9;
-     P=EspHex(P,PianoEspDiagSfsAfter());
-     P=EspHex(P,PianoEspDiagDrvBind());
-     P=EspHex(P,PianoEspDiagConnOk());
-     P=EspHex(P,PianoEspDiagConnNf());
-     P=EspHex(P,PianoEspDiagConnOther());
-     P=EspHex(P,PianoEspDiagEspLun());
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    {CHAR8 *P=Row;CopyMem(P,"INFOesp4:",9);P+=9;
-     P=EspHex(P,PianoEspDiagEspHits());
-     P=EspHex(P,PianoEspDiagEspLunSeen());
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     return FastbootSend(NULL,"OKAY",4);
   }
   return EFI_UNSUPPORTED;
