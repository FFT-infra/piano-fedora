第一版在 oem status 的处理函数里直接调 LocateHandleBuffer，实机两次都把服务挂死，
随后核心分配失败并 FailStop 在 MENU（屏幕 EFI_OUT_OF_RESOURCES）。DWC3 Fastboot
服务的回调不在普通 TPL 上，那里不能进协议数据库和内存分配。

本版把采样挪到核心上下文：在已有的 PianoFastbootBlockReadInit() 之后调用一次
（那一处本来就在普通 TPL 上枚举 BlockIo），oem status 只读缓存值，不做任何
BootServices 调用。

用途不变：把"确实没有 SimpleFileSystem 句柄"与"另有失败来源"分开，并顺带
判定产品卷 PianoUEFI Storage 那条线索是真是假。
---
 uefi/core/PianoDwc3Device.c  | 18 ++++++++++++++++++
 uefi/core/PianoProductCore.c | 21 +++++++++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index a79d4ee..16f6283 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -310,6 +310,12 @@ UINT32 PianoEspDiagEspNameSeen(VOID);
 UINT32 PianoEspDiagEspTypeCount(VOID);
 UINT32 PianoEspDiagParentMatches(VOID);
 UINT32 PianoEspDiagVolumeCalls(VOID);
+UINT32 PianoDiagBlockIoCount(VOID);
+UINT32 PianoDiagSfsCount(VOID);
+UINT32 PianoDiagSfsStatus(VOID);
+UINT32 PianoDiagVolumeProvisioned(VOID);
+UINT32 PianoDiagVolumeLastStatus(VOID);
+UINT32 PianoDiagVolumeFirstFailure(VOID);
 STATIC VOID FastHex(UINT32 Value,CHAR8 *Out) {
   STATIC CONST CHAR8 Digits[]="0123456789abcdef";
   for(UINTN I=0;I<8;++I)Out[I]=Digits[(Value>>((7-I)*4))&15];
@@ -403,6 +409,18 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
     CopyMem(Row,"INFOesp-calls:",14);FastHex(PianoEspDiagVolumeCalls(),Row+14);
     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOblk-io:",11);FastHex(PianoDiagBlockIoCount(),Row+11);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOsfs-cnt:",12);FastHex(PianoDiagSfsCount(),Row+12);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOsfs-st:",11);FastHex(PianoDiagSfsStatus(),Row+11);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOvol-prov:",13);FastHex(PianoDiagVolumeProvisioned(),Row+13);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOvol-last:",13);FastHex(PianoDiagVolumeLastStatus(),Row+13);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+    CopyMem(Row,"INFOvol-first:",14);FastHex(PianoDiagVolumeFirstFailure(),Row+14);
+    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
     return FastbootSend(NULL,"OKAY",4);
   }
   return EFI_UNSUPPORTED;
diff --git a/uefi/core/PianoProductCore.c b/uefi/core/PianoProductCore.c
index f98ca02..e003b17 100644
--- a/uefi/core/PianoProductCore.c
+++ b/uefi/core/PianoProductCore.c
@@ -39,6 +39,26 @@ STATIC EFI_STATUS mUfsStatus=EFI_NOT_STARTED;
 STATIC UINT64 mCounterFrequency,mCounterStart,mCounterEnd;
 STATIC PIANO_RAM_PARTITION_REPORT mRamInventory;
 STATIC PIANO_UFS_PRODUCT_VOLUME mProductVolume;
+// Diagnostic only. Storage-provider inventory for oem status. Filled once in
+// core context (ordinary TPL); the fastboot service callback only reads these
+// cached values, because LocateHandleBuffer must not run at the service TPL.
+STATIC UINT32 mDiagBlkCount,mDiagSfsCount,mDiagSfsStatus,mDiagVolProvisioned,mDiagVolLast,mDiagVolFirst;
+STATIC VOID PianoDiagStorageRefresh(VOID){
+ EFI_HANDLE *H=NULL;UINTN C=0;
+ EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,&gEfiBlockIoProtocolGuid,NULL,&C,&H);
+ mDiagBlkCount=S==EFI_SUCCESS?(UINT32)C:(S==EFI_NOT_FOUND?0U:0xFFFFFFFFU);if(H!=NULL)gBS->FreePool(H);
+ H=NULL;C=0;S=gBS->LocateHandleBuffer(ByProtocol,&gEfiSimpleFileSystemProtocolGuid,NULL,&C,&H);
+ mDiagSfsCount=S==EFI_SUCCESS?(UINT32)C:0U;mDiagSfsStatus=(UINT32)S;if(H!=NULL)gBS->FreePool(H);
+ mDiagVolProvisioned=mProductVolume.State.Provisioned?1U:0U;
+ mDiagVolLast=(UINT32)mProductVolume.State.LastStatus;
+ mDiagVolFirst=(UINT32)mProductVolume.State.FirstFailure;
+}
+UINT32 PianoDiagBlockIoCount(VOID){return mDiagBlkCount;}
+UINT32 PianoDiagSfsCount(VOID){return mDiagSfsCount;}
+UINT32 PianoDiagSfsStatus(VOID){return mDiagSfsStatus;}
+UINT32 PianoDiagVolumeProvisioned(VOID){return mDiagVolProvisioned;}
+UINT32 PianoDiagVolumeLastStatus(VOID){return mDiagVolLast;}
+UINT32 PianoDiagVolumeFirstFailure(VOID){return mDiagVolFirst;}
 STATIC PIANO_PRODUCT_DISPLAY_STARTUP_REPORT mDisplayStartup;
 STATIC PIANO_SMMU_RETIRED_USB_PROOF mStartupUsbProof;
 STATIC UINT32 mStartupTarget;
@@ -298,6 +318,7 @@ EFI_STATUS EFIAPI PianoProductCoreEntry(EFI_HANDLE Image,EFI_SYSTEM_TABLE *Syste
     DEBUG((DEBUG_WARN,"PIANO_PRODUCT_STORAGE_FAT_PUBLISHED writable=1 container_headers_excluded=1 nv_slots_private=1\n"));
   } else if(Status!=EFI_NOT_FOUND)FailStop(Status);
   Status=PianoFastbootBlockReadInit();if(Status!=EFI_SUCCESS)FailStop(Status);
+ PianoDiagStorageRefresh();
   CONST PIANO_FB_STORAGE *Storage=PianoFastbootBlockReadStorage();
   if(Storage==NULL || Storage->Ready(Storage->Context)!=EFI_SUCCESS)FailStop(EFI_NOT_READY);
   mCounterFrequency=GetPerformanceCounterProperties(&mCounterStart,&mCounterEnd);
