读到 blockio=141 diskio=141 sfs=0 driverbinding=16 collation2=1：FatDxe 的三个前提
（BlockIo、DiskIo、UnicodeCollation2）全部到位，而 FatDriverBindingSupported 只要求
DiskIo + BlockIo，所以只要 Fat 被派发过，ESP 上就该出现文件系统。剩下的分岔是
「Fat 没被派发」与「Start 走到卷识别才失败」，本行用来把两者分开。

INFOprov: <blockio><diskio><sfs><collation2><driverbinding>，在 oem status 命令时刻现算，
不再依赖 RAM 控制台快照（本机 ramoops 环已不在，oem ramlog 与 EP0 op=1 两条路都读不到）。
INFOdrv:  <mask>，遍历 DriverBinding 句柄、取各自 LoadedImage->FilePath 最后一节的前
16 字节，与四个 FFS GUID 比对：bit0 Fat、bit1 DiskIoDxe、bit2 PartitionDxe、bit3 EnglishDxe，
后三个是对照（diskio=141、135 个分区子设备、collation2=1 已分别证明它们跑过）。最后一节
就是固件卷文件节点，所以不依赖任何 device path subtype 常量。

同时删掉 7 行未打包的 esp-* 重复行和一行重复的 FastbootSend：原来 oem status 要发 17 帧，
超过 DWC3 的 FB_QUEUE_FRAMES=16，第 17 帧返回 EFI_OUT_OF_RESOURCES，OKAY 永远发不出去，
队列占满后 BulkOut 还拒绝后续命令（本机 oem status 与 getvar 同时无响应即此）。现在 10 帧。

只读，不改变任何判断。
---
 uefi/core/PianoDwc3Device.c | 89 ++++++++++++++++++++++++++++---------
 1 file changed, 68 insertions(+), 21 deletions(-)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index 442b683..5e56a9c 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -30,6 +30,9 @@ typedef EFI_STATUS (*PIANO_USB_STORAGE_CHECK)(VOID *Context,CONST CHAR8 *Phase,B
 #include <Library/BaseMemoryLib.h>
 #include <Library/MemoryAllocationLib.h>
 #include <Library/DebugLib.h>
+#include <Protocol/DevicePath.h>
+#include <Protocol/DriverBinding.h>
+#include <Protocol/LoadedImage.h>
 #define DW 0xA600000U
 // Native UsbfnDwc3Dxe RVAs e988/e9c0 use these exact USB0 QSCRATCH registers.
 #define USB_SESSION_HS 0xF8810U
@@ -325,6 +328,51 @@ UINT32 PianoEspDiagEspLunSeen(VOID);
 UINT32 PianoEspDiagConnRuns(VOID);
 STATIC VOID FastHex(UINT32 Value,CHAR8 *Out);
 STATIC CHAR8 *EspHex(CHAR8 *Out,UINT32 V){FastHex(V,Out);return Out+8;}
+// Diagnostic identity of the storage drivers this boot actually dispatched.
+// A driver is running when its image carries a DriverBinding instance, and the
+// last node of that image device path is the firmware-volume file node whose
+// first 16 payload bytes are the module FFS GUID. Comparing those bytes needs
+// no device-path subtype constant. Counted only when oem status asks; no boot
+// path reads these values.
+STATIC CONST EFI_GUID mDiagBlockIoGuid={0x964E5B21,0x6459,0x11D2,{0x8E,0x39,0x00,0xA0,0xC9,0x69,0x72,0x3B}};
+STATIC CONST EFI_GUID mDiagDiskIoGuid={0xCE345171,0xBA0B,0x11D2,{0x8E,0x4F,0x00,0xA0,0xC9,0x69,0x72,0x3B}};
+STATIC CONST EFI_GUID mDiagSfsGuid={0x964E5B22,0x6459,0x11D2,{0x8E,0x39,0x00,0xA0,0xC9,0x69,0x72,0x3B}};
+STATIC CONST EFI_GUID mDiagCollation2Guid={0xA4C751FC,0x23AE,0x4C3E,{0x92,0xE9,0x49,0x64,0xCF,0x63,0xF3,0x49}};
+STATIC CONST EFI_GUID mDiagDriverBindingGuid={0x18A031AB,0xB443,0x4D1A,{0xA5,0xC0,0x0C,0x09,0x26,0x1E,0x9F,0x71}};
+STATIC CONST EFI_GUID mDiagLoadedImageGuid={0x5B1B31A1,0x9562,0x11D2,{0x8E,0x3F,0x00,0xA0,0xC9,0x69,0x72,0x3B}};
+STATIC CONST EFI_GUID mDiagFatFvGuid={0x961578FE,0xB6B7,0x44C3,{0xAF,0x35,0x6B,0xC7,0x05,0xCD,0x2B,0x1F}};
+STATIC CONST EFI_GUID mDiagDiskIoFvGuid={0x6B38F7B4,0xAD98,0x40E9,{0x90,0x93,0xAC,0xA2,0xB5,0xA2,0x53,0xC4}};
+STATIC CONST EFI_GUID mDiagPartitionFvGuid={0x1FA1F39E,0xFEFF,0x4AAE,{0xBD,0x7B,0x38,0xA0,0x70,0xA3,0xB6,0x09}};
+STATIC CONST EFI_GUID mDiagEnglishFvGuid={0xCD3BAFB6,0x50FB,0x4FE8,{0x8E,0x4E,0xAB,0x74,0xD2,0xC1,0xA6,0x00}};
+STATIC UINT32 DiagHandles(CONST EFI_GUID *G){
+ EFI_HANDLE *H=NULL;UINTN C=0;EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)G,NULL,&C,&H);
+ UINT32 R=S==EFI_SUCCESS?(UINT32)C:(S==EFI_NOT_FOUND?0U:0xFFFFFFFFU);
+ if(H!=NULL)gBS->FreePool(H);return R;
+}
+STATIC UINT32 DiagDriverMask(UINT32 *Bindings){
+ EFI_HANDLE *H=NULL;UINTN C=0;UINT32 Mask=0;
+ if(Bindings!=NULL)*Bindings=0;
+ if(gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagDriverBindingGuid,NULL,&C,&H)!=EFI_SUCCESS||H==NULL)return 0;
+ if(Bindings!=NULL)*Bindings=(UINT32)C;
+ for(UINTN I=0;I<C;++I){
+  EFI_DRIVER_BINDING_PROTOCOL *Db=NULL;EFI_LOADED_IMAGE_PROTOCOL *Li=NULL;
+  if(gBS->HandleProtocol(H[I],(EFI_GUID *)&mDiagDriverBindingGuid,(VOID **)&Db)!=EFI_SUCCESS||Db==NULL)continue;
+  if(gBS->HandleProtocol(Db->ImageHandle,(EFI_GUID *)&mDiagLoadedImageGuid,(VOID **)&Li)!=EFI_SUCCESS||Li==NULL||Li->FilePath==NULL)continue;
+  CONST UINT8 *B=(CONST UINT8 *)Li->FilePath,*Last=NULL;UINTN LastLen=0;
+  for(UINTN N=0;N<16;++N){
+   CONST EFI_DEVICE_PATH_PROTOCOL *Q=(CONST EFI_DEVICE_PATH_PROTOCOL *)B;
+   UINTN L=(UINTN)(Q->Length[0]|((UINT16)Q->Length[1]<<8));
+   if(Q->Type==END_DEVICE_PATH_TYPE||L<4)break;
+   Last=B;LastLen=L;B+=L;
+  }
+  if(Last==NULL||LastLen<20)continue;
+  if(!CompareMem(Last+4,&mDiagFatFvGuid,16))Mask|=BIT0;
+  else if(!CompareMem(Last+4,&mDiagDiskIoFvGuid,16))Mask|=BIT1;
+  else if(!CompareMem(Last+4,&mDiagPartitionFvGuid,16))Mask|=BIT2;
+  else if(!CompareMem(Last+4,&mDiagEnglishFvGuid,16))Mask|=BIT3;
+ }
+ gBS->FreePool(H);return Mask;
+}
 UINT32 PianoEspDiagEspNameStep(VOID);
 UINT32 PianoEspDiagEspNameSeen(VOID);
 UINT32 PianoEspDiagEspTypeCount(VOID);
@@ -404,26 +452,26 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
 #endif
   if(!AsciiStrCmp(Cmd,"oem status")) {
     CONST CHAR8 *Rows[]={"INFOstorage-policy:no-persistent-writes","INFOtransport:owned-DMA-SMMU-bulk","INFOram-upload:download-or-frozen-log"};
-    for(UINTN I=0;I<ARRAY_SIZE(Rows);++I){EFI_STATUS S=FastbootSend(NULL,Rows[I],AsciiStrLen(Rows[I]));if(EFI_ERROR(S))return S;}
-    CHAR8 Row[96]="INFODSTS:";FastHex(Dr(0xC70C),Row+9);
-    EFI_STATUS S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFODCFG:",9);FastHex(Dr(0xC700),Row+9);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-load:",13);FastHex((UINT32)PianoRawLinuxStableLoadStatus(),Row+13);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-stage:",14);FastHex(PianoRawLinuxStableLoadStage(),Row+14);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-volstep:",15);FastHex(PianoEspDiagEspNameStep(),Row+15);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-name:",13);FastHex(PianoEspDiagEspNameSeen(),Row+13);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-type:",13);FastHex(PianoEspDiagEspTypeCount(),Row+13);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-parent:",15);FastHex(PianoEspDiagParentMatches(),Row+15);
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-    CopyMem(Row,"INFOesp-calls:",14);FastHex(PianoEspDiagVolumeCalls(),Row+14);
-    // Four packed rows of at most 64 bytes: DWC3 holds FB_QUEUE_FRAMES=16 frames
-    // and a fastboot response packet is 64 bytes.
+    for(UINTN I=0;I<ARRAY_SIZE(Rows);++I){EFI_STATUS R=FastbootSend(NULL,Rows[I],AsciiStrLen(Rows[I]));if(EFI_ERROR(R))return R;}
+    // Ten frames in total, each at most 64 bytes: DWC3 holds FB_QUEUE_FRAMES=16
+    // response frames and rejects every later command once the queue is full, so
+    // this reply has to stay well inside the queue or the host reads nothing.
+    CHAR8 Row[96];
+    EFI_STATUS S;
+    UINT32 Bindings=0;UINT32 Mask=DiagDriverMask(&Bindings);
+    {CHAR8 *P=Row;CopyMem(P,"INFOprov:",9);P+=9;
+     P=EspHex(P,DiagHandles(&mDiagBlockIoGuid));
+     P=EspHex(P,DiagHandles(&mDiagDiskIoGuid));
+     P=EspHex(P,DiagHandles(&mDiagSfsGuid));
+     P=EspHex(P,DiagHandles(&mDiagCollation2Guid));
+     P=EspHex(P,Bindings);
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
+    // bit0 Fat, bit1 DiskIoDxe, bit2 PartitionDxe, bit3 EnglishDxe. The last
+    // three are controls: diskio=141, 135 partition children and collation2=1
+    // already prove they ran, so they must appear here.
+    {CHAR8 *P=Row;CopyMem(P,"INFOdrv:",8);P+=8;P=EspHex(P,Mask);*P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     {CHAR8 *P=Row;CopyMem(P,"INFOesp1:",9);P+=9;
      P=EspHex(P,(UINT32)PianoRawLinuxStableLoadStatus());
      P=EspHex(P,PianoRawLinuxStableLoadStage());
@@ -456,7 +504,6 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      P=EspHex(P,PianoEspDiagEspLunSeen());
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
     return FastbootSend(NULL,"OKAY",4);
   }
   return EFI_UNSUPPORTED;
-- 
