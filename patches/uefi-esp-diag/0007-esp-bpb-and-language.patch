上一行读到 Supported=0、Start=0x03 (EFI_UNSUPPORTED)。把 FatDriverBindingStart 与
FatOpenDevice 的源码逐条对过，能在读卷之前返回 EFI_UNSUPPORTED 的只有三处：语言匹配
（InitializeUnicodeCollationSupport）、BlockSize 不在 512/1K/2K/4K、以及 BPB 的六项
结构检查（ReservedSectors/NumFats/Sectors 为 0、扇区大小非 2 的幂、对齐越界、簇对齐
越界、Media 字节、FAT32 的 ExtFlags 镜像位）。本行一次把这三处的输入都打出来：

INFOesp: <DiskIo 读前 4 字节的状态> <这 4 字节十六进制> <ESP 的 BlockSize>
         <Fat 找到> <Supported> <Start> <之后 SFS 数>
  ——读用 Fat 自己会走的那个 DiskIo 协议，读 8 字节。eb5890… 说明卷头正常；
    00000000 说明读回来是零（那 BPB 必挂第一项检查）；0xffffffff 说明没到那一步。

INFOlang: <UnicodeCollation2 声明的 SupportedLanguages 字符串>|<PlatformLang 变量值>
  ——Fat 拿这两个字符串做 GetBestLanguage，不匹配就 EFI_UNSUPPORTED。空串表示变量不存在。

只读，不写任何变量、不改变判断。
---
 uefi/core/PianoDwc3Device.c | 59 +++++++++++++++++++++++++++++++++----
 1 file changed, 54 insertions(+), 5 deletions(-)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index e12fbd8..df4d6c9 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -36,6 +36,7 @@ typedef EFI_STATUS (*PIANO_USB_STORAGE_CHECK)(VOID *Context,CONST CHAR8 *Phase,B
 #include <Protocol/PartitionInfo.h>
 #include <Protocol/BlockIo.h>
 #include <Protocol/DiskIo.h>
+#include <Protocol/UnicodeCollation.h>
 #define DW 0xA600000U
 // Native UsbfnDwc3Dxe RVAs e988/e9c0 use these exact USB0 QSCRATCH registers.
 #define USB_SESSION_HS 0xF8810U
@@ -349,6 +350,7 @@ STATIC CONST EFI_GUID mDiagPartitionFvGuid={0x1FA1F39E,0xFEFF,0x4AAE,{0xBD,0x7B,
 STATIC CONST EFI_GUID mDiagEnglishFvGuid={0xCD3BAFB6,0x50FB,0x4FE8,{0x8E,0x4E,0xAB,0x74,0xD2,0xC1,0xA6,0x00}};
 STATIC CONST EFI_GUID mDiagPartitionInfoGuid={0x8CF2F62C,0xBC9B,0x4821,{0x80,0x8D,0xEC,0x9E,0xC4,0x21,0xA1,0xA0}};
 STATIC CONST EFI_GUID mDiagEspTypeGuid={0xC12A7328,0xF81F,0x11D2,{0xBA,0x4B,0x00,0xA0,0xC9,0x3E,0xC9,0x3B}};
+STATIC CONST EFI_GUID mDiagGlobalVariableGuid={0x8BE4DF61,0x93CA,0x11D2,{0xAA,0x0D,0x00,0xE0,0x98,0x03,0x2B,0x8C}};
 STATIC UINT32 DiagHandles(CONST EFI_GUID *G){
  EFI_HANDLE *H=NULL;UINTN C=0;EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)G,NULL,&C,&H);
  UINT32 R=S==EFI_SUCCESS?(UINT32)C:(S==EFI_NOT_FOUND?0U:0xFFFFFFFFU);
@@ -417,6 +419,43 @@ STATIC VOID DiagFatOnEsp(EFI_DRIVER_BINDING_PROTOCOL *FatDb,EFI_HANDLE Esp,
  if(Supported!=NULL)*Supported=(UINT32)S;
  if(!EFI_ERROR(S) && Start!=NULL)*Start=FatDb->Start(FatDb,Esp,NULL);
 }
+// What Fat would see at offset 0 of the ESP, read through the same DiskIo
+// protocol Fat opens. Four bytes are enough to tell a FAT boot sector from a
+// failed or zeroed read, which are the two shapes that reach FatOpenDevice.
+STATIC UINT32 DiagReadBpb(EFI_HANDLE Esp,EFI_DISK_IO_PROTOCOL **DiskIo,CHAR8 *Hex){
+ EFI_DISK_IO_PROTOCOL *D=NULL;EFI_BLOCK_IO_PROTOCOL *B=NULL;UINT8 Buffer[512];
+ STATIC CONST CHAR8 Digits[]="0123456789abcdef";
+ for(UINTN I=0;I<8;++I)Hex[I]='0';Hex[8]=0;
+ if(DiskIo!=NULL)*DiskIo=NULL;
+ if(Esp==NULL)return 0xFFFFFFFFU;
+ if(gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagDiskIoGuid,(VOID **)&D)!=EFI_SUCCESS||D==NULL)return 0xFFFFFFFFU;
+ if(DiskIo!=NULL)*DiskIo=D;
+ if(gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagBlockIoGuid,(VOID **)&B)!=EFI_SUCCESS||B==NULL||B->Media==NULL)return 0xFFFFFFFFU;
+ ZeroMem(Buffer,sizeof(Buffer));
+ EFI_STATUS S=D->ReadDisk(D, B->Media->MediaId, 0, 8, Buffer);
+ if(!EFI_ERROR(S))for(UINTN I=0;I<4;++I){Hex[I*2]=Digits[(Buffer[I]>>4)&15];Hex[I*2+1]=Digits[Buffer[I]&15];}
+ return (UINT32)S;
+}
+// The two strings Fat compares when it decides whether UnicodeCollation2 is
+// usable: what the protocol declares and what PlatformLang holds. A mismatch
+// makes FatDriverBindingStart return EFI_UNSUPPORTED before reading any volume.
+STATIC VOID DiagLang(CHAR8 *Supported,CHAR8 *PlatformLang,UINTN Cap){
+ EFI_HANDLE *H=NULL;UINTN C=0;UINTN Size=0;
+ for(UINTN I=0;I<Cap;++I){Supported[I]=0;PlatformLang[I]=0;}
+ if(gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagCollation2Guid,NULL,&C,&H)==EFI_SUCCESS&&H!=NULL){
+  for(UINTN I=0;I<C;++I){
+   EFI_UNICODE_COLLATION_PROTOCOL *U=NULL;
+   if(gBS->HandleProtocol(H[I],(EFI_GUID *)&mDiagCollation2Guid,(VOID **)&U)!=EFI_SUCCESS||U==NULL||U->SupportedLanguages==NULL)continue;
+   for(UINTN N=0;N+1<Cap && U->SupportedLanguages[N]!=0;++N)Supported[N]=U->SupportedLanguages[N];
+   break;
+  }
+  gBS->FreePool(H);
+ }
+ CHAR16 Value[64];Size=sizeof(Value);
+ if(gRT->GetVariable(L"PlatformLang",(EFI_GUID *)&mDiagGlobalVariableGuid,NULL,&Size,Value)==EFI_SUCCESS){
+  for(UINTN N=0;N+1<Cap && Value[N]!=0;++N)PlatformLang[N]=(CHAR8)(Value[N]<0x80?Value[N]:'?');
+ }
+}
 UINT32 PianoEspDiagEspNameStep(VOID);
 UINT32 PianoEspDiagEspNameSeen(VOID);
 UINT32 PianoEspDiagEspTypeCount(VOID);
@@ -517,20 +556,30 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
     // already prove they ran, so they must appear here.
     {CHAR8 *P=Row;CopyMem(P,"INFOdrv:",8);P+=8;P=EspHex(P,Mask);*P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    // INFOfat: <Fat 找到> <ESP 上 BlockIo> <ESP 上 DiskIo> <Supported 返回码>
-    //          <Start 返回码> <Start 之后的 SFS 句柄数>。0xffffffff 表示没到那一步。
+    // INFOesp: <DiskIo 读前 4 字节的状态> <这 4 字节的十六进制> <ESP 的 BlockSize>
+    //          <Fat 找到> <Supported 返回码> <Start 返回码> <之后 SFS 数>
     {UINT32 EspFound=0,EspNamed=0,HasBlockIo=0,HasDiskIo=0,Sup=0;EFI_STATUS Start=(EFI_STATUS)0xFFFFFFFFU;
      EFI_HANDLE Esp=DiagEspHandle(&EspFound,&EspNamed);
+     EFI_BLOCK_IO_PROTOCOL *Eb=NULL;UINT32 BlockBytes=0;
+     EFI_DISK_IO_PROTOCOL *Ed=NULL;CHAR8 Hex[9];
+     UINT32 ReadStatus=DiagReadBpb(Esp,&Ed,Hex);
+     if(Esp!=NULL && gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagBlockIoGuid,(VOID **)&Eb)==EFI_SUCCESS && Eb!=NULL && Eb->Media!=NULL)BlockBytes=Eb->Media->BlockSize;
      DiagFatOnEsp(FatDb,Esp,&HasBlockIo,&HasDiskIo,&Sup,&Start);
-     CHAR8 *P=Row;CopyMem(P,"INFOfat:",8);P+=8;
+     CHAR8 *P=Row;CopyMem(P,"INFOesp:",8);P+=8;
+     P=EspHex(P,ReadStatus);
+     CopyMem(P,Hex,8);P+=8;
+     P=EspHex(P,BlockBytes);
      P=EspHex(P,FatDb!=NULL?1U:0U);
-     P=EspHex(P,HasBlockIo);
-     P=EspHex(P,HasDiskIo);
      P=EspHex(P,Sup);
      P=EspHex(P,(UINT32)Start);
      P=EspHex(P,DiagHandles(&mDiagSfsGuid));
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
+    {CHAR8 Lang[13],Plat[13];DiagLang(Lang,Plat,sizeof(Lang));
+     CHAR8 *P=Row;CopyMem(P,"INFOlang:",9);P+=9;
+     CopyMem(P,Lang,AsciiStrLen(Lang));P+=AsciiStrLen(Lang);*P++='|';
+     CopyMem(P,Plat,AsciiStrLen(Plat));P+=AsciiStrLen(Plat);*P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     {CHAR8 *P=Row;CopyMem(P,"INFOesp1:",9);P+=9;
      P=EspHex(P,(UINT32)PianoRawLinuxStableLoadStatus());
      P=EspHex(P,PianoRawLinuxStableLoadStage());
