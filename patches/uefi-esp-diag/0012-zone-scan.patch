交接之后那个环的头部已经不满足固件的检查（实测 INFOprev 返回 1、Start=0x10198c5e
远超 2 MiB 容量），说明这块保留内存的格式被改写成了内核 pstore 的形状，固件原先的环形
读者再也读不到东西——也就是说内核确实跑到了 ramoops 初始化，但固件此后失去了 RAM 控制台。

本提交不再假设环形格式：整块 2 MiB 线性读出来扫三类关键串（SUNUEFI_HANDOFF / Linux
version / Kernel panic），摘录第一处命中的 48 字符，并把区域开头 6 个原始字打出来用于
判断头部格式。同时删掉已经答完的 bpb/bpb2/lang/esp1 四行以及随之无用的两个辅助函数，
回复仍在帧预算内。
---
 uefi/core/PianoDwc3Device.c | 111 ++++++++++++++++++------------------
 1 file changed, 54 insertions(+), 57 deletions(-)

diff --git a/uefi/core/PianoDwc3Device.c b/uefi/core/PianoDwc3Device.c
index a7e9443..43a7251 100644
--- a/uefi/core/PianoDwc3Device.c
+++ b/uefi/core/PianoDwc3Device.c
@@ -350,7 +350,6 @@ STATIC CONST EFI_GUID mDiagPartitionFvGuid={0x1FA1F39E,0xFEFF,0x4AAE,{0xBD,0x7B,
 STATIC CONST EFI_GUID mDiagEnglishFvGuid={0xCD3BAFB6,0x50FB,0x4FE8,{0x8E,0x4E,0xAB,0x74,0xD2,0xC1,0xA6,0x00}};
 STATIC CONST EFI_GUID mDiagPartitionInfoGuid={0x8CF2F62C,0xBC9B,0x4821,{0x80,0x8D,0xEC,0x9E,0xC4,0x21,0xA1,0xA0}};
 STATIC CONST EFI_GUID mDiagEspTypeGuid={0xC12A7328,0xF81F,0x11D2,{0xBA,0x4B,0x00,0xA0,0xC9,0x3E,0xC9,0x3B}};
-STATIC CONST EFI_GUID mDiagGlobalVariableGuid={0x8BE4DF61,0x93CA,0x11D2,{0xAA,0x0D,0x00,0xE0,0x98,0x03,0x2B,0x8C}};
 STATIC UINT32 DiagHandles(CONST EFI_GUID *G){
  EFI_HANDLE *H=NULL;UINTN C=0;EFI_STATUS S=gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)G,NULL,&C,&H);
  UINT32 R=S==EFI_SUCCESS?(UINT32)C:(S==EFI_NOT_FOUND?0U:0xFFFFFFFFU);
@@ -484,6 +483,35 @@ STATIC UINT32 DiagPrevLog(UINT32 *Hits,CHAR8 *Excerpt,UINTN ExcerptCap){
  }
  return 0;
 }
+// After a handoff the region no longer carries the firmware's ring header, so
+// the reader above rejects it. Scan the console zone linearly instead: the
+// kernel keeps its pstore text in the same reserved region, and the first
+// matching line says how far the previous boot got.
+STATIC UINT8 *mZoneBuffer;
+STATIC UINT32 DiagZoneScan(UINT32 *Hits,UINT32 *Words,CHAR8 *Excerpt,UINTN ExcerptCap){
+ CONST UINTN Want=0x200000;
+ CONST volatile UINT32 *Z=(CONST volatile UINT32 *)(UINTN)0xA3500000;
+ CONST volatile UINT8 *B=(CONST volatile UINT8 *)Z+12;
+ STATIC CONST CHAR8 *Keys[3]={"SUNUEFI_HANDOFF","Linux version","Kernel panic"};
+ for(UINTN I=0;I<3;++I)Hits[I]=0;
+ for(UINTN I=0;I<6;++I)Words[I]=Z[I];
+ for(UINTN I=0;I<ExcerptCap;++I)Excerpt[I]=0;
+ if(mZoneBuffer==NULL){mZoneBuffer=AllocatePool(Want);if(mZoneBuffer==NULL)return 3;}
+ for(UINTN I=0;I<Want;++I)mZoneBuffer[I]=B[I];
+ MemoryFence();
+ UINTN HitAt=Want;
+ for(UINTN I=0;I+17<Want;++I){
+  for(UINTN K=0;K<3;++K){
+   UINTN L=AsciiStrLen((CHAR8 *)Keys[K]);
+   if(I+L<Want && !CompareMem(mZoneBuffer+I,Keys[K],L)){++Hits[K];if(HitAt==Want)HitAt=I;}
+  }
+ }
+ if(HitAt<Want){
+  UINTN N=0;for(;N+1<ExcerptCap&&HitAt+N<Want;++N){CHAR8 C=(CHAR8)mZoneBuffer[HitAt+N];Excerpt[N]=(C>=0x20&&C<0x7F)?C:'.';}
+  Excerpt[N]=0;
+ }
+ return 0;
+}
 // FatDriverBindingStart refuses the whole volume when no UnicodeCollation2
 // instance matches the platform language it reads, and this firmware cannot
 // rewrite that variable (it already exists with NV attributes). Publishing one
@@ -510,48 +538,9 @@ STATIC UINT32 DiagAddCollation(VOID){
 // Fat reads sizeof(FAT_BOOT_SECTOR) from offset 0 and then decides on these
 // fields alone. Reading them here through the same DiskIo protocol shows what
 // Fat actually sees, instead of what the partition image says it should see.
-STATIC UINT32 DiagBpbFields(EFI_HANDLE Esp,UINT32 *Fields,UINTN Count){
- EFI_DISK_IO_PROTOCOL *D=NULL;EFI_BLOCK_IO_PROTOCOL *B=NULL;UINT8 Buf[512];
- for(UINTN I=0;I<Count;++I)Fields[I]=0xFFFFFFFFU;
- if(Esp==NULL||Count<10)return 0xFFFFFFFFU;
- if(gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagDiskIoGuid,(VOID **)&D)!=EFI_SUCCESS||D==NULL)return 0xFFFFFFFFU;
- if(gBS->HandleProtocol(Esp,(EFI_GUID *)&mDiagBlockIoGuid,(VOID **)&B)!=EFI_SUCCESS||B==NULL||B->Media==NULL)return 0xFFFFFFFFU;
- ZeroMem(Buf,sizeof(Buf));
- EFI_STATUS S=D->ReadDisk(D,B->Media->MediaId,0,sizeof(Buf),Buf);
- if(!EFI_ERROR(S)){
-  Fields[0]=(UINT32)(Buf[0x0B]|((UINT16)Buf[0x0C]<<8));
-  Fields[1]=(UINT32)Buf[0x0D];
-  Fields[2]=(UINT32)(Buf[0x0E]|((UINT16)Buf[0x0F]<<8));
-  Fields[3]=(UINT32)Buf[0x10];
-  Fields[4]=(UINT32)(Buf[0x13]|((UINT16)Buf[0x14]<<8));
-  Fields[5]=(UINT32)Buf[0x15];
-  Fields[6]=(UINT32)(Buf[0x16]|((UINT16)Buf[0x17]<<8));
-  Fields[7]=(UINT32)(Buf[0x20]|((UINT32)Buf[0x21]<<8)|((UINT32)Buf[0x22]<<16)|((UINT32)Buf[0x23]<<24));
-  Fields[8]=(UINT32)(Buf[0x24]|((UINT32)Buf[0x25]<<8)|((UINT32)Buf[0x26]<<16)|((UINT32)Buf[0x27]<<24));
-  Fields[9]=(UINT32)(Buf[0x28]|((UINT16)Buf[0x29]<<8));
- }
- return (UINT32)S;
-}
 // The two strings Fat compares when it decides whether UnicodeCollation2 is
 // usable: what the protocol declares and what PlatformLang holds. A mismatch
 // makes FatDriverBindingStart return EFI_UNSUPPORTED before reading any volume.
-STATIC VOID DiagLang(CHAR8 *Supported,CHAR8 *PlatformLang,UINTN Cap){
- EFI_HANDLE *H=NULL;UINTN C=0;UINTN Size=0;
- for(UINTN I=0;I<Cap;++I){Supported[I]=0;PlatformLang[I]=0;}
- if(gBS->LocateHandleBuffer(ByProtocol,(EFI_GUID *)&mDiagCollation2Guid,NULL,&C,&H)==EFI_SUCCESS&&H!=NULL){
-  for(UINTN I=0;I<C;++I){
-   EFI_UNICODE_COLLATION_PROTOCOL *U=NULL;
-   if(gBS->HandleProtocol(H[I],(EFI_GUID *)&mDiagCollation2Guid,(VOID **)&U)!=EFI_SUCCESS||U==NULL||U->SupportedLanguages==NULL)continue;
-   for(UINTN N=0;N+1<Cap && U->SupportedLanguages[N]!=0;++N)Supported[N]=U->SupportedLanguages[N];
-   break;
-  }
-  gBS->FreePool(H);
- }
- CHAR16 Value[64];Size=sizeof(Value);
- if(gRT->GetVariable(L"PlatformLang",(EFI_GUID *)&mDiagGlobalVariableGuid,NULL,&Size,Value)==EFI_SUCCESS){
-  for(UINTN N=0;N+1<Cap && Value[N]!=0;++N)PlatformLang[N]=(CHAR8)(Value[N]<0x80?Value[N]:'?');
- }
-}
 UINT32 PianoEspDiagEspNameStep(VOID);
 UINT32 PianoEspDiagEspNameSeen(VOID);
 UINT32 PianoEspDiagEspTypeCount(VOID);
@@ -670,23 +659,6 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      P=EspHex(P,DiagHandles(&mDiagSfsGuid));
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    {CHAR8 Lang[13],Plat[13];DiagLang(Lang,Plat,sizeof(Lang));
-     CHAR8 *P=Row;CopyMem(P,"INFOlang:",9);P+=9;
-     CopyMem(P,Lang,AsciiStrLen(Lang));P+=AsciiStrLen(Lang);*P++='|';
-     CopyMem(P,Plat,AsciiStrLen(Plat));P+=AsciiStrLen(Plat);*P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
-    // INFObpb / INFObpb2: the fields Fat computes from the 512 bytes it reads.
-    // Order: SectorSize SectorsPerCluster ReservedSectors NumFats Sectors16 |
-    //        Media SectorsPerFat16 LargeSectorsPerFat ExtFlags FsVersion.
-    {UINT32 F[10];UINT32 ReadStatus=DiagBpbFields(Esp,F,10);
-     CHAR8 *P=Row;CopyMem(P,"INFObpb:",8);P+=8;P=EspHex(P,ReadStatus);
-     for(UINTN I=0;I<5;++I)P=EspHex(P,F[I]);
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
-     P=Row;CopyMem(P,"INFObpb2:",9);P+=9;
-     for(UINTN I=5;I<10;++I)P=EspHex(P,F[I]);
-     *P=0;
-     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     // INFOcoll: <装语言实例的状态> <再问一次 Fat 的 Start> <之后 SFS 数>。
     // No variable and no storage is written; only one protocol instance is added.
     {UINT32 CollStatus=DiagAddCollation();
@@ -700,6 +672,16 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     // INFOprev: <返回> <Linux version 次数> <Kernel panic 次数> <ramoops 次数>
     //           <"[    0." 行数> <环写指针>；INFOprev2 摘一段最像内核日志的原文。
+    {UINT32 Hits[5];CHAR8 Excerpt[49];
+     UINT32 PrevStatus=DiagPrevLog(Hits,Excerpt,sizeof(Excerpt));
+     CHAR8 *P=Row;CopyMem(P,"INFOprev:",9);P+=9;P=EspHex(P,PrevStatus);
+     for(UINTN I=0;I<5;++I)P=EspHex(P,Hits[I]);
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+     P=Row;CopyMem(P,"INFOprev2:",10);P+=10;
+     CopyMem(P,Excerpt,AsciiStrLen(Excerpt));P+=AsciiStrLen(Excerpt);
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     {UINT32 Hits[5];CHAR8 Excerpt[49];
      UINT32 PrevStatus=DiagPrevLog(Hits,Excerpt,sizeof(Excerpt));
      CHAR8 *P=Row;CopyMem(P,"INFOprev:",9);P+=9;P=EspHex(P,PrevStatus);
@@ -719,6 +701,21 @@ STATIC EFI_STATUS FastbootDiagnostic(VOID *Context,PIANO_FASTBOOT *State,CONST C
      P=EspHex(P,PianoEspDiagParentMatches());
      *P=0;
      S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
+    // INFOring: 控制台区开头 6 个字（原始）。INFOfind: <状态> <SUNUEFI_HANDOFF 处数>
+    // <Linux version 处数> <Kernel panic 处数>。INFOtext: 第一处命中的 48 字符原文。
+    {UINT32 Hits[3],Words[6];CHAR8 Text[49];
+     UINT32 ZoneStatus=DiagZoneScan(Hits,Words,Text,sizeof(Text));
+     CHAR8 *P=Row;CopyMem(P,"INFOring:",9);P+=9;
+     for(UINTN I=0;I<6;++I)P=EspHex(P,Words[I]);
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+     P=Row;CopyMem(P,"INFOfind:",9);P+=9;P=EspHex(P,ZoneStatus);
+     for(UINTN I=0;I<3;++I)P=EspHex(P,Hits[I]);
+     *P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;
+     P=Row;CopyMem(P,"INFOtext:",9);P+=9;
+     CopyMem(P,Text,AsciiStrLen(Text));P+=AsciiStrLen(Text);*P=0;
+     S=FastbootSend(NULL,Row,AsciiStrLen(Row));if(EFI_ERROR(S))return S;}
     return FastbootSend(NULL,"OKAY",4);
   }
   return EFI_UNSUPPORTED;
