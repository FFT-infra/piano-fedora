Subject: [PATCH] libssc: await late SSC announcements without blocking QRTR

Inspired by fedora-sheng wait_for_qmi_service.patch. Use the task main
context, a monotonic five-second deadline and cancellation instead of
sleeping inside the async QRTR callback.

--- a/src/libssc-client.c
+++ b/src/libssc-client.c
@@ -34,6 +34,7 @@
 	QmiDevice *device;
 	QmiClientSsc *qmi_client_ssc;
 	QrtrBus *bus;
+	gint64 ssc_lookup_deadline;
 	guint32 node_id;
 	guint indication_report_small_id;
 	guint indication_report_large_id;
@@ -339,56 +340,66 @@
 		task);
 }
 
+static gboolean
+find_ssc_node (gpointer user_data)
+{
+	GTask *task = G_TASK (user_data);
+	SSCClient *client = g_task_get_task_data (task);
+	SSCClientPrivate *priv = ssc_client_get_instance_private (client);
+
+	if (g_task_return_error_if_cancelled (task)) {
+		g_object_unref (task);
+		return G_SOURCE_REMOVE;
+	}
+
+	for (GList *l = qrtr_bus_peek_nodes (priv->bus); l != NULL; l = l->next) {
+		QrtrNode *node = l->data;
+
+		if (node && qrtr_node_lookup_port (node, QMI_SERVICE_SSC) >= 0) {
+			g_debug ("QRTR node discovered for SSC service");
+			/* Transfer the task's existing reference to the QMI callback. */
+			qmi_device_new_from_node (node, g_task_get_cancellable (task),
+				device_new_ready, task);
+			return G_SOURCE_REMOVE;
+		}
+	}
+
+	if (g_get_monotonic_time () >= priv->ssc_lookup_deadline) {
+		g_task_return_new_error (task, ssc_client_error_quark (), SSC_CLIENT_ERROR_LOOKUP,
+			"SSC QMI Service not found after 5 seconds");
+		g_object_unref (task);
+		return G_SOURCE_REMOVE;
+	}
+	return G_SOURCE_CONTINUE;
+}
+
 static void
 bus_new_ready (GObject *source, GAsyncResult *res, gpointer user_data)
 {
 	GError *error = NULL;
-	QrtrNode *node = NULL;
-	GTask *task = NULL;
-	SSCClient *client = NULL;
-	SSCClientPrivate *priv = NULL;
-	gboolean found = FALSE;
-
-	task = G_TASK (user_data);
-	client = g_task_get_task_data (task);
-	priv = ssc_client_get_instance_private (client);
+	GTask *task = G_TASK (user_data);
+	SSCClient *client = g_task_get_task_data (task);
+	SSCClientPrivate *priv = ssc_client_get_instance_private (client);
+	GSource *retry;
 
 	priv->bus = qrtr_bus_new_finish (res, &error);
 	if (error) {
 		g_warning ("QRTR bus unavailable. Make sure access to AF_QIPCRTR address family is granted.");
 		g_task_return_error (task, error);
-		g_clear_object (&task);
-		return;
-	}
-
-	/* Find QRTR node for SSC service */
-	for (GList *l = qrtr_bus_peek_nodes (priv->bus); l != NULL; l = l->next) {
-		node = l->data;
-
-		if (node && qrtr_node_lookup_port (node, QMI_SERVICE_SSC) >= 0) {
-			found = TRUE;
-			break;
-		}
-	}
-
-	if (!found) {
-		g_debug ("Service SSC not found");
-		g_set_error (&error, ssc_client_error_quark(), SSC_CLIENT_ERROR_LOOKUP,
-			     "SSC QMI Service not found");
-		g_task_return_error (task, error);
-		g_clear_object (&task);
-		return;
-	}
-
-	g_debug("QRTR node discovered for SSC service");
-
-	/* QRTR node ready, create QMI device */
-	qmi_device_new_from_node (node,
-		g_task_get_cancellable (task),
-		device_new_ready,
-		task);
-}
-
+		g_object_unref (task);
+		return;
+	}
+
+	priv->ssc_lookup_deadline = g_get_monotonic_time () + 5 * G_USEC_PER_SEC;
+	if (find_ssc_node (task) == G_SOURCE_REMOVE)
+		return;
+
+	/* Yield to QRTR's event sources so late SSC announcements can arrive. */
+	retry = g_timeout_source_new (100);
+	g_source_set_callback (retry, find_ssc_node, task, NULL);
+	g_source_attach (retry, g_task_get_context (task));
+	g_source_unref (retry);
+}
 
