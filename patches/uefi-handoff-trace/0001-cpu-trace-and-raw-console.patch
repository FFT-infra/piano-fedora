+"""Compile the actual raw-export helper against bounded host memory fixtures."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def extract_function(text, marker):
+    start = text.index(marker)
+    opening = text.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end]
+
+
+FIXTURE = r'''
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+typedef uint8_t UINT8;
+typedef unsigned long UINTN;
+typedef uint64_t EFI_STATUS;
+typedef struct { int busy; } PIANO_FASTBOOT;
+typedef struct { const char *Name; UINTN Address, Length;
+                 unsigned MemoryType, ResourceType, ArmAttributes; } EFI_MEMORY_REGION_DESCRIPTOR;
+#define STATIC static
+#define CONST const
+#define NULL_MAP 1
+#define EFI_SUCCESS 0
+#define EFI_ACCESS_DENIED 15
+#define EFI_OUT_OF_RESOURCES 9
+#define EFI_NOT_READY 6
+#define EfiReservedMemoryType 0
+#define EFI_RESOURCE_MEMORY_RESERVED 5
+#define UNCACHED_UNBUFFERED_XN 23
+static UINT8 Fixture[0x200000], Captured[0x200000];
+#define PIANO_USB_CONSOLE_BASE ((UINTN)Fixture)
+static EFI_MEMORY_REGION_DESCRIPTOR Maps[2];
+static unsigned ActiveCount=1, NoMap, Oom, Allocations, Frees, Stages, Fences;
+static UINT8 *Allocation;
+static void GetMemoryMap(EFI_MEMORY_REGION_DESCRIPTOR **map, UINT8 *count) {
+  *map=NoMap?NULL:Maps; *count=(UINT8)ActiveCount;
+}
+static int AsciiStrCmp(const char *a, const char *b) { return strcmp(a,b); }
+static void *AllocatePool(UINTN bytes) {
+  assert(bytes==sizeof(Fixture)); ++Allocations;
+  if(Oom)return NULL;
+  Allocation=malloc(bytes);assert(Allocation);return Allocation;
+}
+static void MemoryFence(void) { ++Fences; }
+static EFI_STATUS PianoFastbootStageCopy(PIANO_FASTBOOT *state, const void *copy, UINTN bytes) {
+  assert(bytes==sizeof(Fixture));assert(copy==Allocation);++Stages;
+  if(state->busy)return EFI_NOT_READY;
+  memcpy(Captured,copy,bytes);return EFI_SUCCESS;
+}
+static void ZeroMem(void *copy, UINTN bytes) { memset(copy,0,bytes); }
+static void FreePool(void *copy) {
+  assert(copy==Allocation);
+  for(UINTN i=0;i<sizeof(Fixture);++i)assert(Allocation[i]==0);
+  free(copy);Allocation=NULL;++Frees;
+}
+'''
+
+MAIN = r'''
+int main(int argc, char **argv) {
+  assert(argc==2);int test=atoi(argv[1]);
+  PIANO_FASTBOOT State={0};
+  Maps[0]=(EFI_MEMORY_REGION_DESCRIPTOR){"Piano_Ramoops",PIANO_USB_CONSOLE_BASE,
+    0x400000,EfiReservedMemoryType,EFI_RESOURCE_MEMORY_RESERVED,UNCACHED_UNBUFFERED_XN};
+  EFI_STATUS expected=EFI_ACCESS_DENIED;
+  switch(test) {
+    case 0:expected=EFI_SUCCESS;break;
+    case 1:NoMap=1;break;
+    case 2:ActiveCount=0;break;
+    case 3:Maps[0].Name="Other_Ram";break;
+    case 4:Maps[0].Address+=4096;break;
+    case 5:Maps[0].Length-=4096;break;
+    case 6:Maps[0].MemoryType=7;break;
+    case 7:Maps[0].ResourceType=0;break;
+    case 8:Maps[0].ArmAttributes=99;break;
+    case 9:Maps[1]=Maps[0];ActiveCount=2;break;
+    case 10:Oom=1;expected=EFI_OUT_OF_RESOURCES;break;
+    case 11:State.busy=1;expected=EFI_NOT_READY;break;
+    default:abort();
+  }
+  // The leading words intentionally do not form a DBGC/pstore ring header.
+  for(UINTN i=0;i<sizeof(Fixture);++i)Fixture[i]=(UINT8)(i*17+3);
+  assert(ExportRawConsole(&State)==expected);
+  for(UINTN i=0;i<sizeof(Fixture);++i)assert(Fixture[i]==(UINT8)(i*17+3));
+  if(expected==EFI_SUCCESS)assert(!memcmp(Fixture,Captured,sizeof(Fixture)));
+  if(test<=9&&test!=0)assert(!Allocations&&!Stages&&!Fences&&!Frees);
+  if(test==10)assert(Allocations==1&&!Stages&&!Fences&&!Frees);
+  if(test==0||test==11)assert(Allocations==1&&Stages==1&&Fences==1&&Frees==1);
+  return 0;
+}
+'''
+
+
+class RawConsoleExportTest(unittest.TestCase):
+    def test_actual_native_helper_guards_and_cleanup(self):
+        source = (ROOT / "uefi/core/PianoDwc3Device.c").read_text()
+        actual = extract_function(source, "STATIC EFI_STATUS ExportRawConsole(")
+        temporary = Path.home() / "Lab/Bridge/tmp/trash"
+        temporary.mkdir(parents=True, exist_ok=True)
+        with tempfile.TemporaryDirectory(prefix="piano-raw-export-", dir=temporary) as folder:
+            folder = Path(folder)
+            fixture = folder / "raw-export.c"
+            fixture.write_text(FIXTURE + actual + MAIN)
+            executable = folder / "raw-export"
+            subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-O1", "-g",
+                            "-fsanitize=address,undefined", "-fno-pie", "-no-pie",
+                            str(fixture), "-o", str(executable)], check=True, timeout=60)
+            for case in range(12):
+                subprocess.run([str(executable), str(case)], check=True, timeout=15)
+
+
+if __name__ == "__main__":
+    unittest.main()
