+++ b/tests/native/PianoInheritedFdtExportTest.c
@@ -0,0 +1,205 @@
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef uint8_t UINT8;
+typedef uint32_t UINT32;
+typedef uint64_t UINT64;
+typedef size_t UINTN;
+typedef int64_t EFI_STATUS;
+typedef const void CONST_VOID;
+typedef void VOID;
+typedef int BOOLEAN;
+#define TRUE 1
+#define FALSE 0
+#define CONST const
+#define STATIC static
+#define EFI_SUCCESS 0
+#define EFI_INVALID_PARAMETER 2
+#define EFI_BAD_BUFFER_SIZE 4
+#define EFI_DEVICE_ERROR 7
+#define EFI_NOT_READY 6
+#define EFI_NOT_FOUND 14
+#define EFI_MEDIA_CHANGED 13
+#define EFI_ABORTED 21
+#define EFI_SECURITY_VIOLATION 26
+#define EFI_COMPROMISED_DATA 33
+
+typedef enum {
+  PianoProductOwnersUninitialized=0,
+  PianoProductOwnersRunning,
+  PianoProductOwnersReturnRequested,
+  PianoProductOwnersRetiring,
+  PianoProductOwnersClean,
+  PianoProductOwnersRetained
+} PIANO_PRODUCT_OWNERS_PHASE;
+typedef struct {
+  BOOLEAN Initialized,Busy,ServicesLost,Retained;
+  PIANO_PRODUCT_OWNERS_PHASE Phase;
+} PIANO_PRODUCT_OWNERS_REPORT;
+typedef struct { CONST_VOID *Fdt; } PIANO_PRODUCT_OWNERS_CONFIG;
+typedef struct { PIANO_PRODUCT_OWNERS_CONFIG Config; PIANO_PRODUCT_OWNERS_REPORT Report; } PIANO_PRODUCT_OWNERS;
+typedef struct { UINT8 *Upload; UINTN UploadBytes; BOOLEAN UploadBorrowed; } PIANO_FASTBOOT;
+typedef struct { UINT32 Opaque; } EFI_BOOT_SERVICES;
+typedef struct { EFI_BOOT_SERVICES *BootServices; } EFI_SYSTEM_TABLE;
+
+static PIANO_PRODUCT_OWNERS mOwners;
+static CONST_VOID *mOwnedInheritedFdt;
+static UINT32 mOwnedInheritedFdtBytes;
+static EFI_BOOT_SERVICES *gBS;
+static EFI_SYSTEM_TABLE *gST;
+static BOOLEAN mBootLogExited;
+static UINT8 mFdt[0x200000];
+static UINT8 mHostAddress[64];
+static UINT32 mFdtBytes;
+static int mHeaderError,mHeaderChecks,mFdtSizeReads,mHashCalls,mHashFailAt,mStageCalls,mStageResult;
+static int mMutateSourceDuringCopy,mCorruptUploadDuringCopy,mLoseServicesDuringCopy;
+static int mAllocations,mSendCalls;
+static PIANO_FASTBOOT mState;
+static EFI_BOOT_SERVICES mBootServices={0};
+static EFI_SYSTEM_TABLE mSystemTable={&mBootServices};
+
+static BOOLEAN BootLogAlive(void) {
+  return !mBootLogExited && !mOwners.Report.ServicesLost && gST!=NULL && gST->BootServices==gBS;
+}
+static int FdtCheckHeader(CONST_VOID *Fdt) {
+  assert(Fdt==mOwnedInheritedFdt);
+  ++mHeaderChecks;
+  return mHeaderError;
+}
+static UINT32 FdtTotalSize(CONST_VOID *Fdt) {
+  assert(Fdt==mFdt || Fdt==mOwnedInheritedFdt);
+  ++mFdtSizeReads;
+  return mFdtBytes;
+}
+static int Sha256HashAll(CONST_VOID *Data,UINTN Bytes,UINT8 Digest[32]) {
+  assert(Data!=NULL && Bytes>0);
+  assert(Bytes==mOwnedInheritedFdtBytes);
+  ++mHashCalls;
+  if(mHashCalls==mHashFailAt)return FALSE;
+  memset(Digest,0,32);
+  CONST UINT8 *Input=Data;
+  for(UINTN I=0;I<Bytes;++I) {
+    UINTN Slot=I%32;
+    Digest[Slot]=(UINT8)(((Digest[Slot]^Input[I]^(UINT8)I)*33U)+17U);
+  }
+  return TRUE;
+}
+static int CompareMem(CONST_VOID *A,CONST_VOID *B,UINTN Bytes) {
+  return memcmp(A,B,Bytes);
+}
+static EFI_STATUS PianoFastbootStageCopy(PIANO_FASTBOOT *State,CONST_VOID *Data,UINTN Bytes) {
+  ++mStageCalls;
+  assert(State==&mState);
+  assert(Data==mOwnedInheritedFdt);
+  assert(Data!=(CONST_VOID *)mHostAddress);
+  assert(Bytes==mOwnedInheritedFdtBytes);
+  if(mStageResult!=EFI_SUCCESS)return mStageResult;
+  State->Upload=malloc(Bytes);
+  assert(State->Upload!=NULL);
+  ++mAllocations;
+  memcpy(State->Upload,Data,Bytes);
+  State->UploadBytes=Bytes;
+  State->UploadBorrowed=FALSE;
+  if(mCorruptUploadDuringCopy)State->Upload[Bytes-1]^=0x80;
+  if(mMutateSourceDuringCopy)mFdt[Bytes-1]^=0x40;
+  if(mLoseServicesDuringCopy) {
+    gBS=NULL;
+    gST->BootServices=NULL;
+    mOwners.Report.ServicesLost=TRUE;
+    mBootLogExited=TRUE;
+  }
+  return EFI_SUCCESS;
+}
+
+/* PIANO_INHERITED_FDT_CACHE_SOURCE */
+/* PIANO_INHERITED_FDT_EXPORT_SOURCE */
+
+static VOID Reset(VOID) {
+  free(mState.Upload);
+  memset(&mOwners,0,sizeof(mOwners));
+  memset(&mState,0,sizeof(mState));
+  mOwnedInheritedFdt=NULL;mOwnedInheritedFdtBytes=0;
+  for(UINTN I=0;I<sizeof(mFdt);++I)mFdt[I]=(UINT8)(I*17U+3U);
+  mFdt[0]=0xd0;mFdt[1]=0x0d;mFdt[2]=0xfe;mFdt[3]=0xed;
+  mFdtBytes=128;mHeaderError=mHeaderChecks=mFdtSizeReads=0;mHashCalls=mHashFailAt=0;
+  mStageCalls=mStageResult=0;mMutateSourceDuringCopy=0;
+  mCorruptUploadDuringCopy=mLoseServicesDuringCopy=0;
+  mAllocations=mSendCalls=0;mBootLogExited=FALSE;
+  gBS=&mBootServices;gST=&mSystemTable;gST->BootServices=gBS;
+  mOwners.Config.Fdt=mFdt;
+  mOwners.Report.Initialized=TRUE;
+  mOwners.Report.Phase=PianoProductOwnersRunning;
+}
+static VOID ExpectNoStage(EFI_STATUS Expected) {
+  assert(PianoProductExportInheritedFdt(&mState)==Expected);
+  assert(mStageCalls==0 && mHashCalls==0 && mAllocations==0 && mSendCalls==0);
+}
+static VOID ExpectSuccessfulCopy(UINT32 Bytes) {
+  Reset();mFdtBytes=Bytes;CacheInheritedFdt(mFdt);
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_SUCCESS);
+  assert(mStageCalls==1 && mAllocations==1 && mSendCalls==0);
+  assert(mState.Upload!=NULL && mState.UploadBytes==Bytes && !mState.UploadBorrowed);
+  assert(memcmp(mState.Upload,mFdt,Bytes)==0);
+  assert(mHashCalls==3);
+  free(mState.Upload);mState.Upload=NULL;
+}
+int main(void) {
+  Reset();CacheInheritedFdt(mFdt);assert(mOwnedInheritedFdt==mFdt&&mOwnedInheritedFdtBytes==128);
+  Reset();mFdtBytes=39;CacheInheritedFdt(mFdt);assert(mOwnedInheritedFdt==NULL&&mOwnedInheritedFdtBytes==0);
+  ExpectNoStage(EFI_NOT_FOUND);
+  Reset();mFdtBytes=0x200001;CacheInheritedFdt(mFdt);assert(mOwnedInheritedFdt==NULL&&mOwnedInheritedFdtBytes==0);
+  ExpectNoStage(EFI_NOT_FOUND);
+
+  Reset();ExpectNoStage(EFI_NOT_FOUND);assert(mFdtSizeReads==0);
+  Reset();CacheInheritedFdt(mFdt);mOwners.Config.Fdt=mHostAddress;
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_MEDIA_CHANGED);
+  assert(mHeaderChecks==0&&mFdtSizeReads==1&&mHashCalls==0&&mStageCalls==0);
+  Reset();CacheInheritedFdt(mFdt);mFdtBytes=129;
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_MEDIA_CHANGED);
+  assert(mHeaderChecks==1&&mFdtSizeReads==2&&mHashCalls==0&&mStageCalls==0);
+  Reset();CacheInheritedFdt(mFdt);mFdtBytes=127;
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_MEDIA_CHANGED);
+  assert(mHeaderChecks==1&&mFdtSizeReads==2&&mHashCalls==0&&mStageCalls==0);
+
+  Reset();mOwners.Report.Initialized=FALSE;ExpectNoStage(EFI_NOT_READY);
+  Reset();mOwners.Report.Phase=PianoProductOwnersRetiring;ExpectNoStage(EFI_NOT_READY);
+  Reset();mOwners.Report.Busy=TRUE;ExpectNoStage(EFI_NOT_READY);
+  Reset();mOwners.Report.Retained=TRUE;ExpectNoStage(EFI_NOT_READY);
+  Reset();mOwners.Report.ServicesLost=TRUE;ExpectNoStage(EFI_ABORTED);
+  Reset();gBS=NULL;ExpectNoStage(EFI_ABORTED);
+  Reset();mBootLogExited=TRUE;ExpectNoStage(EFI_ABORTED);
+  Reset();assert(PianoProductExportInheritedFdt(NULL)==EFI_INVALID_PARAMETER);assert(mStageCalls==0&&mHashCalls==0);
+  Reset();mOwners.Config.Fdt=NULL;ExpectNoStage(EFI_NOT_FOUND);
+  Reset();CacheInheritedFdt(mFdt);mHeaderError=1;ExpectNoStage(EFI_COMPROMISED_DATA);
+
+  Reset();CacheInheritedFdt(mFdt);mHashFailAt=1;
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_DEVICE_ERROR);
+  assert(mHashCalls==1&&mStageCalls==0&&mAllocations==0&&mSendCalls==0);
+
+  Reset();CacheInheritedFdt(mFdt);mStageResult=EFI_DEVICE_ERROR;
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_DEVICE_ERROR);
+  assert(mHashCalls==1&&mStageCalls==1&&mAllocations==0&&mSendCalls==0);
+
+  Reset();CacheInheritedFdt(mFdt);mLoseServicesDuringCopy=1;
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_ABORTED);
+  assert(mHashCalls==1&&mStageCalls==1&&mAllocations==1&&mSendCalls==0);
+  free(mState.Upload);mState.Upload=NULL;
+
+  Reset();CacheInheritedFdt(mFdt);mMutateSourceDuringCopy=1;
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_SECURITY_VIOLATION);
+  assert(mHashCalls==3&&mStageCalls==1&&mSendCalls==0);
+  free(mState.Upload);mState.Upload=NULL;
+
+  Reset();CacheInheritedFdt(mFdt);mCorruptUploadDuringCopy=1;
+  assert(PianoProductExportInheritedFdt(&mState)==EFI_SECURITY_VIOLATION);
+  assert(mHashCalls==3&&mStageCalls==1&&mSendCalls==0);
+  free(mState.Upload);mState.Upload=NULL;
+
+  ExpectSuccessfulCopy(40);
+  ExpectSuccessfulCopy(0x200000);
+  puts("Inherited FDT export source extraction passed: guards, bounds, hashes, copy failures, mutation, EBS fence, exact payload");
+  return 0;
+}
diff --git a/tests/native/PianoRawLinuxEnterSourceTest.c b/tests/native/PianoRawLinuxEnterSourceTest.c
