+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+TRASH = Path.home() / "Lab/Bridge/tmp/trash"
+SOURCE = ROOT / "uefi/core/PianoRawLinuxBoot.c"
+FIXTURE = ROOT / "tests/native/PianoRawLinuxEnterSourceTest.c"
+
+
+def extract_function(source, signature):
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+    state = "code"
+    index = opening
+    while index < len(source):
+        char = source[index]
+        following = source[index + 1] if index + 1 < len(source) else ""
+        if state == "line_comment":
+            if char == "\n":
+                state = "code"
+        elif state == "block_comment":
+            if char == "*" and following == "/":
+                state = "code"
+                index += 1
+        elif state == "string":
+            if char == "\\":
+                index += 1
+            elif char == '"':
+                state = "code"
+        elif state == "character":
+            if char == "\\":
+                index += 1
+            elif char == "'":
+                state = "code"
+        elif char == "/" and following == "/":
+            state = "line_comment"
+            index += 1
+        elif char == "/" and following == "*":
+            state = "block_comment"
+            index += 1
+        elif char == '"':
+            state = "string"
+        elif char == "'":
+            state = "character"
+        elif char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:index + 1]
+        index += 1
+    raise AssertionError(f"Unterminated function: {signature}")
+
+
+class RawLinuxEnterTraceTests(unittest.TestCase):
+    def test_extracted_production_functions_against_boot_services_fixture(self):
+        compiler = shutil.which("cc")
+        if not compiler:
+            self.skipTest("host C compiler unavailable")
+        source = SOURCE.read_text()
+        fixture = FIXTURE.read_text()
+        trace = extract_function(source, "VOID PianoRawLinuxTrace(")
+        enter = extract_function(source, "EFI_STATUS PianoRawLinuxEnter(")
+        fixture = fixture.replace("/* PIANO_RAW_LINUX_TRACE_SOURCE */", trace)
+        fixture = fixture.replace("/* PIANO_RAW_LINUX_ENTER_SOURCE */", enter)
+        self.assertNotIn("PIANO_RAW_LINUX_TRACE_SOURCE", fixture)
+        self.assertNotIn("PIANO_RAW_LINUX_ENTER_SOURCE", fixture)
+        TRASH.mkdir(parents=True, exist_ok=True)
+        with tempfile.TemporaryDirectory(dir=TRASH, prefix="raw-linux-trace-") as directory:
+            c_file = Path(directory) / "fixture.c"
+            binary = Path(directory) / "fixture"
+            c_file.write_text(fixture)
+            build = subprocess.run(
+                [compiler, "-std=c11", "-Wall", "-Wextra", "-Werror", str(c_file), "-o", str(binary)],
+                capture_output=True,
+                text=True,
+            )
+            self.assertEqual(0, build.returncode, build.stderr)
+            env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
+            result = subprocess.run([str(binary)], capture_output=True, text=True, env=env, timeout=10)
+            self.assertEqual(0, result.returncode, result.stdout + result.stderr)
+            self.assertIn("CPU-only post-EBS trace passed", result.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
