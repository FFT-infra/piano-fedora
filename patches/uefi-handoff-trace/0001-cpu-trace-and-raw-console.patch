+EFI_STATUS PianoProductExportInheritedFdt(PIANO_FASTBOOT *State) {
+  CONST VOID *Fdt;
+  UINT32 Bytes,CurrentBytes;
+  UINT8 Before[32],After[32],Staged[32];
+  BOOLEAN Hashed;
+  EFI_STATUS Status;
+
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  if(State==NULL)return EFI_INVALID_PARAMETER;
+  if(!mOwners.Report.Initialized || mOwners.Report.Phase!=PianoProductOwnersRunning ||
+     mOwners.Report.Busy || mOwners.Report.Retained)return EFI_NOT_READY;
+  Fdt=mOwnedInheritedFdt;
+  Bytes=mOwnedInheritedFdtBytes;
+  if(Fdt==NULL || Bytes<40 || Bytes>0x200000)return EFI_NOT_FOUND;
+  if(mOwners.Config.Fdt!=Fdt)return EFI_MEDIA_CHANGED;
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  BOOLEAN HeaderValid=FdtCheckHeader(Fdt)==0;
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  if(!HeaderValid)return EFI_COMPROMISED_DATA;
+  CurrentBytes=FdtTotalSize(Fdt);
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  if(CurrentBytes!=Bytes)return EFI_MEDIA_CHANGED;
+
+  Hashed=Sha256HashAll(Fdt,Bytes,Before);
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  if(!Hashed)return EFI_DEVICE_ERROR;
+
+  Status=PianoFastbootStageCopy(State,Fdt,Bytes);
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  if(Status!=EFI_SUCCESS)return Status;
+  if(mOwners.Config.Fdt!=Fdt || State->Upload==NULL || State->UploadBorrowed ||
+     State->UploadBytes!=Bytes)return EFI_COMPROMISED_DATA;
+
+  Hashed=Sha256HashAll(Fdt,Bytes,After);
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  if(!Hashed)return EFI_DEVICE_ERROR;
+  Hashed=Sha256HashAll(State->Upload,State->UploadBytes,Staged);
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  if(!Hashed)return EFI_DEVICE_ERROR;
+  if(CompareMem(Before,After,sizeof(Before))!=0 ||
+     CompareMem(Before,Staged,sizeof(Before))!=0)return EFI_SECURITY_VIOLATION;
+  if(mOwners.Report.ServicesLost || gBS==NULL || !BootLogAlive())return EFI_ABORTED;
+  return EFI_SUCCESS;
+}
