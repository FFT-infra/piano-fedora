+#include <assert.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <setjmp.h>
+
+typedef uint8_t UINT8;
+typedef uint32_t UINT32;
+typedef uint64_t UINT64;
+typedef size_t UINTN;
+typedef UINT64 EFI_STATUS;
+typedef char CHAR8;
+typedef const char CONST_CHAR8;
+typedef const UINT8 CONST_UINT8;
+typedef void VOID;
+typedef void *EFI_HANDLE;
+typedef int BOOLEAN;
+#define CONST const
+#define TRUE 1
+#define FALSE 0
+#define MAX_UINTN SIZE_MAX
+#define EFI_SUCCESS 0
+#define EFI_INVALID_PARAMETER 2
+#define EFI_DEVICE_ERROR 7
+#define EFI_OUT_OF_RESOURCES 9
+#define EFI_BUFFER_TOO_SMALL 5
+#define EFI_ACCESS_DENIED 15
+#define EFI_NOT_STARTED 19
+#define EFI_COMPROMISED_DATA 33
+
+typedef struct { UINT64 Opaque[8]; } EFI_MEMORY_DESCRIPTOR;
+typedef struct { VOID *ImageBase; UINT64 ImageSize; } LOADED_IMAGE;
+typedef struct { UINT64 Dtb,Kernel; } PIANO_RAW_LINUX_REPORT;
+typedef struct {
+  UINT64 TraceNonce;
+  BOOLEAN Entered;
+  VOID *Owners;
+  EFI_HANDLE Image;
+  struct { VOID *ImageBase; UINT64 ImageSize; } Loaded;
+} RAW_STATE;
+typedef EFI_STATUS (*GET_MEMORY_MAP)(UINTN *,EFI_MEMORY_DESCRIPTOR *,UINTN *,UINTN *,UINT32 *);
+typedef EFI_STATUS (*EXIT_BOOT_SERVICES)(EFI_HANDLE,UINTN);
+typedef struct { GET_MEMORY_MAP GetMemoryMap; EXIT_BOOT_SERVICES ExitBootServices; } EFI_BOOT_SERVICES;
+
+static RAW_STATE mRaw;
+static EFI_BOOT_SERVICES *gBS;
+static UINT32 mScenario,mMapCalls,mExitCalls,mAllocCalls,mCacheCalls,mBranchCalls;
+static UINTN mBranchTree,mBranchEntry;
+static EFI_STATUS mResult;
+static VOID *mAllocation;
+static BOOLEAN mEbsComplete;
+static CHAR8 mLogs[8192];
+static UINTN mLogsBytes,mTraceCalls;
+static jmp_buf mBranch;
+
+static EFI_STATUS FakeGetMemoryMap(UINTN *,EFI_MEMORY_DESCRIPTOR *,UINTN *,UINTN *,UINT32 *);
+static EFI_STATUS FakeExitBootServices(EFI_HANDLE,UINTN);
+static EFI_BOOT_SERVICES mBootServices={FakeGetMemoryMap,FakeExitBootServices};
+static BOOLEAN PianoRawLinuxPrepared(CONST PIANO_RAW_LINUX_REPORT *R,VOID *O,EFI_HANDLE I){
+  return R!=NULL&&O==mRaw.Owners&&I==mRaw.Image;
+}
+static BOOLEAN Live(VOID){return gBS!=NULL;}
+static UINTN AsciiSPrint(CHAR8 *Buffer,UINTN Capacity,CONST_CHAR8 *Format,...){
+  CHAR8 NativeFormat[256];UINTN In=0,Out=0;
+  while(Format[In]&&Out+2<sizeof(NativeFormat)){
+    if(Format[In]=='%'&&Format[In+1]=='a'){NativeFormat[Out++]='%';NativeFormat[Out++]='s';In+=2;}
+    else NativeFormat[Out++]=Format[In++];
+  }
+  NativeFormat[Out]=0;
+  va_list Args;va_start(Args,Format);int Result=vsnprintf(Buffer,Capacity,NativeFormat,Args);va_end(Args);
+  return Result<0?0:(UINTN)Result;
+}
+static UINTN AsciiStrLen(CONST_CHAR8 *S){return strlen(S);}
+static VOID RamLogWrite(CONST_UINT8 *Buffer,UINTN Length){
+  assert(mLogsBytes+Length<sizeof(mLogs));
+  if(mEbsComplete)assert(gBS==NULL);
+  memcpy(mLogs+mLogsBytes,Buffer,Length);mLogsBytes+=Length;mLogs[mLogsBytes]=0;++mTraceCalls;
+}
+static VOID *AllocatePool(UINTN Bytes){
+  ++mAllocCalls;
+  if(mScenario==2)return NULL;
+  mAllocation=malloc(Bytes);return mAllocation;
+}
+static VOID WriteBackInvalidateDataCacheRange(VOID *Address,UINTN Bytes){
+  assert(Address!=NULL&&Bytes>0&&gBS==NULL);++mCacheCalls;
+}
+static VOID RawEnter(UINT64 Tree,UINT64 Entry) __attribute__((noreturn));
+static VOID RawEnter(UINT64 Tree,UINT64 Entry){
+  assert(gBS==NULL);++mBranchCalls;mBranchTree=(UINTN)Tree;mBranchEntry=(UINTN)Entry;longjmp(mBranch,1);
+}
+
+/* PIANO_RAW_LINUX_TRACE_SOURCE */
+/* PIANO_RAW_LINUX_ENTER_SOURCE */
+
+enum { SC_SIZE_PROBE_FAIL=1,SC_ALLOC_FAIL,SC_FILL_FAIL,SC_EBS_ERROR,SC_DOUBLE_STALE,SC_STALE_SUCCESS,SC_EBS_SUCCESS };
+static EFI_STATUS FakeGetMemoryMap(UINTN *Size,EFI_MEMORY_DESCRIPTOR *Map,UINTN *Key,UINTN *Stride,UINT32 *Version){
+  assert(gBS!=NULL);++mMapCalls;
+  if(mMapCalls==1){
+    *Key=0;*Stride=16;*Version=1;*Size=64;
+    return mScenario==SC_SIZE_PROBE_FAIL?EFI_DEVICE_ERROR:EFI_BUFFER_TOO_SMALL;
+  }
+  *Key=100+mMapCalls;*Stride=16;*Version=1;
+  if(mScenario==SC_FILL_FAIL)return EFI_DEVICE_ERROR;
+  assert(Map!=NULL&&*Size>=64);*Size=64;return EFI_SUCCESS;
+}
+static EFI_STATUS FakeExitBootServices(EFI_HANDLE Image,UINTN Key){
+  assert(gBS!=NULL&&Image==mRaw.Image&&Key==100+mMapCalls);++mExitCalls;
+  if(mScenario==SC_EBS_ERROR)return EFI_DEVICE_ERROR;
+  if(mScenario==SC_DOUBLE_STALE)return EFI_INVALID_PARAMETER;
+  if(mScenario==SC_STALE_SUCCESS&&mExitCalls==1)return EFI_INVALID_PARAMETER;
+  mEbsComplete=TRUE;gBS=NULL;return EFI_SUCCESS;
+}
+static VOID Reset(UINT32 Scenario){
+  free(mAllocation);mAllocation=NULL;memset(&mRaw,0,sizeof(mRaw));mRaw.TraceNonce=0x1234;
+  mRaw.Owners=(VOID *)(uintptr_t)0x2222;mRaw.Image=(EFI_HANDLE)(uintptr_t)0x3333;
+  mRaw.Loaded.ImageBase=(VOID *)(uintptr_t)0x4444;mRaw.Loaded.ImageSize=4096;
+  mScenario=Scenario;mMapCalls=mExitCalls=mAllocCalls=mCacheCalls=mBranchCalls=0;
+  mBranchTree=mBranchEntry=0;mEbsComplete=FALSE;mLogsBytes=mTraceCalls=0;mLogs[0]=0;
+  mResult=EFI_NOT_STARTED;gBS=&mBootServices;
+}
+static EFI_STATUS Invoke(CONST PIANO_RAW_LINUX_REPORT *R){
+  if(setjmp(mBranch)==0)return PianoRawLinuxEnter(R);
+  return EFI_SUCCESS;
+}
+static VOID CheckTraceIdentity(VOID){
+  assert(mTraceCalls>0&&strstr(mLogs,"nonce=0000000000001234")!=NULL);
+  assert(strstr(mLogs,"stage=")!=NULL&&strstr(mLogs,"status=")!=NULL&&strstr(mLogs,"detail=")!=NULL);
+}
+int main(VOID){
+  PIANO_RAW_LINUX_REPORT Report={.Dtb=0xB0000000,.Kernel=0xA8000000};
+  Reset(SC_SIZE_PROBE_FAIL);mResult=Invoke(&Report);
+  assert(mResult==EFI_COMPROMISED_DATA&&mRaw.Entered==FALSE&&mAllocCalls==0);
+  assert(strstr(mLogs,"stage=size-probe")!=NULL);CheckTraceIdentity();
+
+  Reset(SC_ALLOC_FAIL);mResult=Invoke(&Report);
+  assert(mResult==EFI_OUT_OF_RESOURCES&&mRaw.Entered==FALSE&&mAllocCalls==1);
+  assert(strstr(mLogs,"stage=allocation")!=NULL);CheckTraceIdentity();
+
+  Reset(SC_FILL_FAIL);mResult=Invoke(&Report);
+  assert(mResult==EFI_DEVICE_ERROR&&mRaw.Entered==TRUE&&mMapCalls==2&&mExitCalls==0);
+  assert(strstr(mLogs,"stage=map-fill")!=NULL);CheckTraceIdentity();
+
+  Reset(SC_EBS_ERROR);mResult=Invoke(&Report);
+  assert(mResult==EFI_DEVICE_ERROR&&mMapCalls==2&&mExitCalls==1);
+  assert(strstr(mLogs,"stage=ebs-before")&&strstr(mLogs,"stage=ebs-return"));CheckTraceIdentity();
+
+  Reset(SC_DOUBLE_STALE);mResult=Invoke(&Report);
+  assert(mResult==EFI_INVALID_PARAMETER&&mMapCalls==3&&mExitCalls==2);
+  assert(strstr(mLogs,"stage=map-fill")&&strstr(mLogs,"stage=ebs-return"));CheckTraceIdentity();
+
+  Reset(SC_STALE_SUCCESS);mResult=Invoke(&Report);
+  assert(mResult==EFI_SUCCESS&&gBS==NULL&&mEbsComplete==TRUE&&mExitCalls==2&&mMapCalls==3);
+  assert(mCacheCalls==1&&mBranchCalls==1&&mBranchTree==Report.Dtb&&mBranchEntry==Report.Kernel);
+  CONST CHAR8 *Ebs=strstr(mLogs,"stage=ebs-return");
+  CONST CHAR8 *Cache=strstr(mLogs,"stage=cache-refresh-before");
+  CONST CHAR8 *Branch=strstr(mLogs,"stage=branch-before");
+  assert(Ebs&&Cache&&Branch&&Ebs<Cache&&Cache<Branch);
+  assert(strstr(Branch,"status=0000000000000000")!=NULL);
+  assert(mTraceCalls>=8);CheckTraceIdentity();
+
+  Reset(SC_EBS_SUCCESS);mResult=Invoke(&Report);
+  assert(mResult==EFI_SUCCESS&&gBS==NULL&&mExitCalls==1&&mCacheCalls==1&&mBranchCalls==1);
+  CheckTraceIdentity();
+  puts("RawLinux source extraction: all entry outcomes and CPU-only post-EBS trace passed");
+  free(mAllocation);return 0;
+}
