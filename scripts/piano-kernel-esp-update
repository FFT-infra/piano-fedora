#!/usr/bin/python3
"""把刚装上的内核重建成 ESP 上固件实际读取的 UKI。

固件执行 `\\EFI\\Linux\\sunuefi.efi`。它是 systemd-stub、内核、initramfs、
板级 DTB 与引导参数组成的单个 PE 镜像。内核升级不需要重编固件：在设备上
取出现有 UKI 的 .dtb、.cmdline 与 .osrel，配上新内核与重建的 initramfs
重新打包，再原子替换这一个文件。

顺序是固定的，任何一步失败都不落盘：

1. 用封存 manifest 校验已安装的内核（`inspect_installed_kernel`）；
2. 读现有 UKI 的 .dtb、.cmdline 与 .osrel。.dtb 是构建时叠加过板级 dtbo
   的那一份，不是 `/boot/dtb/qcom/` 里的；
3. 在临时目录重建 initramfs；
4. 用 systemd-ukify 打包，再逐段读回比对；
5. 先写 `.sunuefi.efi.new` 并 fsync，把旧文件复制成 `.bak`，最后
   `os.replace` 换上去；
6. 写审计记录。

失败模式与之前相同：写失败时旧 UKI 原样留着，设备继续用上一个内核启动。
已经装好但起不来的内核没有自动回滚（上游没有 boot counter），回滚靠
`.bak` 与 installonly 保留下来的旧模块树。

由 kernel-piano 的 `%posttrans` 调用；镜像构建（`dnf --installroot`）里没有
ESP 载荷，那种环境直接跳过。
"""

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from piano_artifacts import inspect_installed_kernel, sha256  # noqa: E402

# ESP 在系统里的挂载点由 rootfs 策略固定（LABEL=SUNUEFI_ESP /boot/efi）。
# 测试与救援环境可以覆盖。
DEFAULT_ESP = Path(os.environ.get("PIANO_ESP_DIR", "/boot/efi"))
ESP_PAYLOAD = "EFI/Linux"
UKI_NAME = "sunuefi.efi"
# ukify 与 aa64 stub 由 systemd-ukify、systemd-boot-unsigned 提供，RPM 依赖
# 已声明。测试用环境变量指向同版本工具，避免依赖构建机的安装位置。
UKIFY = Path(os.environ.get("PIANO_UKIFY", "/usr/lib/systemd/ukify"))
UKI_STUB = Path(os.environ.get("PIANO_UKI_STUB",
                               "/usr/lib/systemd/boot/efi/linuxaa64.efi.stub"))
AUDIT_DIR = Path(os.environ.get("PIANO_KERNEL_ESP_STATE", "/var/lib/piano/kernel-esp"))
BUILD_INITRAMFS = HERE / "build-initramfs.py"
# ukify 写进 PE 段的语义内容。除这六段之外的东西（签名表、PE 头时间戳）不参与
# “内容有没有变”的判断。
UKI_SECTIONS = (".linux", ".initrd", ".dtb", ".cmdline", ".osrel", ".uname")


class EspUpdateError(Exception):
    """可预期的失败：输入不满足或写入无法安全完成。"""


def free_bytes(path):
    stat = os.statvfs(path)
    return stat.f_bavail * stat.f_frsize


def fsync_path(path):
    with Path(path).open("rb") as stream:
        os.fsync(stream.fileno())


def fsync_directory(path):
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        # vfat 上目录 fsync 不保证受支持；文件本身已经 fsync 过，这里只
        # 尽力而为，失败不能把一次成功的替换报成失败。
        pass
    finally:
        os.close(fd)


def replace_atomically(source, target, backup):
    """把 source 换到 target 上，旧 target 先复制成 backup。

    FAT32 没有硬链接，复制是唯一能留下旧文件的方式。峰值占用是
    target + backup + source 三份，所以调用前先算过剩余空间。
    """
    target, backup = Path(target), Path(backup)
    fsync_path(source)
    if target.exists():
        shutil.copyfile(target, backup)
        fsync_path(backup)
    os.replace(source, target)
    fsync_directory(target.parent)


def uki_sections(path):
    """按 VirtualSize 读 PE 段，与上游 package_release.py 的校验方式一致。"""
    import pefile
    image = pefile.PE(str(path), fast_load=True)
    try:
        rows = {}
        for section in image.sections:
            name = section.Name.rstrip(b"\0").decode("ascii")
            if name in rows:
                raise EspUpdateError("duplicate UKI section: " + name)
            data = section.get_data()[:section.Misc_VirtualSize]
            if len(data) != section.Misc_VirtualSize:
                raise EspUpdateError("truncated UKI section: " + name)
            rows[name] = data
        return rows
    finally:
        image.close()


def build_uki(image, initramfs, dtb, cmdline, osrel, release, output):
    """按上游 package_release.py 的 section 约定打包，并读回逐段比对。"""
    for tool in (UKIFY, UKI_STUB):
        if not tool.is_file():
            raise EspUpdateError(
                f"missing {tool}; install systemd-ukify and systemd-boot-unsigned")
    with tempfile.TemporaryDirectory(prefix="piano-uki-") as scratch:
        scratch = Path(scratch)
        (scratch / "cmdline").write_bytes(cmdline)
        (scratch / "os-release").write_bytes(osrel)
        result = subprocess.run(
            [sys.executable, str(UKIFY), "--config=/dev/null", "build",
             "--efi-arch=aa64", "--stub", str(UKI_STUB),
             "--linux", str(image), "--initrd", str(initramfs),
             "--devicetree", str(dtb),
             "--cmdline=@" + str(scratch / "cmdline"),
             "--os-release=@" + str(scratch / "os-release"),
             "--uname", release, "--no-sign-kernel", "--output", str(output)],
            capture_output=True, text=True)
        if result.returncode != 0:
            raise EspUpdateError(
                "ukify failed: " + (result.stderr.strip() or result.stdout.strip()))
    expected = {".linux": Path(image).read_bytes(),
                ".initrd": Path(initramfs).read_bytes(),
                ".dtb": Path(dtb).read_bytes(),
                ".cmdline": cmdline, ".osrel": osrel,
                ".uname": release.encode()}
    rows = uki_sections(output)
    for name, data in expected.items():
        if rows.get(name) != data:
            raise EspUpdateError("rebuilt UKI section differs: " + name)
    return {name: {"bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}
            for name, data in rows.items()}


def build_initramfs(root, output, manifest=None):
    if not BUILD_INITRAMFS.is_file():
        raise EspUpdateError(f"missing {BUILD_INITRAMFS}")
    command = [sys.executable, str(BUILD_INITRAMFS), "--installed", "--rootfs", str(root),
               "--output", str(output)]
    # installonly 下新旧内核并存，每份 manifest 名字都不同；不点名的话
    # build-initramfs 会拒绝在多份之间挑一份。
    if manifest is not None:
        command += ["--manifest", str(manifest)]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise EspUpdateError("initramfs rebuild failed: " + (result.stderr.strip() or result.stdout.strip()))
    return json.loads((output / "manifest.json").read_text())


def update(root, esp, release_expected=None, dry_run=False, manifest_name=None):
    root, esp = Path(root), Path(esp)
    uki = esp / ESP_PAYLOAD / UKI_NAME
    if not uki.is_file():
        raise EspUpdateError(
            f"no ESP payload at {uki}; this is not a bootable piano install")
    manifest, manifest_sha, image = inspect_installed_kernel(root, manifest=manifest_name)
    release = manifest["kernel_release"]
    if release_expected is not None and release != release_expected:
        raise EspUpdateError(
            f"installed kernel release {release} differs from the requested {release_expected}")

    existing = uki_sections(uki)
    missing = [name for name in (".dtb", ".cmdline", ".osrel") if name not in existing]
    if missing:
        raise EspUpdateError("existing ESP UKI lacks " + ", ".join(missing))

    record = {
        "release": release,
        "kernel_manifest_sha256": manifest_sha,
        "image": {"source": str(image), "sha256": sha256(image), "bytes": image.stat().st_size},
        "esp": str(uki.parent),
        "changed": {},
    }
    if dry_run:
        record["dry_run"] = True
        return record

    with tempfile.TemporaryDirectory(prefix="piano-esp-") as scratch:
        scratch = Path(scratch)
        initramfs_dir = scratch / "initramfs"
        built = build_initramfs(root, initramfs_dir, manifest_name)
        if built["kernel_manifest_sha256"] != manifest_sha:
            raise EspUpdateError("rebuilt initramfs names a different kernel manifest")
        initramfs = initramfs_dir / "initramfs.cpio.gz"
        dtb = scratch / "board.dtb"
        dtb.write_bytes(existing[".dtb"])

        built_uki = scratch / UKI_NAME
        sections = build_uki(image, initramfs, dtb, existing[".cmdline"],
                             existing[".osrel"], release, built_uki)
        rebuilt = uki_sections(built_uki)
        changed = any(existing.get(name) != rebuilt.get(name) for name in UKI_SECTIONS)
        # 替换峰值是旧 UKI、它的 .bak 与新文件三份同时存在。
        needed = uki.stat().st_size * 2 + built_uki.stat().st_size
        if changed and free_bytes(uki.parent) < needed:
            raise EspUpdateError(
                f"ESP has {free_bytes(uki.parent)} bytes free, the update needs {needed}")
        record["changed"][UKI_NAME] = changed
        if changed:
            staged = uki.with_name("." + uki.name + ".new")
            shutil.copyfile(built_uki, staged)
            # 校验通过之后才碰 UKI：此前的任何失败都只留下 .new 与 .bak。
            replace_atomically(staged, uki, uki.with_name(uki.name + ".bak"))
        record["uki"] = {"path": str(uki), "sections": sections}

    record["initramfs"] = {
        "sha256": built["initramfs_sha256"],
        "bytes": built["initramfs_bytes"],
        "modules": built["modules"],
    }
    return record


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--root", default="/", help="已安装系统根（默认 /）")
    parser.add_argument("--esp", default=str(DEFAULT_ESP), help="ESP 挂载点（默认 /boot/efi）")
    parser.add_argument("--release", help="断言刚装上的内核 release")
    parser.add_argument("--manifest", help="已安装内核的 manifest 文件名"
                                          "（installonly 下多版本共存时必填）")
    parser.add_argument("--dry-run", action="store_true", help="只校验与重建，不写 ESP")
    args = parser.parse_args(argv)

    try:
        record = update(args.root, args.esp, args.release, args.dry_run, args.manifest)
    except (EspUpdateError, ValueError, OSError, KeyError, ImportError) as exc:
        print(f"piano: kernel ESP update failed: {exc}", file=sys.stderr)
        return 2

    if not record.get("dry_run"):
        AUDIT_DIR.mkdir(parents=True, exist_ok=True)
        (AUDIT_DIR / f"{record['release']}.json").write_text(
            json.dumps(record, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(record, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
