#!/usr/bin/python3
"""把刚装上的内核写进 ESP 上 systemd-boot 实际读取的启动项。

新固件走标准 UEFI 启动顺序：ESP 的 `/EFI/BOOT/BOOTAA64.EFI`（systemd-boot）
是入口，Linux 载荷由它加载。SunUEFI 出厂默认是 BLS 布局：内核、initramfs
与板级 DTB 分放在 `/linux/<release>/`，启动项写在
`/loader/entries/linux-<release>.conf`。

UKI 布局分两种，以 ESP 上有没有 systemd-boot 区分。有 systemd-boot 时它枚举
`/EFI/Linux/` 下的版本化文件（`linux-<release>.efi`），旧文件留给菜单回退。
没有 systemd-boot 的是早期单 UKI 固件，它只打开固定的
`/EFI/Linux/sunuefi.efi`，这个文件名就是契约，只能原文件替换。

内核升级不需要重编固件：在设备上取出现有条目里的 cmdline 与板级 DTB，
配上新内核与重建的 initramfs，写成新 release 的条目，旧 release 原样留着，
systemd-boot 菜单因此天然给出回退项。

顺序是固定的，任何一步失败都不落盘：

1. 用封存 manifest 校验已安装的内核（`inspect_installed_kernel`）；
2. 从现有启动项读 cmdline 与板级 DTB。DTB 是构建时叠加过板级 dtbo 的那一份，
   不是 `/boot/dtb/qcom/` 里的；
3. 在临时目录重建 initramfs；
4. 先把载荷写进同级临时目录并读回比对，再改名就位，最后才落启动项；
5. 写审计记录。

失败模式：写失败时旧条目与旧载荷原样留着，设备继续用上一个内核启动。
已经装好但起不来的内核没有自动回滚，回滚靠旧 release 的条目与
installonly 保留下来的旧模块树。

由 kernel-piano 的 `%posttrans` 调用；镜像构建（`dnf --installroot`）里没有
ESP 载荷，那种环境直接跳过。
"""

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from piano_artifacts import inspect_installed_kernel, sha256  # noqa: E402

# ESP 在系统里的挂载点由 rootfs 策略固定（LABEL=SUNUEFI_ESP /boot/efi）。
# 测试与救援环境可以覆盖。
DEFAULT_ESP = Path(os.environ.get("PIANO_ESP_DIR", "/boot/efi"))
# 上游 package_release.py 的两种布局。
BLS_PAYLOAD = "linux"
ENTRY_DIR = "loader/entries"
ENTRY_PREFIX = "linux-"
UKI_PAYLOAD = "EFI/Linux"
UKI_PREFIX = "linux-"
# 没有 systemd-boot 的 ESP 属于早期单 UKI 固件，它只打开这一个固定路径。
# 文件名是固件契约，升级只能原地替换。
SINGLE_UKI = "EFI/Linux/sunuefi.efi"
SYSTEMD_BOOT = ("EFI/BOOT/BOOTAA64.EFI", "EFI/systemd/systemd-bootaa64.efi")
# ukify 与 aa64 stub 由 systemd-ukify、systemd-boot-unsigned 提供，RPM 依赖
# 已声明。只有 UKI 布局用得到；BLS 布局不碰这两个工具。
UKIFY = Path(os.environ.get("PIANO_UKIFY", "/usr/lib/systemd/ukify"))
UKI_STUB = Path(os.environ.get("PIANO_UKI_STUB",
                               "/usr/lib/systemd/boot/efi/linuxaa64.efi.stub"))
AUDIT_DIR = Path(os.environ.get("PIANO_KERNEL_ESP_STATE", "/var/lib/piano/kernel-esp"))
BUILD_INITRAMFS = HERE / "build-initramfs.py"
# ukify 写进 PE 段的语义内容。除这六段之外的东西（签名表、PE 头时间戳）不参与
# “内容有没有变”的判断。
UKI_SECTIONS = (".linux", ".initrd", ".dtb", ".cmdline", ".osrel", ".uname")


class EspUpdateError(Exception):
    """可预期的失败：输入不满足或写入无法安全完成。"""


def free_bytes(path):
    stat = os.statvfs(path)
    return stat.f_bavail * stat.f_frsize


def fsync_path(path):
    with Path(path).open("rb") as stream:
        os.fsync(stream.fileno())


def fsync_directory(path):
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        # vfat 上目录 fsync 不保证受支持；文件本身已经 fsync 过，这里只
        # 尽力而为，失败不能把一次成功的替换报成失败。
        pass
    finally:
        os.close(fd)


def replace_atomically(source, target, backup):
    """把 source 换到 target 上，旧 target 先复制成 backup。

    FAT32 没有硬链接，复制是唯一能留下旧文件的方式。峰值占用是
    target + backup + source 三份，所以调用前先算过剩余空间。
    """
    target, backup = Path(target), Path(backup)
    fsync_path(source)
    if target.exists():
        shutil.copyfile(target, backup)
        fsync_path(backup)
    os.replace(source, target)
    fsync_directory(target.parent)


def read_entry(path):
    """读 systemd-boot 的 Type #1 条目；只有键值行，值可以带空格。"""
    fields = {}
    for line in Path(path).read_text(encoding="utf-8", errors="replace").splitlines():
        key, _, value = line.partition(" ")
        if key and key not in fields:
            fields[key] = value
    return fields


def esp_relative(esp, path):
    return esp / path.lstrip("/")


def has_systemd_boot(esp):
    return any((esp / path).is_file() for path in SYSTEMD_BOOT)


def uki_target(esp, release):
    """systemd-boot 枚举版本化文件；单 UKI 固件只认固定路径。"""
    if has_systemd_boot(esp):
        return esp / UKI_PAYLOAD / f"{UKI_PREFIX}{release}.efi"
    return esp / SINGLE_UKI


def current_boot(esp):
    """返回 (布局, 现有启动项, 条目字段)，以 ESP 上实际存在的为准。"""
    entries = sorted((esp / ENTRY_DIR).glob(ENTRY_PREFIX + "*.conf"))
    usable = []
    for entry in entries:
        fields = read_entry(entry)
        if (esp_relative(esp, fields.get("linux", "")).is_file()
                and esp_relative(esp, fields.get("devicetree", "")).is_file()):
            usable.append((entry.stat().st_mtime, entry.name, entry, fields))
    if usable:
        _, _, entry, fields = max(usable)
        return "bls", entry, fields
    # 没有 systemd-boot 时只有固件固定的那个文件算启动项。同目录里别的 UKI
    # 是之前按版本化名字写下的，固件从不读它。
    if not has_systemd_boot(esp):
        fixed = esp / SINGLE_UKI
        if fixed.is_file():
            return "uki", fixed, {}
    ukis = sorted((esp / UKI_PAYLOAD).glob("*.efi"))
    if ukis:
        return "uki", max(ukis, key=lambda p: (p.stat().st_mtime, p.name)), {}
    raise EspUpdateError(
        f"no boot entry or UKI under {esp}; this is not a bootable piano install")


def retain_history(esp, layout, release, previous, dry_run, record):
    """只留当前版本与一套回退，清掉更早的启动项与载荷。

    回退项取更新前正在用的那个 release（BLS 的 version 行，或版本化 UKI 的
    文件名），不按 mtime 猜。只处理能确认属于 piano 的条目：BLS 的 linux
    路径必须正好是 /linux/<version>/linux，UKI 文件名必须是 linux-*.efi。
    """
    history = {"kept": [], "removed": [], "errors": []}
    record["history"] = history
    keep = {release}
    if previous:
        keep.add(previous)
    if layout == "bls":
        for entry in sorted((esp / ENTRY_DIR).glob(ENTRY_PREFIX + "*.conf")):
            fields = read_entry(entry)
            version = fields.get("version")
            if not version or fields.get("linux") != f"/{BLS_PAYLOAD}/{version}/linux":
                continue
            payload = esp / BLS_PAYLOAD / version
            if version in keep:
                history["kept"].append(version)
                continue
            if not payload.is_dir():
                continue
            if dry_run:
                history["removed"].append(version)
                continue
            try:
                entry.unlink()
                shutil.rmtree(payload)
                history["removed"].append(version)
            except OSError as exc:
                history["errors"].append(f"{version}: {exc}")
    elif layout == "uki":
        for uki in sorted((esp / UKI_PAYLOAD).glob(UKI_PREFIX + "*.efi")):
            version = uki.name[len(UKI_PREFIX):-len(".efi")]
            if version in keep:
                history["kept"].append(version)
                continue
            if dry_run:
                history["removed"].append(version)
                continue
            try:
                uki.unlink()
                history["removed"].append(version)
            except OSError as exc:
                history["errors"].append(f"{version}: {exc}")
    return history


def uki_sections(path):
    """按 VirtualSize 读 PE 段，与上游 package_release.py 的校验方式一致。"""
    import pefile
    image = pefile.PE(str(path), fast_load=True)
    try:
        rows = {}
        for section in image.sections:
            name = section.Name.rstrip(b"\0").decode("ascii")
            if name in rows:
                raise EspUpdateError("duplicate UKI section: " + name)
            data = section.get_data()[:section.Misc_VirtualSize]
            if len(data) != section.Misc_VirtualSize:
                raise EspUpdateError("truncated UKI section: " + name)
            rows[name] = data
        return rows
    finally:
        image.close()


def build_uki(image, initramfs, dtb, cmdline, osrel, release, output):
    """按上游 package_release.py 的 section 约定打包，并读回逐段比对。"""
    for tool in (UKIFY, UKI_STUB):
        if not tool.is_file():
            raise EspUpdateError(
                f"missing {tool}; install systemd-ukify and systemd-boot-unsigned")
    with tempfile.TemporaryDirectory(prefix="piano-uki-") as scratch:
        scratch = Path(scratch)
        (scratch / "cmdline").write_bytes(cmdline)
        (scratch / "os-release").write_bytes(osrel)
        result = subprocess.run(
            [sys.executable, str(UKIFY), "--config=/dev/null", "build",
             "--efi-arch=aa64", "--stub", str(UKI_STUB),
             "--linux", str(image), "--initrd", str(initramfs),
             "--devicetree", str(dtb),
             "--cmdline=@" + str(scratch / "cmdline"),
             "--os-release=@" + str(scratch / "os-release"),
             "--uname", release, "--no-sign-kernel", "--output", str(output)],
            capture_output=True, text=True)
        if result.returncode != 0:
            raise EspUpdateError(
                "ukify failed: " + (result.stderr.strip() or result.stdout.strip()))
    expected = {".linux": Path(image).read_bytes(),
                ".initrd": Path(initramfs).read_bytes(),
                ".dtb": Path(dtb).read_bytes(),
                ".cmdline": cmdline, ".osrel": osrel,
                ".uname": release.encode()}
    rows = uki_sections(output)
    for name, data in expected.items():
        if rows.get(name) != data:
            raise EspUpdateError("rebuilt UKI section differs: " + name)
    return {name: {"bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}
            for name, data in rows.items()}


def build_initramfs(root, output, manifest=None):
    if not BUILD_INITRAMFS.is_file():
        raise EspUpdateError(f"missing {BUILD_INITRAMFS}")
    command = [sys.executable, str(BUILD_INITRAMFS), "--installed", "--rootfs", str(root),
               "--output", str(output)]
    # installonly 下新旧内核并存，每份 manifest 名字都不同；不点名的话
    # build-initramfs 会拒绝在多份之间挑一份。
    if manifest is not None:
        command += ["--manifest", str(manifest)]
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise EspUpdateError("initramfs rebuild failed: " + (result.stderr.strip() or result.stdout.strip()))
    return json.loads((output / "manifest.json").read_text())


def update_bls(esp, fields, image, initramfs, dtb, release, dry_run, record):
    """写 BLS 布局：/linux/<release>/ 三个文件加一个 loader 条目。"""
    cmdline = fields.get("options")
    if not cmdline:
        raise EspUpdateError("existing boot entry has no options line")
    payload = {"linux": image, "initrd": initramfs, "board.dtb": dtb}
    target_dir = esp / BLS_PAYLOAD / release
    entry_path = esp / ENTRY_DIR / f"{ENTRY_PREFIX}{release}.conf"
    text = "\n".join((f"title Linux",
                      f"version {release}",
                      f"linux /{BLS_PAYLOAD}/{release}/linux",
                      f"initrd /{BLS_PAYLOAD}/{release}/initrd",
                      f"devicetree /{BLS_PAYLOAD}/{release}/board.dtb",
                      f"options {cmdline}")) + "\n"
    record["layout"] = "bls"
    record["entry"] = str(entry_path)
    record["payload"] = {"path": str(target_dir), "files": {}}
    changed = True
    if target_dir.is_dir() and entry_path.is_file():
        if entry_path.read_text(encoding="utf-8") == text and all(
                (target_dir / name).is_file()
                and sha256(target_dir / name) == sha256(source)
                for name, source in payload.items()):
            changed = False
    record["changed"] = {"payload": changed}
    if not changed:
        for name, source in payload.items():
            record["payload"]["files"][name] = {"sha256": sha256(source),
                                                "bytes": source.stat().st_size}
        retain_history(esp, "bls", release, fields.get("version"), dry_run, record)
        return record
    needed = sum(source.stat().st_size for source in payload.values())
    if free_bytes(esp) < needed:
        raise EspUpdateError(
            f"ESP has {free_bytes(esp)} bytes free, the update needs {needed}")
    if dry_run:
        record["dry_run"] = True
        return record
    staged = target_dir.with_name("." + release + ".new")
    if staged.exists():
        shutil.rmtree(staged)
    staged.mkdir(parents=True)
    for name, source in payload.items():
        staged_file = staged / name
        shutil.copyfile(source, staged_file)
        fsync_path(staged_file)
        if sha256(staged_file) != sha256(source):
            raise EspUpdateError("staged ESP payload differs from its source: " + name)
    # 同 release 重装时先让开旧目录，新目录就位后再删。
    previous = target_dir.with_name("." + release + ".old")
    if target_dir.exists():
        if previous.exists():
            shutil.rmtree(previous)
        target_dir.rename(previous)
    staged.rename(target_dir)
    fsync_directory(target_dir.parent)
    if previous.exists():
        shutil.rmtree(previous)
    # 载荷就位之后才写条目，systemd-boot 不会看到指向半份文件的条目。
    entry_staged = entry_path.with_name("." + entry_path.name + ".new")
    entry_staged.write_text(text, encoding="utf-8")
    fsync_path(entry_staged)
    os.replace(entry_staged, entry_path)
    fsync_directory(entry_path.parent)
    for name, source in payload.items():
        record["payload"]["files"][name] = {"sha256": sha256(target_dir / name),
                                            "bytes": source.stat().st_size}
    retain_history(esp, "bls", release, fields.get("version"), dry_run, record)
    return record


def update_uki(esp, current, image, initramfs, dtb, release, dry_run, record):
    """UKI 布局：重建单个 PE 文件。

    有 systemd-boot 时写版本化文件名，旧 UKI 留着给菜单回退。没有时写固件
    固定读取的 `sunuefi.efi`，原地替换，旧文件留在 `.bak`。
    """
    existing = uki_sections(current)
    missing = [name for name in (".cmdline", ".osrel") if name not in existing]
    if missing:
        raise EspUpdateError("existing ESP UKI lacks " + ", ".join(missing))
    target = uki_target(esp, release)
    record["layout"] = "uki"
    record["uki"] = {"path": str(target)}
    with tempfile.TemporaryDirectory(prefix="piano-esp-") as scratch:
        built_uki = Path(scratch) / target.name
        sections = build_uki(image, initramfs, dtb, existing[".cmdline"],
                             existing[".osrel"], release, built_uki)
        record["uki"]["sections"] = sections
        rebuilt = uki_sections(built_uki)
        present = uki_sections(target) if target.is_file() else {}
        changed = not present or any(
            present.get(name) != rebuilt.get(name) for name in UKI_SECTIONS)
        record["changed"] = {"uki": changed}
        if not changed or dry_run:
            if dry_run:
                record["dry_run"] = True
            if target != esp / SINGLE_UKI:
                previous = (current.name[len(UKI_PREFIX):-len(".efi")]
                            if current.name.startswith(UKI_PREFIX) else None)
                retain_history(esp, "uki", release, previous, dry_run, record)
            return record
        # 替换峰值是新 UKI 与它的 .bak 两份同时存在。
        needed = target.stat().st_size * 2 if target.exists() else built_uki.stat().st_size
        if free_bytes(target.parent) < needed:
            raise EspUpdateError(
                f"ESP has {free_bytes(target.parent)} bytes free, the update needs {needed}")
        staged = target.with_name("." + target.name + ".new")
        shutil.copyfile(built_uki, staged)
        replace_atomically(staged, target, target.with_name(target.name + ".bak"))
    if target != esp / SINGLE_UKI:
        previous = (current.name[len(UKI_PREFIX):-len(".efi")]
                    if current.name.startswith(UKI_PREFIX) else None)
        retain_history(esp, "uki", release, previous, dry_run, record)
    return record


def update(root, esp, release_expected=None, dry_run=False, manifest_name=None):
    root, esp = Path(root), Path(esp)
    layout, current, fields = current_boot(esp)
    manifest, manifest_sha, image = inspect_installed_kernel(root, manifest=manifest_name)
    release = manifest["kernel_release"]
    if release_expected is not None and release != release_expected:
        raise EspUpdateError(
            f"installed kernel release {release} differs from the requested {release_expected}")

    record = {
        "release": release,
        "kernel_manifest_sha256": manifest_sha,
        "image": {"source": str(image), "sha256": sha256(image), "bytes": image.stat().st_size},
        "esp": str(esp),
        "current": str(current),
    }
    with tempfile.TemporaryDirectory(prefix="piano-esp-") as scratch:
        scratch = Path(scratch)
        initramfs_dir = scratch / "initramfs"
        built = build_initramfs(root, initramfs_dir, manifest_name)
        if built["kernel_manifest_sha256"] != manifest_sha:
            raise EspUpdateError("rebuilt initramfs names a different kernel manifest")
        initramfs = initramfs_dir / "initramfs.cpio.gz"
        if layout == "bls":
            dtb = esp_relative(esp, fields["devicetree"])
            update_bls(esp, fields, image, initramfs, dtb, release, dry_run, record)
        else:
            dtb = scratch / "board.dtb"
            dtb.write_bytes(uki_sections(current)[".dtb"])
            update_uki(esp, current, image, initramfs, dtb, release, dry_run, record)

    record["initramfs"] = {
        "sha256": built["initramfs_sha256"],
        "bytes": built["initramfs_bytes"],
        "modules": built["modules"],
    }
    return record


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--root", default="/", help="已安装系统根（默认 /）")
    parser.add_argument("--esp", default=str(DEFAULT_ESP), help="ESP 挂载点（默认 /boot/efi）")
    parser.add_argument("--release", help="断言刚装上的内核 release")
    parser.add_argument("--manifest", help="已安装内核的 manifest 文件名"
                                          "（installonly 下多版本共存时必填）")
    parser.add_argument("--dry-run", action="store_true", help="只校验与重建，不写 ESP")
    args = parser.parse_args(argv)

    try:
        record = update(args.root, args.esp, args.release, args.dry_run, args.manifest)
    except (EspUpdateError, ValueError, OSError, KeyError, ImportError) as exc:
        print(f"piano: kernel ESP update failed: {exc}", file=sys.stderr)
        return 2

    if not record.get("dry_run"):
        AUDIT_DIR.mkdir(parents=True, exist_ok=True)
        (AUDIT_DIR / f"{record['release']}.json").write_text(
            json.dumps(record, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(record, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
