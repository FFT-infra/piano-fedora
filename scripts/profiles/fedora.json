{
  "id": "fedora",
  "backend": "dnf-installroot",
  "arch": "aarch64",
  "container_image": "registry.fedoraproject.org/fedora",
  "base_packages": [
    "@core",
    "systemd",
    "systemd-sysv",
    "systemd-pam",
    "sudo",
    "curl",
    "dbus",
    "dbus-daemon",
    "ca-certificates",
    "NetworkManager",
    "NetworkManager-wifi",
    "NetworkManager-tui",
    "openssh-server",
    "openssh-clients",
    "wpa_supplicant",
    "iw",
    "kmod",
    "util-linux",
    "busybox",
    "python3",
    "f2fs-tools",
    "selinux-policy-targeted",
    "policycoreutils",
    "libselinux-utils",
    "bluez",
    "qrtr",
    "rmtfs",
    "tqftpserv",
    "fastrpc",
    "qbootctl",
    "alsa-utils",
    "alsa-ucm",
    "rtkit",
    "polkit",
    "cracklib-dicts",
    "lm_sensors",
    "libcamera",
    "libcamera-ipa",
    "pipewire-plugin-libcamera",
    "sane-backends-drivers-cameras",
    "ffmpeg-free",
    "libavdevice-free",
    "libheif-ffmpeg",
    "libultrahdr",
    "ImageMagick",
    "ImageMagick-libs",
    "exiv2",
    "libcaca",
    "libavc1394",
    "libdc1394",
    "libklvanc",
    "gstreamer1-plugins-good-qt6",
    "adwaita-sans-fonts",
    "adwaita-mono-fonts",
    "open-sans-fonts",
    "google-noto-emoji-fonts",
    "julietaula-montserrat-fonts",
    "gdouros-symbola-fonts",
    "langpacks-core-en",
    "langpacks-en",
    "langpacks-fonts-en",
    "firefox-langpacks",
    "gnome-software-fedora-langpacks",
    "evolution-ews-langpacks",
    "gawk-all-langpacks",
    "hunspell-en",
    "hunspell-en-AU",
    "hunspell-en-CA",
    "hunspell-en-GB",
    "ibus-setup",
    "langtable",
    "python3-langtable",
    "7zip",
    "bat",
    "jq",
    "wcurl",
    "wl-clipboard",
    "antiword",
    "cifs-utils-info",
    "hdparm",
    "less-color",
    "kpartx",
    "nilfs-utils",
    "ntfs-3g-system-compression",
    "opencsd",
    "udftools",
    "xfsprogs",
    "libvirt-daemon",
    "qemu-kvm-core",
    "virt-what"
  ],
  "dnf_options": [
    "--use-host-config",
    "--exclude=kernel*",
    "--setopt=install_weak_deps=False",
    "--setopt=tsflags=nodocs"
  ]
}
