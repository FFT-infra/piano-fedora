{
  "gnome": {
    "label": "GNOME",
    "buildable": true,
    "dnf_packages": [
      "@workstation-product-environment",
      "gnome-shell",
      "gnome-session",
      "gdm",
      "nautilus",
      "gnome-control-center",
      "dconf",
      "pipewire",
      "wireplumber",
      "iio-sensor-proxy"
    ],
    "repos": [],
    "exclude_packages": ["iio-sensor-proxy"],
    "required_packages": ["gdm", "gnome-shell"],
    "root_size_mib": 8192,
    "display_manager": {
      "unit": "gdm.service",
      "package": "gdm",
      "autologin": {"kind": "gdm-custom-conf"},
      "dependency_dropin": {"unit": "gdm.service", "after": "piano-display.service"}
    },
    "session": {
      "desktop_names": ["GNOME"],
      "process_names": ["gnome-shell"],
      "session_files": ["/usr/share/wayland-sessions/gnome.desktop"],
      "bins": ["/usr/bin/gnome-shell"]
    },
    "power_policy": {
      "kind": "dconf",
      "source": "packages/piano-fedora-configs/etc/dconf/db/local.d/00-power"
    }
  },
  "kde": {
    "label": "KDE Plasma",
    "buildable": true,
    "dnf_packages": [
      "@kde-desktop-environment",
      "plasma-desktop",
      "plasma-workspace",
      "plasma-login-manager",
      "dolphin",
      "konsole",
      "pipewire",
      "wireplumber",
      "iio-sensor-proxy"
    ],
    "repos": [],
    "exclude_packages": ["iio-sensor-proxy"],
    "required_packages": ["plasma-login-manager", "plasma-workspace"],
    "root_size_mib": 8192,
    "display_manager": {
      "unit": "plasmalogin.service",
      "package": "plasmalogin",
      "autologin": {"kind": "plasmalogin-autologin", "session": "plasma"},
      "dependency_dropin": {"unit": "plasmalogin.service", "after": "piano-display.service"}
    },
    "session": {
      "desktop_names": ["KDE"],
      "process_names": ["plasmashell", "kwin_wayland"],
      "session_files": ["/usr/share/wayland-sessions/plasma.desktop"],
      "bins": ["/usr/bin/plasmashell", "/usr/bin/startplasma-wayland"]
    },
    "power_policy": {
      "kind": "kconfig",
      "source": "scripts/profiles/desktops/kde/powerdevilrc",
      "target": "etc/xdg/powerdevilrc"
    }
  },
  "niri": {
    "label": "niri",
    "buildable": true,
    "dnf_packages": [
      "niri",
      "greetd",
      "tuigreet",
      "xwayland-satellite",
      "xdg-desktop-portal-wlr",
      "fuzzel",
      "foot",
      "mako",
      "swaybg",
      "waybar",
      "brightnessctl",
      "pipewire",
      "wireplumber",
      "iio-sensor-proxy"
    ],
    "repos": [],
    "exclude_packages": ["iio-sensor-proxy"],
    "required_packages": ["niri", "greetd"],
    "root_size_mib": 8192,
    "display_manager": {
      "unit": "greetd.service",
      "package": "greetd",
      "autologin": {"kind": "greetd-config", "command": "niri-session"},
      "dependency_dropin": {"unit": "greetd.service", "after": "piano-display.service"}
    },
    "session": {
      "desktop_names": ["niri"],
      "process_names": ["niri"],
      "session_files": ["/usr/share/wayland-sessions/niri.desktop"],
      "bins": ["/usr/bin/niri", "/usr/bin/niri-session"]
    },
    "power_policy": {"kind": "logind-only"}
  },
  "hyprland": {
    "label": "Hyprland",
    "buildable": true,
    "dnf_packages": [
      "hyprland",
      "hyprlock",
      "hypridle",
      "hyprpaper",
      "hyprpolkitagent",
      "hyprland-uwsm",
      "xdg-desktop-portal-hyprland",
      "xdg-desktop-portal-gtk",
      "greetd",
      "tuigreet",
      "fuzzel",
      "foot",
      "mako",
      "waybar",
      "brightnessctl",
      "pipewire",
      "wireplumber",
      "iio-sensor-proxy"
    ],
    "repos": [
      {
        "id": "copr-hyprland",
        "baseurl": "https://download.copr.fedorainfracloud.org/results/lionheartp/Hyprland/fedora-$releasever-$basearch/",
        "gpgkey": "https://download.copr.fedorainfracloud.org/results/lionheartp/Hyprland/pubkey.gpg",
        "gpgkey_sha256": "9f47c74eec4fea0f5a8cee1c6532bbeb33eee8134f762314bf16815a720dc047",
        "priority": 5
      }
    ],
    "exclude_packages": ["iio-sensor-proxy"],
    "required_packages": ["hyprland", "greetd"],
    "root_size_mib": 8192,
    "display_manager": {
      "unit": "greetd.service",
      "package": "greetd",
      "autologin": {"kind": "greetd-config", "command": "start-hyprland"},
      "dependency_dropin": {"unit": "greetd.service", "after": "piano-display.service"}
    },
    "session": {
      "desktop_names": ["Hyprland"],
      "process_names": ["Hyprland", "hyprland"],
      "session_files": ["/usr/share/wayland-sessions/hyprland.desktop"],
      "bins": ["/usr/bin/Hyprland", "/usr/bin/start-hyprland", "/usr/bin/hyprctl"]
    },
    "power_policy": {"kind": "logind-only"}
  },
  "denial": {
    "label": "Denial (placeholder)",
    "buildable": false,
    "dnf_packages": null,
    "repos": [],
    "exclude_packages": [],
    "required_packages": [],
    "root_size_mib": 0,
    "display_manager": null,
    "session": {
      "desktop_names": [],
      "process_names": [],
      "session_files": [],
      "bins": []
    },
    "power_policy": {"kind": "logind-only"}
  },
  "server": {
    "label": "Server (no desktop)",
    "buildable": true,
    "dnf_packages": [],
    "repos": [],
    "exclude_packages": [],
    "required_packages": ["systemd"],
    "root_size_mib": 4096,
    "display_manager": null,
    "session": {
      "desktop_names": [],
      "process_names": [],
      "session_files": [],
      "bins": []
    },
    "power_policy": {"kind": "logind-only"}
  }
}
