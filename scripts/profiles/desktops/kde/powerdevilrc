# System-wide PowerDevil defaults for the piano KDE image.
#
# Power button and lid turn the screen off and lock the session, the way the
# stock tablet firmware behaves. Neither suspends: the machine stays running
# so the next press repaints immediately, and `AutoSuspendAction` stays NoAction
# in all three profiles. Stock PowerDevil would put the machine to sleep here,
# which is a laptop policy and not what this device's owner expects.
#
# Group layout and key names come from powerdevil 6.8.1's
# PowerDevilProfileSettings.kcfg (groups are [$ProfileId][$Group], profile ids
# are AC / Battery / LowBattery). Action values are PowerButtonAction from
# daemon/powerdevilenums.h: NoAction=0, Sleep=1, Hibernate=2, Shutdown=8,
# PromptLogoutDialog=16, LockScreen=32, TurnOffScreen=64.
#
# Power key is handled here, not by a helper: the piano-power-button user
# service in piano-fedora-configs is GNOME-only and is not enabled on this
# desktop.
# Idle: blank and lock after 300 s, matching idle-delay=uint32 300 and
# lock-enabled=true.

[AC][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=64
PowerDownAction=0
LidAction=64
SleepMode=1

[AC][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=300
LockBeforeTurnOffDisplay=true

[Battery][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=64
PowerDownAction=0
LidAction=64
SleepMode=1

[Battery][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=300
LockBeforeTurnOffDisplay=true

[LowBattery][SuspendAndShutdown]
AutoSuspendAction=0
PowerButtonAction=64
PowerDownAction=0
LidAction=64
SleepMode=1

[LowBattery][Display]
DimDisplayWhenIdle=false
TurnOffDisplayWhenIdle=true
TurnOffDisplayIdleTimeoutSec=300
LockBeforeTurnOffDisplay=true
