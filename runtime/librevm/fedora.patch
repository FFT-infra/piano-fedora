diff --git a/scripts/librevm-gui-session b/scripts/librevm-gui-session
--- a/scripts/librevm-gui-session
+++ b/scripts/librevm-gui-session
@@ -21,8 +21,10 @@
 # Logging must never be able to kill the launch: the shell runs this as the desktop
 # user, and a root-owned log file cannot be appended to by that user. Test first,
 # and fall back to somewhere always writable.
-PREFERRED=/var/log/librevm-gui.log
-FALLBACK=/tmp/librevm-gui.log
+STATE=${XDG_STATE_HOME:-$HOME/.local/state}/librevm
+mkdir -p "$STATE" || exit 1
+PREFERRED=$STATE/gui.log
+FALLBACK=$STATE/gui-fallback.log
 
 if ( : >> "$PREFERRED" ) 2>/dev/null; then
     LOG=$PREFERRED
