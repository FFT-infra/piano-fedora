#!/bin/busybox sh
#
# Minimal Gunyah guest acceptance init.
#
# Goal: reach userspace, prove the virtio data plane, then power off -- with a
# marker that carries a nonce and a digest so a PASS cannot be faked by the host
# merely echoing words.
#
# Emits, on the serial console:
#   VMACCEPT MAGIC=<nonce> DISK_SHA=<sha of the nonce file read back> DISK_OK=1 \
#            NET_RX=<n> NET_OK=1
#   VMACCEPT-DONE
#
# The host harness (assert-guest-acceptance.py) requires both lines, requires
# DISK_SHA to equal sha256("<nonce>\n"), requires NET_RX to be a positive
# integer when a TAP was attached, requires the nonce to match, and requires
# crosvm to exit 0. Anything less is a fail.

/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sys /sys
/bin/busybox mount -t devtmpfs dev /dev 2>/dev/null || /bin/busybox mount -t tmpfs tmp /dev
/bin/busybox mkdir -p /dev/pts /dev/shm
/bin/busybox mount -t devpts devpts /dev/pts 2>/dev/null

echo "VMACCEPT: kernel reached userspace, hostname=$(hostname 2>/dev/null)"
echo "VMACCEPT: uname $(uname -r)"

MODDIR=/lib/modules/$(uname -r)

# Load a module by name from the flat tree. Returns non-zero if the module file
# is absent or insmod fails, so the caller can tell "missing" from "loaded".
load() {
  m=$(find "$MODDIR" -name "$1.ko" | head -1)
  [ -n "$m" ] || { echo "VMACCEPT: module $1 not found"; return 1; }
  /bin/busybox insmod "$m" 2>/dev/null && return 0
  # insmod can fail with "File exists" when already loaded; treat that as ok.
  grep -q "^$1 " /proc/modules && return 0
  echo "VMACCEPT: insmod $1 failed"
  return 1
}

# Transport is virtio-PCI: crosvm's aarch64 build has no virtio-mmio path
# (grep finds no VirtioMmio), and its FDT advertises a pci-host-cam-generic node.
# So virtio_pci is what binds; virtio_mmio is not needed and not loaded.
#
# virtio_blk: no module deps.
# virtio_net: depends on net_failover, which depends on failover.
# ext4: depends on jbd2, mbcache, crc16, and has softdep "pre: crc32c"
#       (modinfo: softdep=pre: crc32c, depends=jbd2,mbcache,crc16). jbd2 also
#       warns "Cannot load crc32c driver" without it, so crc32c_generic loads
#       first. CONFIG_CRYPTO_CRC32C=m in this guest kernel.
load crc32c_generic
load failover
load net_failover
load virtio_blk
load virtio_net
load crc16
load mbcache
load jbd2
load ext4

# ---- virtio-blk: write, sync, unmount, remount ro, then read back ----------
#
# The nonce arrives on the kernel command line as "vmaccept.nonce=<hex>", set by
# the host harness. Nothing in the guest can invent it.
NONCE=$(cat /proc/cmdline | tr ' ' '\n' | sed -n 's/^vmaccept\.nonce=//p')
[ -n "$NONCE" ] || NONCE="unset"

DISK_OK=0
DISK_SHA=none

# Wait for the disk to appear (the driver may probe after init runs).
i=0
while [ ! -b /dev/vda ] && [ $i -lt 50 ]; do /bin/busybox sleep 0.1; i=$((i+1)); done

if [ -b /dev/vda ]; then
  echo "VMACCEPT: /dev/vda present"
  # The harness pre-formats a fresh 64 MiB ext4 image (busybox has no mkfs.ext4).
  # Every step is checked: a failed umount or a failed ro-remount must NOT be
  # allowed to fall through to a read-back that is really still the rw mount.
  if /bin/busybox mount -t ext4 /dev/vda /mnt/disk 2>/dev/null; then
    if printf '%s\n' "$NONCE" > /mnt/disk/nonce.txt && /bin/busybox sync; then
      if /bin/busybox umount /mnt/disk; then
        if /bin/busybox mount -t ext4 -o ro /dev/vda /mnt/disk 2>/dev/null; then
          # Confirm the remount is actually read-only before trusting the read:
          # the /mnt/disk line's option field must contain "ro".
          RO=$(awk '$2=="/mnt/disk"{n=split($4,a,","); for(i=1;i<=n;i++) if(a[i]=="ro") print "ro"}' /proc/mounts)
          if [ "$RO" = "ro" ]; then
            READBACK=$(cat /mnt/disk/nonce.txt 2>/dev/null)
            DISK_SHA=$(sha256sum /mnt/disk/nonce.txt 2>/dev/null | cut -d' ' -f1)
            if [ "$READBACK" = "$NONCE" ] && [ -n "$DISK_SHA" ]; then
              DISK_OK=1
            fi
          else
            echo "VMACCEPT: remount is not ro; refusing to claim DISK_OK"
          fi
          /bin/busybox umount /mnt/disk
        else
          echo "VMACCEPT: ro remount failed"
        fi
      else
        echo "VMACCEPT: umount after write failed; not reading back"
        /bin/busybox umount /mnt/disk 2>/dev/null
      fi
    else
      echo "VMACCEPT: write or sync to /mnt/disk failed"
      /bin/busybox umount /mnt/disk 2>/dev/null
    fi
  else
    echo "VMACCEPT: ext4 mount failed on /dev/vda"
  fi
else
  echo "VMACCEPT: no /dev/vda (virtio-blk missing)"
fi

# ---- virtio-net: host<->guest reachability ---------------------------------
#
# The host side is a TAP on 10.9.0.1/24 (created by setup-vmaccept-tap.sh). The
# guest takes 10.9.0.2/24 and pings the host. A reply proves both directions of
# the virtio-net data path. No DHCP, no NAT, no firewall change.
NET_OK=0
NET_RX=0

# Addresses come from the kernel command line so the same initramfs works with
# any host subnet the manager picked; the 10.9.0.x pair stays the default for
# the standalone run-guest-acceptance.sh harness.
GI=$(cat /proc/cmdline | tr ' ' '\n' | sed -n 's/^vmaccept\.guest=//p')
GW=$(cat /proc/cmdline | tr ' ' '\n' | sed -n 's/^vmaccept\.gw=//p')
[ -n "$GI" ] || GI=10.9.0.2
[ -n "$GW" ] || GW=10.9.0.1

if [ -e /sys/class/net/eth0 ]; then
  ip link set eth0 up 2>/dev/null
  ip addr add "$GI"/24 dev eth0 2>/dev/null
  ip route add default via "$GW" dev eth0 2>/dev/null
  if ping -c 2 -W 3 "$GW" >/tmp/ping.out 2>&1; then
    # A bare positive integer: the packet count the host replied to.
    NET_RX="$(grep -oE '[0-9]+ packets received' /tmp/ping.out | head -1 | cut -d' ' -f1)"
    case "$NET_RX" in
      ''|*[!0-9]*) NET_RX=0 ;;
    esac
    [ "$NET_RX" -gt 0 ] && NET_OK=1
  else
    echo "VMACCEPT: ping host failed"
    cat /tmp/ping.out 2>/dev/null
  fi
else
  echo "VMACCEPT: no eth0 (virtio-net missing)"
fi

# ---- the one marker the host accepts ---------------------------------------
echo "VMACCEPT MAGIC=$NONCE DISK_SHA=$DISK_SHA DISK_OK=$DISK_OK NET_RX=$NET_RX NET_OK=$NET_OK"
echo "VMACCEPT-DONE"

/bin/busybox sync
echo "VMACCEPT: powering off"
# Absolute path so a missing PATH entry cannot leave the guest hanging (which
# would time out crosvm and fail the run). -f goes straight to the reboot
# syscall, which Gunyah turns into a clean VM exit.
/bin/busybox poweroff -f 2>/dev/null || /bin/busybox reboot -f
