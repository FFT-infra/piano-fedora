module piano_hardware 1.2;

# Policy for the piano port's own services. They run in init_t (no dedicated
# domain yet: the image has no selinux-policy-devel, so no domain macros).
# Each rule maps to an AVC observed on the device; nothing else is granted.
# Follow-up: give these binaries their own domain once devel is available.

require {
	type init_t;
	type v4l_device_t;
	type proc_t;
	type unlabeled_t;
	type iiosensorproxy_t;
	type syslogd_t;
	type ssh_home_t;
	type fprintd_t;
	type userio_device_t;
	type scsi_generic_device_t;
	type var_t;
	type device_t;
	class chr_file { open read write ioctl map };
	class file { create write open getattr append read };
	class dir { add_name write search getattr read };
	class unix_dgram_socket { sendto };
	class capability { sys_rawio };
	class qipcrtr_socket { create bind read write getattr getopt setopt };
}

# piano-camerad writes ISP frames into the v4l2loopback cameras (video40/41).
allow init_t v4l_device_t:chr_file { open read write ioctl map };

# touch-input toggles the stylus interface through /proc/nvt_thp_stylus.
allow init_t proc_t:file { create write open getattr };

# Piano bring-up scripts write their bytecode cache next to their own files,
# which live on an unlabeled path in the image.
allow init_t unlabeled_t:dir { add_name write };
allow init_t unlabeled_t:file { create write open getattr };

# piano-first-boot-ssh-key.service imports the installer's public key into
# /home/piano/.ssh/authorized_keys. The ESP side is mounted boot_t, but the
# destination is ssh_home_t, and init_t has no write access there: the unit
# failed with "authorized_keys: Permission denied" and the device log showed
# AVC denied { append } tcontext=ssh_home_t. The key therefore stayed on the
# ESP and an install with --ssh-key still could not log in by public key.
allow init_t ssh_home_t:file { create write open getattr append read };
allow init_t ssh_home_t:dir { search getattr add_name write };

# iio-sensor-proxy logs to the journal.
allow iiosensorproxy_t syslogd_t:unix_dgram_socket { sendto };

# The SSC backend discovers and reads ADSP sensors over the QRTR datagram bus.
# The systemd address-family allowlist already includes AF_QIPCRTR; the Fedora
# domain still needs its own socket permissions (device AVC: create denied).
allow iiosensorproxy_t self:qipcrtr_socket { create bind read write getattr getopt setopt };

# fprintd 的 Goodix 驱动通过命名 UIO 控制器与 TEE 会话读写模板，还要用 bsg
# 发 RPMB 命令取密钥材料。上游的 20-piano.conf 只放开 cgroup 的 DeviceAllow，
# SELinux 侧在镜像里没有对应规则，enforcing 下 enroll 直接 EACCES。
# tee0 在内核里没有专用标签（默认 device_t）。20-piano.conf 的 DeviceAllow
# 已经把 cgroup 侧收在 char-uio/char-tee/char-bsg 三种设备上，SELinux 这边
# 对 device_t 的放行不会扩大到别的设备节点。
allow fprintd_t device_t:chr_file { open read write ioctl };
allow fprintd_t userio_device_t:chr_file { open read write ioctl map };
allow fprintd_t scsi_generic_device_t:chr_file { open read write ioctl };
allow fprintd_t self:capability sys_rawio;
# 打开 /var/lib/piano-goodix 之前 libfprint 会 stat 一遍 /var。
allow fprintd_t var_t:dir read;
