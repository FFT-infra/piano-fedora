+/*
+ * Without a FRAME_SYNC subscription the strobe path above cannot time a pulse.
+ * The still then lights both rear channels as a torch instead, so auto
+ * exposure meters the scene under the light that will make the frame.
+ */
+#define STILL_WARMUP	8	/* frames before the copy */
+#define STILL_FLASH_LIMIT 90	/* torch: auto exposure may need a few seconds */
+
+static int camera_torch_start(struct cam *c)
+{
+	int ret = camera_flash_open(c), error = 0;
+
+	if (ret < 0)
+		return ret;
+	for (unsigned int i = 0; i < c->flash_count && !error; i++) {
+		struct camera_flash *flash = &c->flash[i];
+		struct v4l2_query_ext_ctrl range = { .id = V4L2_CID_FLASH_INTENSITY };
+
+		/* Cleanup must turn this channel off even if a call below fails. */
+		flash->configured = true;
+		if (xioctl(flash->fd, VIDIOC_QUERY_EXT_CTRL, &range) == 0 &&
+		    range.maximum <= INT_MAX)
+			ctrl_set(flash->fd, V4L2_CID_FLASH_INTENSITY, (int)range.maximum);
+		if (ctrl_set(flash->fd, V4L2_CID_FLASH_LED_MODE,
+			     V4L2_FLASH_LED_MODE_TORCH) < 0)
+			error = errno;
+	}
+	if (error) {
+		uint64_t stop_ns;
+		uint32_t fault;
+
+		(void)camera_flash_stop(c, &stop_ns, &fault);
+		return -error;
+	}
+	return 0;
+}
+
+/*
+ * A still outside the strobe path: run the largest native PIX mode, let auto
+ * exposure adapt for a few frames, copy one packed NV12 frame and put the
+ * preview back. Used for the front camera and for rear shots on a kernel
+ * without FRAME_SYNC, where the strobe request above is not available.
+ * The reply is sent here; a negative return leaves client_fd to the caller.
+ */
+static int camera_still_request(struct cam *c, bool flash, int client_fd)
+{
+	const struct cam_cfg preview = c->mode;
+	const struct capture_mode *native = &preview.modes[0];
+	const unsigned int limit = flash ? STILL_FLASH_LIMIT : 2 * STILL_WARMUP;
+	struct piano_photo_result result = {
+		.magic = PIANO_PHOTO_MAGIC, .version = PIANO_PHOTO_VERSION,
+		.flags = PIANO_PHOTO_PHYSICAL_EOF | PIANO_PHOTO_STILL_FRAME,
+	};
+	bool was_streaming = c->streaming;
+	unsigned int frames = 0;
+	uint32_t fault = 0;
+	int ret = -ETIMEDOUT, fd = -1;
+
+	if (c->quad_raw || piano_photo_active(&c->photo))
+		return -EBUSY;
+	if (was_streaming && cam_stop(c) < 0)
+		return -EIO;
+	c->mode.in_w = c->mode.max_out_w = native->width;
+	c->mode.in_h = c->mode.max_out_h = native->height;
+	c->mode.out_w = native->width;
+	c->mode.out_h = native->height;
+	c->mode.fps = native->fps;
+	if (cam_start(c) < 0) {
+		ret = -EIO;
+		goto restore;
+	}
+	if (flash) {
+		ret = camera_torch_start(c);
+		if (ret < 0)
+			goto restore;
+	}
+	while (frames < limit) {
+		struct v4l2_plane pl[VIDEO_MAX_PLANES] = { 0 };
+		struct v4l2_buffer b = {
+			.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
+			.memory = V4L2_MEMORY_MMAP,
+			.length = VIDEO_MAX_PLANES,
+			.m.planes = pl,
+		};
+		struct pollfd pfd = { .fd = c->vid_fd, .events = POLLIN };
+		const uint8_t *y;
+		int ready;
+
+		do {
+			ready = poll(&pfd, 1, 3000);
+		} while (ready < 0 && errno == EINTR);
+		if (ready <= 0)
+			break;
+		if (xioctl(c->vid_fd, VIDIOC_DQBUF, &b) < 0) {
+			if (errno == EAGAIN)
+				continue;
+			break;
+		}
+		if (!(b.flags & V4L2_BUF_FLAG_ERROR) && b.index < c->nbufs &&
+		    b.length == 1 && c->bufs[b.index].ptr &&
+		    pl[0].data_offset <= pl[0].bytesused &&
+		    c->frame_span <= pl[0].bytesused - pl[0].data_offset) {
+			y = (const uint8_t *)c->bufs[b.index].ptr + pl[0].data_offset;
+			if (flash || frames % AE_PERIOD == 0) {
+				struct stats s;
+
+				frame_stats(c, y, y + c->uv_offset, c->bpl, &s);
+				control_update(c, &s);
+			}
+			af_update(c, y, c->bpl);
+			/* Under the torch the scene changes with the light, so let auto
+			 * exposure settle before copying, within the frame budget.
+			 */
+			if (++frames > STILL_WARMUP &&
+			    (!flash || frames >= limit || camera_photo_ready(c))) {
+				/* Fill the record before the restore below resets
+				 * the stream geometry.
+				 */
+				result.width = result.native_width = c->cfg->out_w;
+				result.height = result.native_height = c->cfg->out_h;
+				result.stride = result.width;
+				result.capture_stride = c->bpl;
+				result.pixelformat = V4L2_PIX_FMT_NV12;
+				result.colorspace = c->colorspace;
+				result.ycbcr_enc = c->ycbcr_enc;
+				result.quantization = c->quantization;
+				result.sequence = b.sequence;
+				result.data_bytes = (uint64_t)result.width * result.height * 3 / 2;
+				result.eof_ns = monotonic_ns();
+				fd = piano_photo_image(y, y + c->uv_offset,
+						       c->cfg->out_w, c->cfg->out_h,
+						       c->bpl);
+				ret = fd < 0 ? fd : 0;
+			}
+		}
+		if (xioctl(c->vid_fd, VIDIOC_QBUF, &b) < 0)
+			logmsg(c, "still: QBUF: %s", strerror(errno));
+		if (frames > STILL_WARMUP && (fd >= 0 || frames >= limit))
+			break;
+	}
+restore:
+	cam_stop(c);
+	if (flash) {
+		uint64_t stop_ns;
+
+		(void)camera_flash_stop(c, &stop_ns, &fault);
+		if (!ret && fault)
+			ret = -EIO;
+	}
+	c->mode = preview;
+	if (was_streaming && cam_start(c) < 0)
+		logmsg(c, "still: preview did not come back: %s", strerror(errno));
+	if (ret < 0) {
+		logmsg(c, "still: %s", strerror(-ret));
+		return ret;
+	}
+	ret = piano_photo_send(client_fd, &result, fd);
+	if (ret < 0)
+		logmsg(c, "still reply: %s", strerror(-ret));
+	close(client_fd);
+	if (fd >= 0)
+		close(fd);
+	logmsg(c, "still %ux%u%s (%u frames)", result.width, result.height,
+	       flash ? " with torch" : "", frames);
+	return 0;
+}
+
