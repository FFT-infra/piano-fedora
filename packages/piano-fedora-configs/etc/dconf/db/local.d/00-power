# Deliberate divergence from SunUEFI's linux/desktops/gnome/power-overlay copy:
# that one suspends after 10 min on AC and 5 min on battery, and suspend/resume
# on this device is still unreliable. Both sleep-inactive types stay 'nothing'
# and idle blanking is 300 s. verify_power_overlay() in
# scripts/finalize-fedora-rootfs.py enforces these values; re-review them before
# syncing anything back from upstream.
[org/gnome/settings-daemon/plugins/media-keys]
power-static=['']

[org/gnome/settings-daemon/plugins/power]
power-button-action='nothing'
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'

[org/gnome/desktop/session]
idle-delay=uint32 300

[org/gnome/desktop/screensaver]
lock-enabled=true
lock-delay=uint32 0
