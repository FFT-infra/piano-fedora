[Unit]
Description=Piano power key and cover screen locking
PartOf=graphical-session.target
After=graphical-session.target
# 两个助手的 vendor wants 链接都由包提供，条件决定当前会话跑哪一个。
# systemd 按字面比较这个值，不支持 glob；GNOME 会话（gnome.desktop）在用户
# 管理器里写的正是 GNOME。真机若读不到这个变量，退回在 %post 里按
# display-manager 的真实路径只建对应链接。
ConditionEnvironment=XDG_CURRENT_DESKTOP=GNOME

[Service]
# /usr/lib/piano 下的脚本是 lib_t，直接执行时进程读不到 /dev/input/event*
# （2026-11-05 在平板上实测 event3 报 PermissionError）。经 bin_t 的 python3
# 启动才会落到能读输入设备的域，和 piano-fake-tablet-mode 一致。
ExecStart=/usr/bin/python3 /usr/lib/piano/power-button
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
