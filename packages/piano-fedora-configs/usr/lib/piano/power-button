"""Piano power key and real SW_LID, run as a root system service.

The mechanism follows mumuxiao722's sheng-power-key-toggle (sheng-gnome-fix):
the service exclusively grabs the power key so the desktop never sees a
suspend/wake request, blanks the panel through Mutter's PowerSaveMode, locks
the seat with loginctl, and injects KEY_WAKEUP through uinput so the
compositor repaints on wake. Running as root is what makes `loginctl
lock-sessions` work without a polkit prompt.

Brightness is only used when there is no Mutter to talk to. GNOME 49+ owns
the backlight, and with auto brightness active the shell re-applies
min + (max - min) * (abTarget + value - 0.5) a few milliseconds after any
external write, so a brightness of 0 comes back as ~17% and the panel keeps
glowing. Other desktops keep the backlight path.
"""
import fcntl
import glob
import os
import pwd
import select
import struct
import subprocess
import sys
import time

KEY_NAME = 'pmic_pwrkey'
LID_NAME = 'soc:piano-hall-ml'
KEY_POWER = 116
SW_LID = 0
EV_KEY, EV_SW, EV_SYN, SYN_DROPPED = 1, 5, 0, 3
LONG_PRESS = 0.8
EVIOCGRAB = 0x40044590
# _IOR('E', 0x1b, an eight-byte bitmap): read the current switch state.
EVIOCGSW = (2 << 30) | (8 << 16) | (ord('E') << 8) | 0x1b
EVENT = struct.Struct('llHHi')
POWER_SAVE_OFF = 3
POWER_SAVE_ON = 0
LOGINCTL = '/usr/bin/loginctl'
RUNUSER = '/usr/sbin/runuser'
GDBUS = '/usr/bin/gdbus'

# UInput cannot be recreated cheaply and must outlive the call that made it.
_wakeup_device = None


def say(message):
    print('power-button: ' + message, file=sys.stderr, flush=True)


def find_device(name):
    for path in glob.glob('/sys/class/input/event*/device/name'):
        try:
            with open(path) as stream:
                if stream.read().strip() == name:
                    return '/dev/input/' + path.split('/')[4]
        except OSError:
            continue
    return None


def find_backlight():
    names = sorted(os.listdir('/sys/class/backlight'))
    return names[0] if names else None


def brightness(backlight):
    with open(f'/sys/class/backlight/{backlight}/brightness') as stream:
        return int(stream.read())


def max_brightness(backlight):
    try:
        with open(f'/sys/class/backlight/{backlight}/max_brightness') as stream:
            return int(stream.read())
    except (OSError, ValueError):
        return 255


def call(args, operation, timeout=4):
    try:
        result = subprocess.run(args, stdout=subprocess.DEVNULL, check=False, timeout=timeout)
        if result.returncode == 0:
            return True
        say(f'{operation} failed ({result.returncode})')
    except (OSError, subprocess.TimeoutExpired) as error:
        say(f'{operation} failed: {error}')
    return False


def capture(args, timeout=3):
    """跑一条查询命令，成功返回 stdout，失败返回 None。"""
    try:
        result = subprocess.run(args, capture_output=True, text=True, check=False,
                                timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    return result.stdout


def active_session():
    """返回活跃图形会话的 (session_id, uid, username)，没有则 None。

    greeter 和 tty 会话都不算：它们没有 `Type=wayland`，而且 gdm 那个会话的
    用户不是机主。服务和会话是两个 cgroup，只能这样从 logind 里挑。
    """
    listed = capture([LOGINCTL, 'list-sessions', '--no-legend'])
    if not listed:
        return None
    for line in listed.splitlines():
        parts = line.split()
        if not parts:
            continue
        detail = capture([LOGINCTL, 'show-session', parts[0],
                          '-p', 'Active', '-p', 'Type', '-p', 'User', '-p', 'Class'])
        if not detail:
            continue
        props = dict(row.partition('=')[::2] for row in detail.splitlines())
        if props.get('Active') != 'yes' or props.get('Type') not in ('wayland', 'x11'):
            continue
        if props.get('Class') != 'user':
            continue
        try:
            uid = int(props.get('User', ''))
            username = pwd.getpwuid(uid).pw_name
        except (KeyError, ValueError):
            continue
        return parts[0], uid, username
    return None


def session_call(session, args, operation, timeout=4):
    """以会话用户的身份调用会话总线上的命令。"""
    if session is None:
        say(f'{operation} skipped: no graphical session')
        return False
    _, uid, username = session
    return call([RUNUSER, '-u', username, '--', 'env',
                 f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus',
                 f'XDG_RUNTIME_DIR=/run/user/{uid}', *args], operation, timeout)


def mutter_power_save_mode(session):
    """获取 Mutter 当前的 PowerSaveMode（0=开, 3=关/黑屏, None=非 GNOME 或查询失败）。"""
    if session is None:
        session = active_session()
    if session is None:
        return None
    _, uid, username = session
    output = capture([RUNUSER, '-u', username, '--', 'env',
                      f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus',
                      GDBUS, 'call', '--session',
                      '--dest', 'org.gnome.Mutter.DisplayConfig',
                      '--object-path', '/org/gnome/Mutter/DisplayConfig',
                      '--method', 'org.freedesktop.DBus.Properties.Get',
                      'org.gnome.Mutter.DisplayConfig', 'PowerSaveMode'], timeout=2)
    if output:
        words = output.replace('(', '').replace(')', '').replace('<', '') \
                      .replace('>', '').replace(',', '').split()
        if words:
            try:
                return int(words[-1])
            except ValueError:
                return None
    return None


def set_mutter_power_save_mode(session, mode):
    """GNOME：3 关闭显示输出，0 打开。返回是否成功。"""
    return session_call(session, [GDBUS, 'call', '--session',
                                  '--dest', 'org.gnome.Mutter.DisplayConfig',
                                  '--object-path', '/org/gnome/Mutter/DisplayConfig',
                                  '--method', 'org.freedesktop.DBus.Properties.Set',
                                  'org.gnome.Mutter.DisplayConfig',
                                  'PowerSaveMode', f'<int32 {mode}>'],
                        f'mutter PowerSaveMode {mode}')


def lock_session():
    """熄屏同时锁屏，唤醒后停在锁屏界面，和手机的电源键一致。

    root 直接调 `loginctl lock-sessions`：从 user manager 调用时这一步要过
    polkit，实测 4 秒超时且锁屏没有生效，所以服务才做成 system 单元。
    """
    return call([LOGINCTL, 'lock-sessions'], 'lock sessions')


def simulate_wakeup():
    """注入 KEY_WAKEUP，让合成器在 PowerSaveMode 打开后重绘一次。"""
    global _wakeup_device
    try:
        from evdev import UInput, ecodes
    except ImportError as error:
        say(f'cannot inject KEY_WAKEUP: {error}')
        return False
    try:
        if _wakeup_device is None:
            _wakeup_device = UInput({ecodes.EV_KEY: [ecodes.KEY_WAKEUP]},
                                    name='piano-power-wakeup')
        _wakeup_device.write(ecodes.EV_KEY, ecodes.KEY_WAKEUP, 1)
        _wakeup_device.syn()
        _wakeup_device.write(ecodes.EV_KEY, ecodes.KEY_WAKEUP, 0)
        _wakeup_device.syn()
        return True
    except OSError as error:
        say(f'cannot inject KEY_WAKEUP: {error}')
        return False


def simulate_activity(session):
    """非 GNOME 桌面：清掉 fd.o 屏保的空闲状态。"""
    session_call(session, [GDBUS, 'call', '--session', '--dest',
                           'org.freedesktop.ScreenSaver',
                           '--object-path', '/org/freedesktop/ScreenSaver',
                           '--method',
                           'org.freedesktop.ScreenSaver.SimulateUserActivity'],
                 'SimulateUserActivity')


def set_backlight(backlight, value):
    """root 直接写 sysfs；没有 Mutter 的桌面上这条路径仍然可用。"""
    try:
        with open(f'/sys/class/backlight/{backlight}/brightness', 'w') as stream:
            stream.write(str(value))
        return True
    except OSError as error:
        say(f'backlight write failed: {error}')
        return False


def power_dialog(session):
    """长按后的关机入口，按桌面依次回退。

    GNOME 的 `org.gnome.SessionManager.Shutdown` 在只有 GNOME 的镜像里够用；
    KDE 用 `org.kde.Shutdown.logoutAndShutdown`（plasma-shutdown 的 D-Bus
    接口，见 plasma-workspace 的 org.kde.Shutdown.service）；niri/Hyprland
    档没有会话管理器，直接让 logind 关机。每一步失败都记日志再试下一条，
    不让长按在第二种桌面上变成静默无响应。
    """
    if session is None:
        session = active_session()
    for args, operation in (
            ([GDBUS, 'call', '--session', '--dest', 'org.gnome.SessionManager',
              '--object-path', '/org/gnome/SessionManager',
              '--method', 'org.gnome.SessionManager.Shutdown'], 'GNOME power menu'),
            ([GDBUS, 'call', '--session', '--dest', 'org.kde.Shutdown',
              '--object-path', '/org/kde/Shutdown',
              '--method', 'org.kde.Shutdown.logoutAndShutdown'], 'KDE power menu')):
        if session_call(session, args, operation):
            return True
    if call(['systemctl', 'poweroff'], 'systemctl poweroff'):
        return True
    say('no shutdown path succeeded')
    return False


def lid_closed(fd):
    bitmap = bytearray(8)
    fcntl.ioctl(fd, EVIOCGSW, bitmap, True)
    return bool(int.from_bytes(bitmap, sys.byteorder) & (1 << SW_LID))


class Screen:
    """熄屏与唤醒。

    GNOME 下用 Mutter 的 PowerSaveMode 开关显示输出并锁会话；其余桌面仍走
    背光，因为它们没有对应的公共接口。
    """

    def __init__(self):
        self.saved = None
        self.cover_closed = None

    def is_blank(self):
        session = active_session()
        if session is not None:
            mode = mutter_power_save_mode(session)
            if mode is not None:
                return mode != POWER_SAVE_ON
        if self.saved is not None:
            return True
        backlight = find_backlight()
        if backlight is not None:
            try:
                if brightness(backlight) == 0:
                    return True
            except OSError:
                pass
        return False

    def blank(self):
        session = active_session()
        if session is not None and mutter_power_save_mode(session) is not None:
            set_mutter_power_save_mode(session, POWER_SAVE_OFF)
            lock_session()
            return
        backlight = find_backlight()
        if backlight is None:
            return
        if self.saved is None:
            try:
                current = brightness(backlight)
            except OSError:
                current = 0
            max_val = max_brightness(backlight)
            self.saved = (backlight, current if current > 1 else max(1, max_val // 2))
        set_backlight(backlight, 0)

    def wake(self):
        session = active_session()
        if session is not None and mutter_power_save_mode(session) is not None:
            simulate_wakeup()
            set_mutter_power_save_mode(session, POWER_SAVE_ON)
            return
        backlight = find_backlight()
        target_value = None
        if self.saved is not None:
            saved_bl, saved_val = self.saved
            self.saved = None
            if backlight == saved_bl and saved_val > 0:
                target_value = saved_val
        if target_value is None and backlight is not None:
            target_value = max(1, max_brightness(backlight) // 2)

        if backlight is not None and target_value is not None:
            set_backlight(backlight, target_value)

        simulate_activity(session)

    def toggle(self):
        if self.is_blank():
            self.wake()
        else:
            self.blank()

    def lid(self, closed):
        if closed == self.cover_closed:
            return
        self.cover_closed = closed
        if closed:
            self.blank()
        else:
            self.wake()


def main():
    if os.geteuid() != 0:
        say('must run as root: the power key grab and uinput need it')
        return 1
    # Only these two exact devices are opened. Touch/keyboards are not read.
    devices = {}
    dropped = set()
    screen = Screen()
    pressed_at = None
    try:
        while True:
            names = set(devices.values())
            for name in (KEY_NAME, LID_NAME):
                if name in names:
                    continue
                path = find_device(name)
                if path is None:
                    continue
                fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
                try:
                    if name == KEY_NAME:
                        fcntl.ioctl(fd, EVIOCGRAB, 1)
                    else:
                        # SW_LID reports state, not just transitions. A cover
                        # already closed at service startup must also blank.
                        screen.lid(lid_closed(fd))
                except OSError:
                    os.close(fd)
                    raise
                devices[fd] = name
            timeout = 2.0
            if pressed_at is not None:
                timeout = min(timeout, max(0.0, pressed_at + LONG_PRESS - time.monotonic()))
            ready, _, _ = select.select(list(devices), [], [], timeout)
            if not ready and pressed_at is not None and time.monotonic() >= pressed_at + LONG_PRESS:
                pressed_at = None
                screen.wake()
                power_dialog(None)
            for fd in ready:
                data = os.read(fd, EVENT.size * 64)
                if not data:
                    if devices[fd] == KEY_NAME:
                        pressed_at = None
                    os.close(fd)
                    dropped.discard(fd)
                    del devices[fd]
                    continue
                for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    _, _, etype, code, value = EVENT.unpack_from(data, off)
                    if fd in dropped:
                        if etype == EV_SYN and code == 0:  # SYN_REPORT
                            dropped.discard(fd)
                            if devices[fd] == LID_NAME:
                                screen.lid(lid_closed(fd))
                        continue
                    if etype == EV_SYN and code == SYN_DROPPED:
                        dropped.add(fd)
                        if devices[fd] == KEY_NAME:
                            pressed_at = None
                        continue
                    if devices[fd] == LID_NAME:
                        if etype == EV_SW and code == SW_LID:
                            screen.lid(bool(value))
                        continue
                    if etype == EV_KEY and code == KEY_POWER:
                        if value == 1:
                            pressed_at = time.monotonic()
                        elif value == 0 and pressed_at is not None:
                            pressed_at = None
                            screen.toggle()
    finally:
        for fd in devices:
            os.close(fd)  # Closing only the power FD releases EVIOCGRAB.
    return 0


if __name__ == '__main__':
    sys.exit(main())
