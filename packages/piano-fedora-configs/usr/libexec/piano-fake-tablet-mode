#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
# Expose SW_TABLET_MODE to the running desktop (Mutter/KWin) for auto-rotation
# and tablet gestures.

import os
import signal
import subprocess
import sys
import time

import evdev
from evdev import UInput, ecodes

POLL_SEC = 0.2
USER_SHELL_DELAY_TICKS = 25
GREETER_USERS = ("gdm", "sddm", "plasmalogin", "greetd", "lightdm")
# 会话的类型。wayland 与 x11 都算"桌面已经起来"；tty 是文本登录，不算。
GRAPHICAL_TYPES = ("wayland", "x11", "mir")
GRAPHICAL_CLASSES = ("user", "greeter")

_ui = None
_stopping = False


def log(msg):
    print(f"piano-fake-tablet-mode: {msg}", file=sys.stderr, flush=True)


def get_real_lid_device():
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
            caps = dev.capabilities()
            if dev.name in ("gpio-keys", "soc:piano-hall-ml"):
                if ecodes.EV_SW in caps and ecodes.SW_LID in caps[ecodes.EV_SW]:
                    return dev
        except Exception:
            continue
    return None


def set_tablet_mode(enabled):
    if _ui:
        _ui.write(ecodes.EV_SW, ecodes.SW_TABLET_MODE, 1 if enabled else 0)
        _ui.syn()


def graphical_user_session_running():
    """是否有非 greeter 用户的图形会话处于活动状态。

    原来只扫 `gnome-shell` 进程，换上 KDE / niri / Hyprland 后这条判断永远
    为假，SW_TABLET_MODE 就再也不会打开。改成问 logind：`ListSessions` 给出
    每个会话的 Id / User / Class / Type，`ShowSession` 给出 Active。只看
    user 类、Type 为 wayland/x11 且 Active=yes 的会话，greeter 用户排除。
    没有 logind（或没起来）时返回 False，不抛异常。
    """
    try:
        listing = subprocess.run(
            ["loginctl", "list-sessions", "--no-legend", "--no-pager"],
            capture_output=True, text=True, timeout=4)
    except (OSError, subprocess.TimeoutExpired):
        return False
    if listing.returncode != 0:
        return False
    for line in listing.stdout.splitlines():
        fields = line.split()
        if not fields:
            continue
        session_id = fields[0]
        try:
            shown = subprocess.run(
                ["loginctl", "show-session", session_id,
                 "-p", "Name", "-p", "User", "-p", "Class", "-p", "Type",
                 "-p", "Active"],
                capture_output=True, text=True, timeout=4)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if shown.returncode != 0:
            continue
        values = dict(
            line.split("=", 1) for line in shown.stdout.splitlines() if "=" in line)
        if values.get("Active") != "yes":
            continue
        if values.get("Class") not in GRAPHICAL_CLASSES:
            continue
        if values.get("Type") not in GRAPHICAL_TYPES:
            continue
        if values.get("Name") in GREETER_USERS:
            continue
        return True
    return False


def handle_signal(_signum, _frame):
    global _stopping
    _stopping = True


def main():
    global _ui

    if os.geteuid() != 0:
        log("FATAL: must run as root")
        sys.exit(1)

    cap = {
        ecodes.EV_SW: [ecodes.SW_TABLET_MODE],
        ecodes.EV_KEY: [ecodes.KEY_WAKEUP],
    }
    try:
        _ui = UInput(cap, name="Fake Tablet Mode Switch",
                     vendor=0x1234, product=0x5678)
    except Exception as e:
        log(f"FATAL: cannot create uinput device: {e}")
        sys.exit(1)

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    real_dev = get_real_lid_device()
    if real_dev:
        log(f"found physical lid switch at {real_dev.path}")
    else:
        log("no physical SW_LID found, managing virtual SW_TABLET_MODE")

    set_tablet_mode(False)
    log("SW_TABLET_MODE=OFF; waiting for a graphical user session")

    shell_ticks = 0
    enabled = False
    try:
        while not _stopping:
            if graphical_user_session_running():
                if shell_ticks < USER_SHELL_DELAY_TICKS:
                    shell_ticks += 1
                if not enabled and shell_ticks == USER_SHELL_DELAY_TICKS:
                    set_tablet_mode(True)
                    enabled = True
                    log("SW_TABLET_MODE=ON")
            else:
                shell_ticks = 0
                if enabled:
                    set_tablet_mode(False)
                    enabled = False
                    log("SW_TABLET_MODE=OFF; graphical user session exited")
            time.sleep(POLL_SEC)
    finally:
        if enabled:
            set_tablet_mode(False)
        _ui.close()


if __name__ == "__main__":
    main()
