#!/usr/bin/python3 -I
"""Autoconfigure /etc/piano/boot-request.json on boot if missing."""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time

CONFIG = Path('/etc/piano/boot-request.json')
CONFIGURE = '/usr/bin/piano-next-boot-configure'
NATIVE = '/usr/local/sbin/piano-boot-request'


def main():
    if CONFIG.is_file() and CONFIG.stat().st_size > 0:
        print("piano-boot-request-autoconfig: config already present, skipping")
        return 0

    # Wait briefly if block partition labels are settling
    for _ in range(10):
        if any(os.path.exists(f'/dev/disk/by-partlabel/boot_{s}') for s in ('b', 'a')):
            break
        time.sleep(0.5)

    candidate_slots = []
    try:
        proc = subprocess.run(['/usr/bin/qbootctl', '-c'], capture_output=True, text=True)
        combined = proc.stdout + proc.stderr
        m = re.search(r'Current slot:\s*_?([ab])', combined)
        if m:
            candidate_slots.append(m.group(1))
    except Exception as e:
        print(f"piano-boot-request-autoconfig: qbootctl failed: {e}", file=sys.stderr)

    for slot in ('b', 'a'):
        if slot not in candidate_slots:
            candidate_slots.append(slot)

    for slot in candidate_slots:
        dev = f'/dev/disk/by-partlabel/boot_{slot}'
        if not os.path.exists(dev):
            continue
        try:
            res_raw = subprocess.check_output(
                [NATIVE, 'status', '--device', dev],
                text=True, stderr=subprocess.DEVNULL,
                env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'}
            )
            res = json.loads(res_raw)
            gen = res.get('app_generation', '')
            if re.fullmatch(r'[0-9a-f]{32}', gen) and int(gen, 16):
                print(f"piano-boot-request-autoconfig: found SunUEFI boot image at {dev} (generation: {gen})")
                subprocess.check_call([CONFIGURE, '--device', dev])
                return 0
        except Exception:
            continue

    print("piano-boot-request-autoconfig: no SunUEFI boot partition detected", file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main())
