#!/bin/sh
# Fedora/F2FS root: filesystem LABEL + GPT PARTNAME + f2fs; never an Android root.
#
# 与上游 linux/userspace/release-disk-bootstrap 同构，只改 F2FS 相关部分：
#   - 类型检查 ext4 -> f2fs
#   - 只读挂载去掉 ext4 专有的 noload（F2FS 没有这个选项，传了会挂载失败）
#   - 首次检查用 ro,norecovery，卸载后重新以 rw 正常恢复并挂载
#
# 保留的结构：两次身份校验、先只读后读写、失败进救援而不回退到 Android。
export PATH=/usr/sbin:/usr/bin:/bin:/sbin
debug_started=0
debug_serial_pid=
boot_evidence_file=${PIANO_BOOT_EVIDENCE_FILE:-/run/piano-boot-evidence.txt}
boot_collector=${PIANO_COLLECT_BOOT:-/usr/bin/piano-collect-boot}
log() {
    printf 'piano: %s\n' "$*"
    # 帧缓冲空白时也要留下早期失败记录。mount --move 之后同一个 devtmpfs
    # 在 /sysroot 下面也能访问到。
    kmsg=/dev/kmsg
    [ -c "$kmsg" ] || kmsg=/sysroot/dev/kmsg
    if [ -c "$kmsg" ]; then printf '<5>piano: %s\n' "$*" >"$kmsg"; fi
    for console in /dev/console /dev/tty0 /sysroot/dev/console; do
        [ ! -c "$console" ] || printf 'piano: %s\n' "$*" >"$console" 2>/dev/null || :
    done
}
start_debug() {
    [ "$debug_started" -eq 0 ] || return 0
    if /usr/local/sbin/piano-debug-bootstrap start &&
       [ -r /run/piano-debug/boot-id ] && [ -r /run/piano-debug/udc ]; then
        debug_started=1
        # 正常启动只转发 kmsg；getty 会自行创建会话，只在不会再交接的救援路径启动。
        (exec /bin/cat /dev/kmsg >/dev/ttyGS0) &
        debug_serial_pid=$!
        log 'DEBUG_READY: ACM kernel log requested; NCM address 192.168.77.1/30'
    else
        log 'DEBUG_UNAVAILABLE: USB setup failed; physical console remains available'
    fi
}
stop_debug_serial() {
    [ -n "$debug_serial_pid" ] || return 0
    # 结束本入口创建的单进程日志转发器，不跨根保留旧 initramfs 进程。
    # 不在启动关键路径等待串口退出，避免设备未读数据拖住 switch_root。
    kill -KILL "$debug_serial_pid" 2>/dev/null || :
    debug_serial_pid=
    # gadget 与 NCM 地址保留，真实 Fedora 的 sshd 可接管。
}
capture_boot_evidence() {
    # 只读取证先完整落 RAM 文件，再逐行转 kmsg。
    # 采集器的 stdout 与 stderr 都进同一个文件，权限 0600。
    # 采集失败也保留已写入的内容，不因失败丢掉诊断。
    # 读的是有限普通文件，不无界等待；也不直接写 ttyGS0。
    ( umask 077; "$boot_collector" >"$boot_evidence_file" 2>&1 )
    collect_status=$?
    chmod 600 "$boot_evidence_file" 2>/dev/null || :
    log "BOOT_EVIDENCE_SAVED: file=$boot_evidence_file collect_status=$collect_status"
    while IFS= read -r line || [ -n "$line" ]; do
        log "$line"
    done <"$boot_evidence_file"
    return "$collect_status"
}
fail() {
    log "DISK_ROOT_REFUSED: $*; remaining in initramfs rescue"
    # 共享的 gadget helper 需要所有虚拟挂载在原路径。
    # 救援不会返回，所以不需要向磁盘根交接 gadget。
    # 晚期失败可能发生在部分挂载已经移到 /sysroot 之后。
    # 把这些挂载移回来；不要创建第二个 gadget，也不要隐藏日志。
    for virtual in dev proc sys run; do
        if ! mountpoint -q "/$virtual" && mountpoint -q "/sysroot/$virtual"; then
            if ! mount --move "/sysroot/$virtual" "/$virtual"; then
                log "Cannot return $virtual to initramfs rescue"
            fi
        fi
    done
    if mountpoint -q /dev && mountpoint -q /proc &&
       mountpoint -q /sys && mountpoint -q /run; then
        start_debug
        stop_debug_serial
        if [ "$debug_started" -eq 1 ]; then
            (
                while :; do
                    /usr/local/sbin/piano-debug-bootstrap serial
                    sleep 5
                done
            ) &
        fi
    fi
    console=/dev/console
    [ -c "$console" ] || console=/sysroot/dev/console
    while :; do
        /bin/sh <"$console" >"$console" 2>&1
        sleep 5
    done
}
mkdir -p /dev /proc /sys /run /sysroot || fail 'Cannot create mountpoints'
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev || fail 'devtmpfs failed'
mountpoint -q /proc || mount -t proc proc /proc || fail 'proc failed'
mountpoint -q /sys || mount -t sysfs sysfs /sys || fail 'sysfs failed'
mountpoint -q /run || mount -t tmpfs -o mode=0755 tmpfs /run || fail 'run failed'
expected=$(cat /etc/piano/root-label) || fail 'Missing root label'
[ "$expected" = PIANOROOT ] || fail 'Unexpected root label'
[ "$(cat /etc/piano/root-partname)" = sunuefi_root ] || fail 'Unexpected root partition name'
release=$(cat /etc/piano/kernel-release) || fail 'Missing kernel identity'
[ "$(uname -r)" = "$release" ] || fail 'Kernel/module release mismatch'
boot_chain=$(cat /etc/piano/boot-chain) || fail 'Missing boot-chain contract'
case "$boot_chain" in sunuefi|abl-storage) : ;; *) fail 'Unknown boot-chain contract' ;; esac
log "DISK_INIT_BEGIN: kernel=$release root=LABEL=$expected fstype=f2fs"
selected=0
dma_log=0
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        piano.boot-dma-log=1) dma_log=1 ;;
        piano.root=*)
            [ "$arg" = "piano.root=LABEL=$expected" ] || fail 'Unexpected piano.root'
            selected=$((selected + 1)) ;;
        root=*) [ "$arg" = "root=LABEL=$expected" ] || fail 'Other block roots are forbidden' ;;
    esac
done
[ "$selected" -eq 1 ] || fail 'Exactly one explicit piano.root=LABEL is required'
# 先建立只使用已绑定 UDC 的上游诊断通道，再启动任何存储 DMA。
start_debug
log "BOOT_CONTRACT: $boot_chain"
if [ "$boot_chain" = abl-storage ]; then
    # ABL 对照仅复用锁定上游的早期存储流程；不会启动桌面或写入根分区。
    /usr/bin/piano-qup-smmu 0xb6 0xa3 0x1400/0x7f 0x436 0x423 0x60 || fail 'ABL storage stream preparation failed'
    clock=$(/bin/devmem 0x0f205008 32) || fail 'Cannot read the upstream UFS reference clock'
    /bin/devmem 0x0f205008 32 "$((clock | 1))" || fail 'Cannot enable the upstream UFS reference clock'
fi
dma_routes() {
    # 完整路由转储只是诊断，不是加载模块的条件。
    [ "$dma_log" -eq 1 ] || return 0
    # 复用内核序列化后的逐 master 回读；绝不写 SMMU MMIO。
    for device in 1d84000.ufshc a600000.ssusb; do
        for attribute in piano_dma_route piano_dma_context; do
            path=/sys/bus/platform/devices/$device/$attribute
            [ -r "$path" ] || continue
            snapshot=$(cat "$path" 2>&1)
            result=$?
            log "DMA_READBACK phase=$1 device=$device attribute=$attribute status=$result"
            printf '%s\n' "$snapshot" | while IFS= read -r line; do log "$line"; done
        done
    done
}
while read -r name module; do
    log "Loading module $name"
    [ -d "/sys/module/$name" ] || insmod "$module" || fail "Cannot load $name"
    case "$name" in arm_smmu|ufs_qcom) dma_routes "after-$name" ;; esac
done </etc/piano/modules-load-order

# sysfs 识别分区节点；blkid 底层探测绕过所有缓存。
# 文件系统 label 与 GPT 分区名必须同时匹配。不做任何文件系统修复。
rootdev=
attempt=0
while [ "$attempt" -lt 30 ]; do
    for part in /sys/class/block/*; do
        [ -f "$part/partition" ] || continue
        grep -qx 'PARTNAME=sunuefi_root' "$part/uevent" || continue
        candidate=/dev/${part##*/}
        [ -b "$candidate" ] || continue
        label=$(/usr/bin/blkid -p -s LABEL -o value "$candidate" 2>/dev/null) || continue
        [ "$label" = "$expected" ] || continue
        [ -z "$rootdev" ] || fail 'Duplicate root label'
        rootdev=$candidate
    done
    [ -z "$rootdev" ] || break
    attempt=$((attempt + 1))
    sleep 1
done
[ -n "$rootdev" ] || fail 'Selected Linux partition did not appear'
verify_device() {
    [ "$(/usr/bin/blkid -p -s LABEL -o value "$rootdev")" = "$expected" ] &&
    [ "$(/usr/bin/blkid -p -s PART_ENTRY_NAME -o value "$rootdev")" = sunuefi_root ] &&
    [ "$(/usr/bin/blkid -p -s TYPE -o value "$rootdev")" = f2fs ]
}
verify_device || fail 'LABEL/PARTNAME/TYPE mismatch'
# 只读检查：确认这是一套真实系统，且模块与内核匹配。
# norecovery 明确禁止 roll-forward；仅有 ro 不替代禁止恢复的保证。
# 来源：Linux Documentation/filesystems/f2fs.rst 的 mount options。
mount -t f2fs -o ro,norecovery "$rootdev" /sysroot || fail 'Read-only Linux mount failed'
[ -x /sysroot/usr/lib/systemd/systemd ] || fail 'Real systemd is missing'
[ -d "/sysroot/usr/lib/modules/$release" ] || fail 'Matching distro modules are missing'
[ ! -f /sysroot/etc/initrd-release ] || fail 'Root is initrd-only'
[ -x /sysroot/usr/lib/piano/piano-disk-hardware-prepare ] || fail 'Hardware preparation is missing'
log "DISK_ROOT_INSPECTED: device=$rootdev LABEL=$expected PARTNAME=sunuefi_root TYPE=f2fs"
if [ "$boot_chain" = abl-storage ]; then
    capture_boot_evidence
    log 'STORAGE_PROBE_PASSED: Fedora root inspected with ro,norecovery; no writable mount or systemd handoff performed'
    umount /sysroot || fail 'Cannot unmount the diagnostic root'
    fail 'Read-only storage probe complete; retained for evidence collection'
fi
umount /sysroot || fail 'Cannot finish read-only inspection'
verify_device || fail 'Root identity changed before writable mount'
# 封存镜像与设备容量无关，根文件系统在首次读写挂载之前长满自己的分区。
# resize.f2fs 只支持扩容，而且拒绝已挂载的设备，所以只能在这里做。
# 缩小过的分区无法靠 resize.f2fs 回退，直接停在救援。
grow_root() {
    [ "$boot_chain" = sunuefi ] || return 0
    part=${rootdev##*/}
    sectors=$(cat "/sys/class/block/$part/size" 2>/dev/null) || fail 'Cannot read the root partition size'
    part_bytes=$((sectors * 512))
    fs_bytes=$(/usr/bin/blkid -p -o export "$rootdev" 2>/dev/null | sed -n 's/^FSSIZE=//p')
    [ -n "$fs_bytes" ] || fail 'Cannot read the F2FS capacity'
    [ "$fs_bytes" -le "$part_bytes" ] || fail "The F2FS root is larger than its partition ($fs_bytes > $part_bytes); shrinking is unsupported"
    [ "$fs_bytes" -lt "$part_bytes" ] || return 0
    log "ROOT_GROW_STARTED: fs_bytes=$fs_bytes part_bytes=$part_bytes"
    /usr/sbin/fsck.f2fs -f "$rootdev" >/dev/null 2>&1
    status=$?
    [ "$status" -le 1 ] || fail "fsck refused the root before growing (status=$status)"
    /usr/sbin/resize.f2fs "$rootdev" >/dev/null 2>&1 || fail 'resize.f2fs failed'
    /usr/sbin/fsck.f2fs -f "$rootdev" >/dev/null 2>&1
    status=$?
    [ "$status" -le 1 ] || fail "fsck refused the root after growing (status=$status)"
    grown=$(/usr/bin/blkid -p -o export "$rootdev" 2>/dev/null | sed -n 's/^FSSIZE=//p')
    [ "$grown" = "$part_bytes" ] || fail "The root did not grow to fill its partition ($grown != $part_bytes)"
    log "ROOT_GROW_DONE: fs_bytes=$grown"
}
grow_root
# 读写挂载。身份已在上一步核对过，这里再核对一次防止设备在两步之间变化。
mount -t f2fs -o rw "$rootdev" /sysroot || fail 'Writable Linux mount failed'
mkdir -p /sysroot/dev /sysroot/proc /sysroot/sys /sysroot/run /sysroot/tmp || fail 'Root mountpoints failed'
chmod 1777 /sysroot/tmp || fail 'Root tmp permissions failed'
printf 'LABEL=%s\n' "$expected" >/run/piano-root-mode || fail 'Cannot record root mode'
printf '%s\n' "$rootdev" >/run/piano-root-device || fail 'Cannot record root device'
stop_debug_serial
for virtual in dev proc sys run; do
    mount --move "/$virtual" "/sysroot/$virtual" || fail "Cannot move $virtual"
done
chroot /sysroot /usr/lib/piano/piano-disk-hardware-prepare || fail 'Hardware preparation failed; collect the verifier output before continuing'
chroot /sysroot /usr/libexec/piano-physical-platform || fail 'Physical platform export preparation failed'
log "DISK_ROOT_READY: starting Fedora systemd on LABEL=$expected fstype=f2fs"
if [ -f /etc/piano/boot-task-snapshot ]; then
    # 从真实 root 运行，让这个进程在 initramfs 被移除后仍然存活。
    rm -f /sysroot/run/piano-boot-task-snapshot.ready
    chroot /sysroot /bin/sh /usr/lib/piano/piano-boot-task-snapshot \
        </sysroot/dev/null >/sysroot/dev/null 2>&1 &
    diagnostic_wait=0
    while [ ! -f /sysroot/run/piano-boot-task-snapshot.ready ] && [ "$diagnostic_wait" -lt 3 ]; do
        sleep 1
        diagnostic_wait=$((diagnostic_wait + 1))
    done
    [ -f /sysroot/run/piano-boot-task-snapshot.ready ] || log 'Diagnostic task snapshot could not be armed'
fi
# 高通看门狗（CONFIG_QCOM_WDT=m）绑定后启动约 30 秒的硬件计时器，超时直接
# 复位芯片，表现为启动完成后跌回 UEFI。Fedora 侧没有 watchdog 服务喂狗，
# 所以必须挡住它。
#
# 规则本体在 piano-fedora-configs 的
# /etc/modprobe.d/piano-blacklist-watchdog.conf，由 RPM 安装、标签由 rpm 的
# SELinux 事务落成 modules_conf_t。早先在这里 printf 出来，systemd-modules-load
# 拿到 unlabeled_t、getattr 被拒绝，规则实际没生效；rootfs 里那个文件也不属于
# 任何包。这里只做存在性断言，不写文件。
if [ ! -r /sysroot/etc/modprobe.d/piano-blacklist-watchdog.conf ]; then
    log 'WATCHDOG_RULE_MISSING: piano-blacklist-watchdog.conf is absent from the rootfs'
else
    log 'WATCHDOG_DISABLED: qcom_wdt blacklist is installed by the config RPM'
fi
exec switch_root -c /dev/console /sysroot /usr/lib/systemd/systemd \
    --log-target=kmsg --log-level=info >/sysroot/dev/kmsg 2>&1
fail 'switch_root failed'
